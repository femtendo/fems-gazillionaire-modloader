         this.strings["frm_MainMenu_explored"] = "You have already completed your Planet Special for this week.  Try again next week.\n\nIf you turn off Quick Explore on the Shortcuts page under File Options, you can explore the rest of the planet, seeing the current news and weather, the planet\'s history, and more.";
