         this.strings["frm_Travel4_event_1_0"] = "Great Harvest On ";
         this.strings["frm_Travel4_event_1_1"] = "Due to an unexpected record harvest, the supply of agricultural goods on ";
         this.strings["frm_Travel4_event_1_2"] = " temporarily soars.  Prices plummet as Cantaloupe, Jelly Beans, Moon Ferns, Frog Legs, Whip Cream and Babel Seeds flood the market.";
         this.strings["frm_Travel4_event_2_0"] = "Manufactured Goods Mega Sale On ";
         this.strings["frm_Travel4_event_2_1"] = "Due to an unexpected surge in production, the supply of manufactured goods on ";
         this.strings["frm_Travel4_event_2_2"] = " temporarily soars.  Prices plummet as Diapers, Umbrellas, Toasters, Polyester, Hair Tonic and Lava Lamps flood the market.";
         this.strings["frm_Travel4_event_3_0"] = "Raw Materials Dirt Cheap On ";
         this.strings["frm_Travel4_event_3_1"] = "Due to an unexpected rash of foreign dumping, the supply of raw materials on ";
         this.strings["frm_Travel4_event_3_2"] = " temporarily soars.  Prices plummet as Oxygen, Oggle Sand, Kryptoons, X Fuels, Gems and Exotic flood the market.";
         this.strings["frm_Travel4_event_4_0"] = "Poor Harvest On ";
         this.strings["frm_Travel4_event_4_1"] = "Due to an unexpectedly poor harvest, the supply of agricultural goods on ";
         this.strings["frm_Travel4_event_4_2"] = " temporarily runs short.  Prices soar as Cantaloupe, Jelly Beans, Moon Ferns, Frog Legs, Whip Cream and Babel Seeds become hard to find.";
         this.strings["frm_Travel4_event_5_0"] = "Manufactured Goods Rare On ";
         this.strings["frm_Travel4_event_5_1"] = "Due to labor unrest and strikes across ";
         this.strings["frm_Travel4_event_5_2"] = ", the supply of manufactured goods temporarily runs short.  Prices soar as Diapers, Umbrellas, Toasters, Polyester, Hair Tonic and Lava Lamps become hard to find.";
         this.strings["frm_Travel4_event_6_0"] = "Raw Materials Short On ";
         this.strings["frm_Travel4_event_6_1"] = "Due to an unexpected streak of natural disasters on ";
         this.strings["frm_Travel4_event_6_2"] = ", the supply of raw materials temporarily runs short.  Prices soar as Oxygen, Oggle Sand, Kryptoons, X Fuels, Gems and Exotic become difficult to find.";
         this.strings["frm_Travel4_event_7_0"] = "Fuel Prices Sky Rocket";
         this.strings["frm_Travel4_event_7_1"] = "Due to a galactic fuel shortage, fuel prices are on the rise.\n\nYou can expect to pay higher prices at the refueling docks in the coming weeks.";
         this.strings["frm_Travel4_event_8_0"] = "Fuel Prices Plummet";
         this.strings["frm_Travel4_event_8_1"] = "Due to a glut of fuel on the market, fuel prices are falling.\n\nYou can expect to see lower prices at the refueling docks in the coming weeks.";
         this.strings["frm_Travel4_event_9_0"] = "Higher Passenger Tax Rate";
         this.strings["frm_Travel4_event_9_1"] = "In order to bring in more revenue, the Imperial Government raises the passenger tax rate from ";
