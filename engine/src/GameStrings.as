         this.strings["frm_DistanceChart_header_company"] = "Company";
         this.strings["frm_DistanceChart_header_planet"] = "Location";
         this.strings["frm_DistanceChart_header_speed"] = "Engine";
         this.strings["frm_DistanceChart_header_distance"] = "Distance";
         this.strings["frm_DistanceChart_header_facilities"] = "Facilities";
         this.strings["frm_DistanceChart_header_fee"] = "Fees";
         this.strings["frm_DistanceChart_header_revenue"] = "Revenue";
         this.strings["frm_DistanceChart_speed"] = " kuarps";
         this.strings["frm_DistanceChart_distance"] = " million kuters";
         this.strings["frm_DistanceChart_kubars"] = " kubars";
         this.strings["frm_DistanceChart_help_distance"] = "Click on one of the <b>planets</b> on the left, and the <b>distance chart</b> will show you how far away each player is from that planet.\n\nThe distance chart helps to determine who can reach a planet first.\n\nTo calculate the approximate time it will take to reach a planet, just divide the distance by the engine speed.  The players with the shortest travel times will usually reach the destination first.";
         this.strings["frm_DistanceChart_help_facilities_1"] = "Supreme Commander Dred Nicolson auctions off <b>government facilities</b>, such as fuel depots, launch pads and passenger ticket offices, to the highest bidder.\n\nThis chart shows which company owns how many facilities on each planet, how much you must pay each company and how much you may collect when you land on the planet.";
         this.strings["frm_DistanceChart_help_facilities_2"] = "Whomever owns a facility receives a <b>Fee</b> every time a competitor visits the planet.\n\nThe <b>Revenue</b> is the total amount of kubars generated from the fees.\n\nThe company who owns the facility will collect this revenue whenever its ship land on the planet.";
         this.strings["frm_Bankrupt1_bankrupt"] = " Bankrupts!!!";
         this.strings["frm_Bankrupt1_txt_continue"] = "click to continue";
         this.strings["frm_Bankrupt2_text_header"] = "Headline News";
         this.strings["frm_Bankrupt2_forced_1"] = "Big news on the financial front. ";
         this.strings["frm_Bankrupt2_forced_2"] = " has gone bankrupt!  Our sources inform us that all the assets are being liquidated to pay off creditors.  We have reports of angry citizens taking to the streets demanding a full investigation, but there is little anyone can do.\n\n";
         this.strings["frm_Bankrupt2_forced_3"] = " is too deeply in debt to continue operating, and no financial institution is willing to lend it any more money.";
         this.strings["frm_Bankrupt2_voluntary_1"] = "Big news on the financial front.  ";
         this.strings["frm_Bankrupt2_voluntary_2"] = " has gone bankrupt!  Our sources inform us that the government has revoked ";
         this.strings["frm_Bankrupt2_voluntary_3"] = "\'s trading license because it has exceeded its credit limit.   ";
         this.strings["frm_Bankrupt2_voluntary_4"] = " had enough money to keep its loan below the credit limit, but for some unknown reason, it refused to pay.  A full investigation is now underway to determine just what went wrong with ";
         this.strings["frm_Bankrupt2_voluntary_5"] = ".";
         this.strings["frm_Bankrupt2_game_over_1"] = "\n\nThe latest word from the capital is that Supreme Commander Dred Nicolson is terribly upset over the bankruptcy.  The Supreme Commander addressed the Kukubian Senate this morning, saying that what happened to ";
         this.strings["frm_Bankrupt2_game_over_2"] = " is a big setback for the Empire.  At the end of the speech, Dred Nicolson promised to do his best to end this game before the Kukubian Colonies suffer any further.";
         this.strings["frm_Bankrupt2_continue_1"] = "\n\nThe latest word from the capital is that Supreme Commander Dred Nicolson is terribly upset over the bankruptcy.  The Supreme Commander addressed the Kukubian Senate this morning, saying that what happened to ";
         this.strings["frm_Bankrupt2_continue_2"] = " is a big setback for the Empire.   At the end of the speech, Dred Nicolson promised to do his best to support the remaining companies and see that the Kukubian Colonies continue to grow and prosper.";
         this.strings["frm_Auction_ship_1"] = "<p align=\'center\'><font size=\'+5\'><b>Ship Auction</b></font></p>\nThe Traders\' Union is auctioning off a 200-ton ship upgrade to the highest bidder.\n\nThe company that purchases this upgrade will be able to trade in their old ship for a new, larger ship.\n\nYou must now input your <font color=\'#91FF4B\'><b>secret</b></font> bid.  You will be notified of the auction results at the beginning of your next turn.";
         this.strings["frm_Auction_ship_2_1"] = "<p align=\'center\'><b>Ship Auction</b></p>\nCurrent Ship Size:  ";
         this.strings["frm_Auction_ship_2_2"] = " tons\nCash:  ";
         this.strings["frm_Auction_ship_2_3"] = "\nSavings:  ";
         this.strings["frm_Auction_ship_2_4"] = "\nLoan:  ";
         this.strings["frm_Auction_ship_2_5"] = "\nCredit Limit:  ";
         this.strings["frm_Auction_ship_2_6"] = "\n\nPlease enter your secret bid!";
         this.strings["frm_Auction_facility_1_1"] = "<p align=\'center\'><font size=\'+5\'><b>Facility Auction</b></font></p>\nIn an attempt to promote free trade in the Kukubian Colonies, the Emperor is privatizing government-owned facilities.\n\nThis week, Dred is auctioning off the ";
         this.strings["frm_Auction_facility_1_2"] = " on <font color=\'#91FF4B\'><b>";
         this.strings["frm_Auction_facility_1_3"] = "</b></font> to the highest bidder.  The company that buys the facility can charge other companies <font color=\'#91FF4B\'><b>";
         this.strings["frm_Auction_facility_1_4"] = " kubars</b></font> every time they visit ";
         this.strings["frm_Auction_facility_1_5"] = ".\n\nYou must now input your <font color=\'#91FF4B\'><b>secret</b></font> bid.  You will be notified of the auction results at the beginning of your next turn.";
         this.strings["frm_Auction_facility_2_1a"] = "<b><p align=\'center\'>";
         this.strings["frm_Auction_facility_2_1b"] = " on ";
         this.strings["frm_Auction_facility_2_2"] = "</p></b>\nFacility Revenue:  ";
         this.strings["frm_Auction_facility_2_3"] = " kubars/ship\nCash:  ";
         this.strings["frm_Auction_facility_2_4"] = "\nSavings:  ";
         this.strings["frm_Auction_facility_2_5"] = "\nLoan:  ";
         this.strings["frm_Auction_facility_2_6"] = "\nLoan Credit Limit:  ";
         this.strings["frm_Auction_facility_2_7"] = "\n\nPlease enter your secret bid!";
         this.strings["frm_Auction_confirm_1"] = "\nAre you sure you want to bid ";
         this.strings["frm_Auction_confirm_2"] = " kubars?";
         this.strings["frm_Travel2_event_0_1"] = "<p align=\'center\'><font size=\'+5\'><b>Quaso Mutta</b></font></p>\nThe ghost like spirit of the venerated Quaso Mutta appears before you.  The spirit warns you not to travel to ";
         this.strings["frm_Travel2_event_0_2"] = " or your luck will change for the worse.  Instead, you should travel to ";
         this.strings["frm_Travel2_event_0_3"] = " immediately.\n\nDo you take this advice and travel to ";
         this.strings["frm_Travel2_event_0_4"] = "?";
         this.strings["frm_Travel2_good_event_2_header"] = "New Ship For Sale";
         this.strings["frm_Travel2_good_event_2_1"] = "You receive a <font color=\'#91FF4B\'><b>one-time offer</b></font> from the Traders\' Union to trade in your ";
         this.strings["frm_Travel2_good_event_2_2"] = "-ton ship for a ";
         this.strings["frm_Travel2_good_event_2_3"] = "-ton ship.  This will only cost you ";
         this.strings["frm_Travel2_good_event_2_4"] = " kubars, and the Traders\' Union is even willing to raise your credit limit by 25,000 kubars.\n\nDo you want to do it?";
         this.strings["frm_Travel2_good_event_2_4_loan"] = " kubars, and the Traders\' Union is even willing to cover the cost and raise your credit limit by 25,000 kubars.\n\nDo you want to do it?";
         this.strings["frm_Travel2_good_event_3_0"] = "Warehouse Space For Sale";
         this.strings["frm_Travel2_good_event_3_1"] = "For only ";
         this.strings["frm_Travel2_good_event_3_2"] = " kubars, you have the opportunity to <font color=\'#91FF4B\'><b>increase</b></font> your warehouse space from ";
         this.strings["frm_Travel2_good_event_3_3"] = " tons to ";
         this.strings["frm_Travel2_good_event_3_4"] = " tons on every planet.  The Traders\' Union will also raise your credit limit by 25,000 kubars.\n\nDo you want to do it?";
         this.strings["frm_Travel2_good_event_3_4_loan"] = " tons on every planet.  The Traders\' Union is willing to loan you the money to cover the cost and raise your credit limit by 25,000 kubars.\n\nDo you want to do it?";
         this.strings["frm_Travel2_good_event_4_1_1"] = "<p align=\'center\'><font size=\'+5\'><b>No Need To Pay!</b></font></p>\nBecause you have been complaining so much about how difficult it is to run a business and how the competition is driving you under, your crew reluctantly agrees to forget about any money you owe them.\n\nThat means you don\'t have to pay <font color=\'#77D7FF\'><b>";
         this.strings["frm_Travel2_good_event_4_1_2"] = " kubars</b></font> in employee wages!\n\nYou now owe your crew 0 kubars.";
         this.strings["frm_Travel2_good_event_4_2_1"] = "<p align=\'center\'><font size=\'+5\'><b>No Need To Pay!</b></font></p>\nBecause your company is struggling to make a profit and your crew is afraid of losing their jobs, they reluctantly agree to forget about any money you owe them.\n\nThat means you don\'t have to pay <font color=\'#77D7FF\'><b>";
         this.strings["frm_Travel2_good_event_4_2_2"] = " kubars</b></font> in employee wages!\n\nYou now owe your crew 0 kubars.";
         this.strings["frm_Travel2_good_event_4_3_1"] = "<p align=\'center\'><font size=\'+5\'><b>No Need To Pay!</b></font></p>\nBecause of a special deal you cut with the Union Boss, your crew reluctantly agrees to forget about any money you owe them.\n\nThat means you don\'t have to pay <font color=\'#77D7FF\'><b>";
         this.strings["frm_Travel2_good_event_4_3_2"] = " kubars</b></font> in employee wages!\n\nYou now owe your crew 0 kubars.";
         this.strings["frm_Travel2_good_event_5_1"] = "<p align=\'center\'><font size=\'+5\'><b>Emperor Dred Nicolson</b></font></p>\nSupreme Commander Dred Nicolson grants your business an <font color=\'#77D7FF\'><b>emergency tax break</b></font>.\n\nThat means you don\'t have to pay <font color=\'#77D7FF\'><b>";
         this.strings["frm_Travel2_good_event_5_2"] = " kubars</b></font> in taxes!  You now owe 0 kubars in taxes and tariffs.";
         this.strings["frm_Travel2_good_event_6_1"] = "<p align=\'center\'><font size=\'+5\'><b>Super Deal</b></font></p>\nAs part of a promotional package, L-Tech Engine Co. offers you a <font color=\'#77D7FF\'><b>free upgrade</b></font> from your ";
         this.strings["frm_Travel2_good_event_6_2"] = "-kuarp engine to a super-charged ";
         this.strings["frm_Travel2_good_event_6_3"] = "-kuarp engine.\n\nThey hope this will boost sales by inspiring your competitors to purchase new engines.";
         this.strings["frm_Travel2_good_event_7_1"] = "<p align=\'center\'><font size=\'+5\'><b>Your Insurance Agent</b></font></p>\nDue to a reassessment of your company\'s accident records, your Voyagers\' Insurance premiums have been <font color=\'#77D7FF\'><b>lowered</b></font> an average of ";
         this.strings["frm_Travel2_good_event_7_2"] = "%.";
         this.strings["frm_Travel2_good_event_8_1"] = "<p align=\'center\'><font size=\'+5\'><b>Lower Interest Rate</b></font></p>\nIn an effort to encourage you to borrow more money, Mr. Zinn <font color=\'#77D7FF\'><b>lowers</b></font> your interest rate from ";
         this.strings["frm_Travel2_good_event_8_2"] = "% to ";
         this.strings["frm_Travel2_good_event_8_3"] = "%.";
         this.strings["frm_Travel2_good_event_9_1"] = "<p align=\'center\'><font size=\'+5\'><b>Lower Interest Rate</b></font></p>\nDue to your good credit record and sound business practices, the Traders\' Union <font color=\'#77D7FF\'><b>lowers</b></font> your loan rate from ";
         this.strings["frm_Travel2_good_event_9_2"] = "% to ";
         this.strings["frm_Travel2_good_event_9_3"] = "%.";
         this.strings["frm_Travel2_good_event_10_1"] = "<p align=\'center\'><font size=\'+5\'><b>Higher Interest Rate</b></font></p>\nTo encourage you to deposit more money, the Traders\' Union <font color=\'#77D7FF\'><b>raises</b></font> the interest rate on your bank account from ";
         this.strings["frm_Travel2_good_event_10_2"] = "% to ";
         this.strings["frm_Travel2_good_event_10_3"] = "%.";
         this.strings["frm_Travel2_good_event_11_1"] = "<p align=\'center\'><font size=\'+5\'><b>Need More Money?</b></font></p>\nBecause Mr. Zinn feels your company is a good investment, he offers to <font color=\'#77D7FF\'><b>increase</b></font> the amount of your loan by 50,000 kubars.\n\nIf you accept his offer, your loan amount will become ";
         this.strings["frm_Travel2_good_event_11_2"] = " kubars.  The interest rate on this loan will remain at ";
         this.strings["frm_Travel2_good_event_11_3"] = "%, and he will increase your credit limit to ";
         this.strings["frm_Travel2_good_event_11_4"] = " kubars.\n\nDo you want to accept his offer and increase this loan amount?";
         this.strings["frm_Travel2_good_event_12_1"] = "<p align=\'center\'><font size=\'+5\'><b>Higher Credit Limit</b></font></p>\nIn order to keep you from defaulting on your loan, Mr. Zinn <font color=\'#77D7FF\'><b>increases</b></font> your credit limit from ";
         this.strings["frm_Travel2_good_event_12_2"] = " kubars to ";
         this.strings["frm_Travel2_good_event_12_3"] = " kubars.";
         this.strings["frm_Travel2_good_event_13_1"] = "<p align=\'center\'><font size=\'+5\'><b>Higher Credit Limit</b></font></p>\nIn order to stimulate your company\'s growth, the Traders\' Union <font color=\'#77D7FF\'><b>increases</b></font> your credit limit from ";
         this.strings["frm_Travel2_good_event_13_2"] = " kubars to ";
         this.strings["frm_Travel2_good_event_13_3"] = " kubars.";
         this.strings["frm_Travel2_good_event_14_1"] = "<p align=\'center\'><font size=\'+5\'><b>Money, Money, Money!</b></font></p>\nYou inherit money! \n\nA rich relative has died and left you <font color=\'#77D7FF\'><b>";
         this.strings["frm_Travel2_good_event_14_2"] = " kubars</b></font>.";
         this.strings["frm_Travel2_good_event_15_1"] = "<p align=\'center\'><font size=\'+5\'><b>You\'re in the money!</b></font></p>\nIt\'s your lucky day!!!\n\nYou win the lottery and receive <font color=\'#77D7FF\'><b>";
         this.strings["frm_Travel2_good_event_15_2"] = " kubars</b></font>.";
         this.strings["frm_Travel2_good_event_16_0"] = "Free Warehouse Space";
         this.strings["frm_Travel2_good_event_16_1"] = "In order to encourage you to use the warehouse more often, the Traders\' Union increases your warehouse space from ";
         this.strings["frm_Travel2_good_event_16_2"] = " tons to ";
         this.strings["frm_Travel2_good_event_16_3"] = " tons <font color=\'#77D7FF\'><b>free of charge</b></font>.";
         this.strings["frm_Travel2_good_event_17_1"] = "<p align=\'center\'><font size=\'+5\'><b>Scooter Jay</b></font></p>\nYour ship runs across Scooter Jay, a smuggler from the galaxy of Pata Pata Pita.  Scooter offers to buy all of your cargo for ";
         this.strings["frm_Travel2_good_event_17_2"] = " kubars.  Under Imperial law, you are forbidden to trade with anyone from Pata Pata Pita.\n\nDo you want to break the law and accept Scooter\'s offer?";
         this.strings["frm_Travel2_good_event_17_3"] = "<p align=\'center\'><font size=\'+5\'><b>You Are Caught</b></font></p>\nLittle did you know, the Imperial Police had you <font color=\'#F05555\'><b>under surveillance</b></font> the entire time.\n\nFor your crime against the New Realm, you are fined <font color=\'#F05555\'><b>";
         this.strings["frm_Travel2_good_event_17_4"] = " kubars</b></font> and warned that if you break the law again you could wind up in jail.";
         this.strings["frm_Travel2_good_event_18_1"] = "<p align=\'center\'><font size=\'+5\'><b>Hands</b></font></p>\nYour ship encounters Hands, a well-known crook and racketeer.  Hands offers to exchange the cargo you have on your ship for ";
         this.strings["frm_Travel2_good_event_18_2"] = " tons of Exotic.  Under Imperial law, you are forbidden to buy, sell or trade any goods you know are stolen.\n\nDo you break the law and accept his offer?";
         this.strings["frm_Travel2_good_event_18_3"] = "<p align=\'center\'><font size=\'+5\'><b>You Are Caught</b></font></p>\nLittle did you know, the Imperial Police had you <font color=\'#F05555\'><b>under surveillance</b></font> the entire time.\n\nFor your crime against the New Realm, you are fined <font color=\'#F05555\'><b>50,000 kubars</b></font> and all your <font color=\'#F05555\'><b>cargo</b></font> is <font color=\'#F05555\'><b>confiscated</b></font>.\n\nThe police warn you that if you break the law again you could wind up in jail.";
         this.strings["frm_Travel2_good_event_19_1"] = "<p align=\'center\'><font size=\'+5\'><b>Ship Stranded</b></font></p>\nYou are stopped by a broken-down spaceship flashing a distress signal.  The captain, Curtonian Plus, asks if you will loan him <font color=\'#91FF4B\'><b>";
         this.strings["frm_Travel2_good_event_19_2"] = " kubars</b></font> to repair his ship so he can return to ";
         this.strings["frm_Travel2_good_event_19_3"] = ".  He promises to pay you back just as soon as he arrives home.\n\nDo you want to lend him the money?";
         this.strings["frm_Travel2_good_event_19_3_loan"] = ".  He promises to pay you back just as soon as he arrives home, and the Traders\' Union is willing to loan you enough to cover the cost right now.\n\nDo you want to lend him the money?";
         this.strings["frm_Travel2_good_event_19_4"] = "<p align=\'center\'><font size=\'+5\'><b>Curtonian Plus</b></font></p>\nAs it turns out, Curtonian Plus is from one of Kukubia\'s wealthiest merchant families.\n\nHis father winds up paying you <font color=\'#77D7FF\'><b>";
         this.strings["frm_Travel2_good_event_19_5"] = " kubars</b></font> for your kindness.";
         this.strings["frm_Travel2_good_event_20_1"] = "<p align=\'center\'><font size=\'+5\'><b>Quist</b></font></p>\nQuist, a high flying financier, says he has cooked up a sure-fire scheme for making millions.  If you invest ";
         this.strings["frm_Travel2_good_event_20_2a"] = " kubars with him, he guarantees you\'ll see a tenfold profit within a month or two.\n\nDo you want to invest your money?";
         this.strings["frm_Travel2_good_event_20_2b"] = " kubars with him, he guarantees you\'ll see a tenfold profit within a month or two.";
         this.strings["frm_Travel2_good_event_20_3"] = "\n\nDo you want to invest your money?";
         this.strings["frm_Travel2_good_event_21_1"] = "<p align=\'center\'><font size=\'+5\'><b>Supporting Art</b></font></p>\nYour company is approached by The Wobbler, a starving artist.\n\nThe Wobbler asks you to sponsor his next avant-garde theatrical production.  It will cost <font color=\'#91FF4B\'><b>";
         this.strings["frm_Travel2_good_event_21_2a"] = " kubars</b></font> and probably won\'t make any money.  However, it will be an artistic masterpiece that will go down in history.\n\nDo you give him the money?";
         this.strings["frm_Travel2_good_event_21_2b"] = " kubars</b></font> and probably won\'t make any money.  However, it will be an artistic masterpiece that will go down in history.";
         this.strings["frm_Travel2_good_event_21_2c"] = "\n\nDo you give him the money?";
         this.strings["frm_Travel2_good_event_21_3"] = "<p align=\'center\'><font size=\'+5\'><b>Bummer</b></font></p>\nThe Wobbler\'s experimental play turns out to be a <font color=\'#F05555\'><b>complete flop!</b></font>\n\nSupreme Commander Dred Nicolson calls it a national disgrace and bans it from ever being shown again in public.";
         this.strings["frm_Travel2_good_event_21_4"] = "<p align=\'center\'><font size=\'+5\'><b>Blockbuster!</b></font></p>\nThe Wobbler\'s experimental play turns out to be a <font color=\'#77D7FF\'><b>surprise hit!</b></font>\n\nThe public flocks to see it.  Supreme Commander Dred Nicolson calls it a national treasure.\n\nThe Wobbler generously repays you <font color=\'#77D7FF\'><b>";
         this.strings["frm_Travel2_good_event_21_5"] = " kubars</b></font>, three times your original investment.";
         this.strings["frm_Travel2_good_event_22_1"] = "<p align=\'center\'><font size=\'+5\'><b>Business Proposition</b></font></p>\nBrow, an industrial spy, offers to do a little dirty work on your behalf.\n\nIf you pay him <font color=\'#91FF4B\'><b>";
         this.strings["frm_Travel2_good_event_22_2a"] = " kubars</b></font>, he will <font color=\'#91FF4B\'><b>sabotage</b></font> your competitors\' companies.  Brow assures you that he is an expert at nasty tricks.\n\nDo you want to accept this offer?";
         this.strings["frm_Travel2_good_event_22_2b"] = " kubars</b></font>, he will <font color=\'#91FF4B\'><b>sabotage</b></font> your competitors\' companies.  Brow assures you that he is an expert at nasty tricks.";
         this.strings["frm_Travel2_good_event_22_2c"] = "\n\nDo you want to accept this offer?";
         this.strings["frm_Travel2_good_event_22_3"] = "<p align=\'center\'><font size=\'+5\'><b>You Are Caught</b></font></p>\nLittle did you know, the Imperial Police had you under surveillance the entire time.\n\nFor attempting to conduct industrial sabotage, you are fined <font color=\'#F05555\'><b>";
         this.strings["frm_Travel2_good_event_22_4"] = " kubars</b></font> and warned that if you break the law again you could wind up in jail.";
         this.strings["frm_Travel2_good_event_22_7"] = " suffers a major financial loss as important trade secrets are leaked to the press.\n\nThe company\'s net worth falls <font color=\'#F05555\'><b>";
         this.strings["frm_Travel2_good_event_22_8"] = " kubars</b></font> overnight.";
         this.strings["frm_Travel2_good_event_22_11"] = " gets into an accident.\n\nIt costs the company <font color=\'#F05555\'><b>";
         this.strings["frm_Travel2_good_event_22_12"] = " kubars</b></font> to repair the damage.";
         this.strings["frm_Travel2_good_event_22_15"] = " loses a critical lawsuit.\n\nThe company must pay <font color=\'#F05555\'><b>";
         this.strings["frm_Travel2_good_event_22_16"] = " kubars</b></font> in damages and legal fees.";
         this.strings["frm_Travel2_good_event_22_18"] = "After receiving an anonymous tip, local officials on ";
         this.strings["frm_Travel2_good_event_22_19"] = " find contraband stored in ";
         this.strings["frm_Travel2_good_event_22_20"] = "\'s warehouse.\n\nAs a result, ";
         this.strings["frm_Travel2_good_event_22_21"] = " must pay a fine of <font color=\'#F05555\'><b>";
         this.strings["frm_Travel2_good_event_22_22"] = " kubars</b></font>.";
         this.strings["frm_Travel2_good_event_22_25"] = "\'s warehouse on ";
         this.strings["frm_Travel2_good_event_22_26"] = " catches on fire and burns to the ground.\n\nThe fire destroys <font color=\'#F05555\'><b>";
         this.strings["frm_Travel2_good_event_22_27"] = " kubars</b></font> worth of commodities.";
         this.strings["frm_Travel2_good_event_22_30"] = "\'s cargo hold overheats, and <font color=\'#F05555\'><b>";
         this.strings["frm_Travel2_good_event_22_31"] = " kubars</b></font> worth of goods are destroyed.\n\nThe cause of the accident is still undetermined.";
         this.strings["frm_Travel2_good_event_22_32"] = " suffers mysterious engine troubles.\n\nAs a result, ";
         this.strings["frm_Travel2_good_event_22_33"] = " is forced to borrow <font color=\'#F05555\'><b>";
         this.strings["frm_Travel2_good_event_22_34"] = " kubars</b></font> from the Traders\' Union to pay for the repairs.";
         this.strings["frm_Travel2_good_event_22_35"] = " discovers that a crew member has illegally borrowed money from the Traders\' Union under the company name and absconded to Pata Pata Pita with the money.\n\nAs a result, ";
         this.strings["frm_Travel2_good_event_22_36"] = "\'s loan has increased by <font color=\'#F05555\'><b>";
         this.strings["frm_Travel2_good_event_22_37"] = " kubars</b></font>.";
         this.strings["frm_Travel2_good_event_22_38"] = " must pay for a crew member who has contracted a mysterious disease while on the job.\n\nThe total bill comes out to <font color=\'#F05555\'><b>";
         this.strings["frm_Travel2_good_event_22_39"] = " kubars</b></font>.  Luckily, the Traders\' Union loans ";
         this.strings["frm_Travel2_good_event_22_40"] = " the money.";
         this.strings["frm_Travel2_good_event_22_41"] = "\'s ship is damaged when a small bomb explodes in the engine room.\n\nAs a result, ";
         this.strings["frm_Travel2_good_event_22_42"] = " is forced to borrow <font color=\'#F05555\'><b>";
         this.strings["frm_Travel2_good_event_22_43"] = " kubars</b></font> from the Traders\' Union to pay for the repairs.";
         this.strings["frm_Travel2_good_event_22_44"] = "\'s ship is vandalized by a gang of thugs.\n\nAs a result, ";
         this.strings["frm_Travel2_good_event_22_45"] = " is forced to borrow <font color=\'#F05555\'><b>";
         this.strings["frm_Travel2_good_event_22_46"] = " kubars</b></font> from the Traders\' Union to pay for the repairs.";
         this.strings["frm_Travel2_good_event_22_47"] = " is sued by the public for shipping commodities laced with poison.\n\nThe Imperial Court orders ";
         this.strings["frm_Travel2_good_event_22_48"] = " to pay <font color=\'#F05555\'><b>";
         this.strings["frm_Travel2_good_event_22_49"] = " kubars</b></font> in fines.  Luckily, the Traders\' Union loans ";
         this.strings["frm_Travel2_good_event_22_50"] = " the money.";
         this.strings["frm_Travel2_good_event_23_1"] = "<p align=\'center\'><font size=\'+5\'><b>Flipping Coin</b></font></p>\nYour ship is stopped by Yoyo, a notorious gambler.  Yoyo offers to make you a wager.\n\nHe will flip a coin.  If it comes up tails, he will pay you <font color=\'#91FF4B\'><b>";
         this.strings["frm_Travel2_good_event_23_2"] = " kubars</b></font>.  If it comes up heads, you will pay him <font color=\'#91FF4B\'><b>";
         this.strings["frm_Travel2_good_event_23_3"] = " kubars</b></font>.\n\nDo you accept Yoyo\'s offer?";
         this.strings["frm_Travel2_good_event_23_4"] = "<p align=\'center\'><font size=\'+5\'><b>Heads!!!</b></font></p>\nSorry, you lose.\n\nYou should know by now that it never pays to gamble with a pro!";
         this.strings["frm_Travel2_good_event_24_1"] = "<p align=\'center\'><font size=\'+5\'><b>Charity Request</b></font></p>\nLimpus, a renowned humanitarian and philanthropist, asks if you would like to <font color=\'#91FF4B\'><b>donate the cargo</b></font> you have in your ship to the Kukubian Childrens\' Fund.\n\nDo you give your valuable cargo to the needy children?";
         this.strings["frm_Travel2_good_event_24_2"] = "<p align=\'center\'><font size=\'+5\'><b>Blessed!</b></font></p>\nWhen the Grand Sages, Kukubia\'s most venerated religious figures, hear of how your struggling company offered to give up its precious cargo for needy children, they grant your company the <font color=\'#77D7FF\'><b>highest blessing</b></font>.";
         this.strings["frm_Travel2_good_event_25_1"] = "<p align=\'center\'><font size=\'+5\'><b>Trade Engine?</b></font></p>\nSleg, an inter-galactic commodities broker, asks if you will trade your ";
         this.strings["frm_Travel2_good_event_25_2"] = "-kuarp engine for his ";
         this.strings["frm_Travel2_good_event_25_3"] = "-kuarp engine.\n\nHe has a valuable shipment of Uliss Leaves that he must transport to Outer Glosser right away, and he is willing to pay you <font color=\'#91FF4B\'><b>";
         this.strings["frm_Travel2_good_event_25_4"] = " kubars</b></font> if you\'ll make the trade.\n\nWill you do it?";
         this.strings["frm_Travel2_good_event_26_1"] = "<p align=\'center\'><font size=\'+5\'><b>Royal Visitor</b></font></p>\nSupreme Commander Dred Nicolson, Emperor of the New Realm, pays a visit to your company.\n\nHe says your company is critical to the success of Kukubia, and he will do his best to support free trade and open up new markets.";
         this.strings["frm_Travel2_good_event_27_1"] = "<p align=\'center\'><font size=\'+5\'><b>Helping Monk</b></font></p>\nYou come across Iso, a painfully shy monk who disdains material possessions.\n\nPilgrims often seek out Iso for blessings and give her extraordinary sums of money, but Iso has no use for these pieces of paper.  Thus, Iso gives them away to anyone who will take them.\n\nAre you interested in relieving Iso of <font color=\'#77D7FF\'><b>";
         this.strings["frm_Travel2_good_event_27_2"] = " kubars</b></font>?";
         this.strings["frm_Travel2_good_event_28_1"] = "<p align=\'center\'><font size=\'+5\'><b>Chance To Cash Out</b></font></p>\nYou bump into R.J. Raffety, a big-time speculator.  R.J. is always scheming to buy more stock than the rules permit.  One of R.J.\'s legal loop holes is to buy stock between the planets, where Imperial Law is fuzzy.\n\nR.J. makes you an offer to buy all your shares on the ";
         this.strings["frm_Travel2_good_event_28_2"] = " Exchange for the current market price plus an extra 15%.  You currently own ";
         this.strings["frm_Travel2_good_event_28_3"] = " shares on the ";
         this.strings["frm_Travel2_good_event_28_4"] = " Exchange.  The price you paid is ";
         this.strings["frm_Travel2_good_event_28_5"] = " and the current market price is ";
         this.strings["frm_Travel2_good_event_28_6"] = ".\n\nThis means you stand to make a profit of <font color=\'#91FF4B\'><b>";
         this.strings["frm_Travel2_good_event_28_7"] = " kubars</b></font> if you sell now.  Are you interested in selling?";
         this.strings["frm_Travel2_good_event_29_1"] = "<p align=\'center\'><font size=\'+5\'><b>Chance To Invest</b></font></p>\nNebbit, a big-time stock broker, offers you a special deal.\n\nIf you\'re interested, he\'s willing to arrange for you to purchase ";
         this.strings["frm_Travel2_good_event_29_2"] = " shares of stock on the ";
         this.strings["frm_Travel2_good_event_29_3"] = " Exchange for <font color=\'#91FF4B\'><b>20% less</b></font> than the current market price.  This will cost you a total of ";
         this.strings["frm_Travel2_good_event_29_4"] = " kubars.  Nebbit wouldn\'t do this except that one of his clients is caught in a bind and cannot make it to ";
         this.strings["frm_Travel2_good_event_29_5a"] = " to sell the shares.\n\nAre you interested?";
         this.strings["frm_Travel2_good_event_29_5b"] = " to sell the shares.";
         this.strings["frm_Travel2_good_event_29_5c"] = "\n\nAre you interested?";
         this.strings["frm_Travel2_good_event_30_1"] = "<p align=\'center\'><font size=\'+5\'><b>Emergency Service Request</b></font></p>\nTatilus, an emergency passenger broker, says that he has ";
         this.strings["frm_Travel2_good_event_30_2"] = " passengers desperate to get to ";
         this.strings["frm_Travel2_good_event_30_3"] = " this week.\n\nIf you\'ll take them onboard your ship, he\'ll pay you <font color=\'#91FF4B\'><b>5,000 kubars per passenger</b></font>.\n\nAre you interested?";
         this.strings["frm_Travel2_good_event_31_1"] = "<p align=\'center\'><font size=\'+5\'><b>Gas Guzzler</b></font></p>\nGurttle, a notorious fuel fiend, grabs onto your fuel tank and demands that you give him something to drink.  Like all fuel fiends, Gurttle must consume copious amounts of oil in order to perform his bi-weekly mating rituals.\n\nGurttle offers to pay you <font color=\'#91FF4B\'><b>";
         this.strings["frm_Travel2_good_event_31_2"] = " kubars</b></font> if you\'ll allow him to gulp down half of the fuel presently in your tank.  Your tank is currently ";
         this.strings["frm_Travel2_good_event_31_3"] = "% full.\n\nDo you accommodate Gurttle\'s biological needs?";
         this.strings["frm_Travel2_good_event_32_1"] = "<p align=\'center\'><font size=\'+5\'><b>Prince\'s Offer</b></font></p>\nLord 104, the 104th Prince of the Leaper Colony, is a wealthy and wild speculator.  He gets a kick out of hopping from one galaxy to the next buying and selling anything he can get.\n\nLord 104 offers to buy up all of your cargo for <font color=\'#91FF4B\'><b>";
         this.strings["frm_Travel2_good_event_32_2"] = " kubars</b></font>, which is <font color=\'#91FF4B\'><b>three times</b></font> as much as you paid for it!\n\nDo you accept Lord 104\'s offer?";
         this.strings["frm_Travel2_good_event_33_1"] = "<p align=\'center\'><font size=\'+5\'><b>Exotic For Sale</b></font></p>\nNectum, a foreign commodities wholesaler, offers to sell you ";
         this.strings["frm_Travel2_good_event_33_2a"] = " tons of Exotic for <font color=\'#91FF4B\'><b>only</b></font> 100 kubars per ton.\n\nNectum explains that his trip has been delayed 3 months, and if he doesn\'t sell the Exotic now, it will go bad before he returns home.\n\nAre you interested?";
         this.strings["frm_Travel2_good_event_33_2b"] = " tons of Exotic for <font color=\'#91FF4B\'><b>only</b></font> 100 kubars per ton.\n\nNectum explains that his trip has been delayed 3 months, and if he doesn\'t sell the Exotic now, it will go bad before he returns home.";
         this.strings["frm_Travel2_good_event_33_2c"] = "\n\nAre you interested?";
         this.strings["frm_Travel2_good_event_34_1"] = "<p align=\'center\'><font size=\'+5\'><b>Swapping Cargo</b></font></p>\nSquowk, a migrating commodities merchant, offers to <font color=\'#91FF4B\'><b>exchange</b></font> all the cargo on your ship for ";
         this.strings["frm_Travel2_good_event_34_2"] = " tons of ";
         this.strings["frm_Travel2_good_event_34_3"] = ".\n\nSquowk says he has a surplus of ";
         this.strings["frm_Travel2_good_event_34_4"] = " under his wings and can\'t wait to unload it.\n\nAre you interested in making a trade?";
         this.strings["frm_Travel2_good_event_35_1"] = "<p align=\'center\'><font size=\'+5\'><b>Purchase Offer</b></font></p>\nCaptain Leahy, an ex-pirate turned respectable businessman, offers to buy all of your cargo for <font color=\'#91FF4B\'><b>";
         this.strings["frm_Travel2_good_event_35_2"] = " kubars</b></font>, which is <font color=\'#91FF4B\'><b>twice</b></font> as much as you paid for it.\n\nHe assures you this is entirely legal, and you will make a guaranteed profit.\n\nDo you accept Leahy\'s offer?";
         this.strings["frm_Travel2_good_event_36_0"] = "<p align=\'center\'><font size=\'+5\'><b>Free Advice</b></font></p>\nMulls, a reclusive, retired business consultant, comes out of his shell to offer you a piece of <font color=\'#91FF4B\'><b>free advice</b></font>:";
         this.strings["frm_Travel2_good_event_36_1"] = "\n\n<i>\"Never invest in the stock market until you\'ve paid off all your debts.\"</i>";
         this.strings["frm_Travel2_good_event_36_2"] = "\n\n<i>\"Always try to fill up your ship\'s cargo bay.  It\'s better to make a small profit than no profit at all.\"</i>";
         this.strings["frm_Travel2_good_event_36_3"] = "\n\n<i>\"Always look for the commodities with the highest potential profit margin.  Cheap goods usually don\'t pay enough to cover your expenses.\"</i>";
         this.strings["frm_Travel2_good_event_36_4"] = "\n\n<i>\"Don\'t pay your crew until you absolutely have to.  That same money could be in the bank earning interest.\"</i>";
         this.strings["frm_Travel2_good_event_36_5"] = "\n\n<i>\"Don\'t pay your taxes until you absolutely have to.  That same money could be in the bank earning interest.\"</i>";
         this.strings["frm_Travel2_good_event_36_6"] = "\n\n<i>\"Only invest in stocks which are on an upward trend.\"</i>";
         this.strings["frm_Travel2_good_event_36_7"] = "\n\n<i>\"Don\'t purchase a larger ship until you\'ve paid off all of your debts.\"</i>";
         this.strings["frm_Travel2_good_event_36_8"] = "\n\n<i>\"Don\'t buy facilities until you\'ve paid off all of your debts.\"";
         this.strings["frm_Travel2_good_event_36_9"] = "\n\n<i>\"If Mr. Zinn or the Traders\' Union offers to extend your credit limit, always say <b>yes!</b>\"</i>";
         this.strings["frm_Travel2_good_event_36_10"] = "\n\n<i>\"Always obey the law.\"</i>";
         this.strings["frm_Travel2_good_event_36_11"] = "\n\n<i>\"Make sure you have a faster engine than your competitors.  Speed makes a difference.\"</i>";
         this.strings["frm_Travel2_good_event_36_12"] = "\n\n<i>\"Don\'t use the warehouse until you\'ve paid off all of your debts.  Remember that goods sitting in the warehouse cost money, and you\'re paying interest on that money every turn.\"</i>";
         this.strings["frm_Travel2_good_event_36_13"] = "\n\n<i>\"Always read the daily news and weather reports.  If they predict trouble, buy insurance before travelling.\"</i>";
         this.strings["frm_Travel2_good_event_36_14"] = "\n\n<i>\"Always try the planet specials.  They tend to do more good than harm.\"</i>";
         this.strings["frm_Travel2_good_event_36_15"] = "\n\n<i>\"Luck runs in streaks.  If you\'re on a bad luck streak, make sure to buy insurance before travelling.\"</i>";
         this.strings["frm_Travel2_good_event_36_16"] = "\n\n<i>\"Always fill up on fuel when the price is cheap.\"</i>";
         this.strings["frm_Travel2_good_event_36_17"] = "\n\n<i>\"Make sure to raise your passenger ticket prices and advertise.  The combination of high ticket prices and advertising can bring in more money.\"</i>";
         this.strings["frm_Travel2_good_event_36_18"] = "\n\n<i>\"Never allow your crew to go on strike.  When they demand to be paid, you\'d better pay them.\"</i>";
         this.strings["frm_Travel2_good_event_36_19"] = "\n\n<i>\"Mr. Zinn typically offers a better rate than the Traders\' Union.  If possible, don\'t pay off Mr. Zinn\'s loan until you\'ve completely paid off your Traders\' Union debt.\"</i>";
         this.strings["frm_Travel2_good_event_36_20"] = "\n\n<i>\"Look to buy the commodities in the highest price range with the greatest room for profit.  Remember, you have a limited cargo space, so you must maximize your profit potential.\"</i>";
         this.strings["frm_Travel2_good_event_37_1"] = "<p align=\'center\'><font size=\'+5\'><b>Turbocharging Engine</b></font></p>\nYou come across Teeter, a travelling repairman.  Teeter says that he has the necessary parts to <font color=\'#91FF4B\'><b>turbocharge</b></font> your ship\'s engine.  This will only cost you <font color=\'#91FF4B\'><b>";
         this.strings["frm_Travel2_good_event_37_2"] = " kubars</b></font>.\n\nAre you interested?";
         this.strings["frm_Travel2_good_event_37_3"] = "<p align=\'center\'><font size=\'+5\'><b>Expanding Cargo Bay</b></font></p>\nYou come across Teeter, a travelling repairman.  Teeter says that he has the necessary parts to <font color=\'#91FF4B\'><b>expand</b></font> your ship\'s <font color=\'#91FF4B\'><b>cargo bay</b></font> by 10 tons.  This will only cost you <font color=\'#91FF4B\'><b>";
         this.strings["frm_Travel2_good_event_37_4"] = " kubars</b></font>.\n\nAre you interested?";
         this.strings["frm_Travel2_good_event_37_5"] = "<p align=\'center\'><font size=\'+5\'><b>Adding Passenger Seat</b></font></p>\nYou come across Teeter, a travelling repairman.  Teeter says that he has the necessary parts to <font color=\'#91FF4B\'><b>expand</b></font> your ship\'s <font color=\'#91FF4B\'><b>passenger capacity</b></font> by 1 seat.  This will only cost you <font color=\'#91FF4B\'><b>";
         this.strings["frm_Travel2_good_event_37_6"] = " kubars</b></font>.\n\nAre you interested?";
         this.strings["frm_Travel2_good_event_37_7"] = "<p align=\'center\'><font size=\'+5\'><b>Upping Tank Capacity</b></font></p>\nYou come across Teeter, a travelling repairman.  Teeter says that he has the necessary parts to <font color=\'#91FF4B\'><b>expand</b></font> your ship\'s <font color=\'#91FF4B\'><b>fuel tank</b></font> capacity by 5 tons.  This will only cost you <font color=\'#91FF4B\'><b>";
         this.strings["frm_Travel2_good_event_37_8"] = " kubars</b></font>.\n\nAre you interested?";
         this.strings["frm_Travel2_good_event_37_9"] = "<p align=\'center\'><font size=\'+5\'><b>Engine Upgraded!</b></font></p>\nTeeter may not look like a genius, but he manages to <font color=\'#77D7FF\'><b>turbocharge</b></font> your ship\'s engine in record time.";
         this.strings["frm_Travel2_good_event_37_10"] = "<p align=\'center\'><font size=\'+5\'><b>Engine Upgraded!</b></font></p>\nTeeter is brilliant!  In no time, he manages to <font color=\'#77D7FF\'><b>turbocharge</b></font> your ship\'s engine.";
         this.strings["frm_Travel2_good_event_37_11"] = "<p align=\'center\'><font size=\'+5\'><b>Engine Upgraded!</b></font></p>\nTeeter is a genius!  He manages to <font color=\'#77D7FF\'><b>turbocharge</b></font> your ship\'s engine without any trouble!";
         this.strings["frm_Travel2_good_event_37_12"] = "<p align=\'center\'><font size=\'+5\'><b>Cargo Bay Expanded</b></font></p>\nTeeter may not look like a genius, but he manages to expand your ship\'s cargo bay by <font color=\'#77D7FF\'><b>10 tons</b></font> in record time.";
         this.strings["frm_Travel2_good_event_37_13"] = "<p align=\'center\'><font size=\'+5\'><b>Cargo Bay Expanded</b></font></p>\nTeeter is brilliant!  In no time, he manages to expand your ship\'s cargo bay by <font color=\'#77D7FF\'><b>10 tons</b></font>.";
         this.strings["frm_Travel2_good_event_37_14"] = "<p align=\'center\'><font size=\'+5\'><b>Cargo Bay Expanded</b></font></p>\nTeeter is a genius!  He manages to expand your ship\'s cargo bay by <font color=\'#77D7FF\'><b>10 tons</b></font> without any trouble!";
         this.strings["frm_Travel2_good_event_37_15"] = "<p align=\'center\'><font size=\'+5\'><b>More Passenger Seat</b></font></p>\nTeeter may not look like a genius, but he manages to expand your ship\'s passenger capacity by <font color=\'#77D7FF\'><b>1 seat</b></font> in record time.";
         this.strings["frm_Travel2_good_event_37_16"] = "<p align=\'center\'><font size=\'+5\'><b>More Passenger Seat</b></font></p>\nTeeter is brilliant!  In no time, he manages to expand your ship\'s passenger capacity by <font color=\'#77D7FF\'><b>1 seat</b></font>.";
         this.strings["frm_Travel2_good_event_37_17"] = "<p align=\'center\'><font size=\'+5\'><b>More Passenger Seat</b></font></p>\nTeeter is a genius!  He manages to expand your ship\'s passenger capacity by <font color=\'#77D7FF\'><b>1 seat</b></font> without any trouble!";
         this.strings["frm_Travel2_good_event_37_18"] = "<p align=\'center\'><font size=\'+5\'><b>Bigger Fuel Tank</b></font></p>\nTeeter may not look like a genius, but he manages to expand your ship\'s fuel tank capacity by <font color=\'#77D7FF\'><b>5 tons</b></font> in record time.";
         this.strings["frm_Travel2_good_event_37_19"] = "<p align=\'center\'><font size=\'+5\'><b>Bigger Fuel Tank</b></font></p>\nTeeter is brilliant!  In no time, he manages to expand your ship\'s fuel tank capacity by <font color=\'#77D7FF\'><b>5 tons</b></font>.";
         this.strings["frm_Travel2_good_event_37_20"] = "<p align=\'center\'><font size=\'+5\'><b>Bigger Fuel Tank</b></font></p>\nTeeter is a genius!  He manages to expand your ship\'s fuel tank capacity by <font color=\'#77D7FF\'><b>5 tons</b></font> without any trouble!";
         this.strings["frm_Travel2_good_event_38_1"] = "<p align=\'center\'><font size=\'+5\'><b>Automating Computer System</b></font></p>\nYou happen across Meeg, a true adolescent technoid who claims to know just about everything.\n\nMeeg offers to entirely re-program your ship\'s computers, which will allow you to <font color=\'#91FF4B\'><b>replace</b></font> one of your crew members with a fully automated system.  The entire job will cost you ";
         this.strings["frm_Travel2_good_event_38_2a"] = " kubars and may upset the labor union, but it could save you money in the long run.\n\nAre you interested?";
         this.strings["frm_Travel2_good_event_38_2b"] = " kubars and may upset the labor union, but it could save you money in the long run.";
         this.strings["frm_Travel2_good_event_38_2c"] = "\n\nAre you interested?";
         this.strings["frm_Travel2_good_event_38_3"] = "<p align=\'center\'><font size=\'+5\'><b>System Screwed</b></font></p>\nYou should have known better than to let Meeg near your computers.  He winds up crashing your entire system.  Not only does this delay your trip, but the only way to get the system back up and running is to purchase an entirely new motherboard.\n\nObviously, Meeg doesn\'t charge you for his time, but the parts alone wind up costing you a total of <font color=\'#F05555\'><b>";
         this.strings["frm_Travel2_good_event_38_4"] = " kubars!</b></font>";
         this.strings["frm_Travel2_good_event_38_4_insurance"] = " kubars!</b></font>\n\nYou are also informed that insurance does not cover self-inflicted computer crashes.";
         this.strings["frm_Travel2_good_event_38_5"] = "<p align=\'center\'><font size=\'+5\'><b>Success!</b></font></p>\nMeeg is successful!  He manages to re-program your system so that you can now eliminate one of your crew members from your payroll.\n\nTo say the least, the Labor Union is not happy with this development.";
         this.strings["frm_Travel2_good_event_39_1"] = "<p align=\'center\'><font size=\'+5\'><b>Home For Tramp?</b></font></p>\nYou happen across Spike the Space Mutt.\n\nSpike hops on board your ship and makes himself at home.\n\nYou have a choice.  Either you can adopt this stray dog, or you can leave him on his asteroid.\n\nDo you adopt Spike?";
         this.strings["frm_Travel2_good_event_39_2"] = "<p align=\'center\'><font size=\'+5\'><b>Nightmare</b></font></p>\nSpike the Space Mutt turns out to be a real pain in the neck.\n\nHe runs wild on your ship, harassing your passengers, chewing holes in your new seats, tearing apart your wiring, and relieving himself on your bed.\n\nYou finally end up dumping Spike on a passing asteroid, but not before he inflicts <font color=\'#F05555\'><b>";
         this.strings["frm_Travel2_good_event_39_3"] = " kubars</b></font> worth of damage on your ship.";
         this.strings["frm_Travel2_good_event_39_3_insurance"] = " kubars</b></font> worth of damage on your ship.\n\nYou are also informed that insurance does not cover household pets.";
         this.strings["frm_Travel2_good_event_40_1"] = "<p align=\'center\'><font size=\'+5\'><b>Aggressive Proposition</b></font></p>\nNibble, a professional bully, offers to intimidate your crew into lowering their salary.\n\nHe assures you this union busting tactic works every time.  Nibble promises to do the job for <font color=\'#91FF4B\'><b>only</b></font> ";
         this.strings["frm_Travel2_good_event_40_2a"] = " kubars.  How about it?";
         this.strings["frm_Travel2_good_event_40_2b"] = " kubars.";
         this.strings["frm_Travel2_good_event_40_2c"] = " \n\nHow about it?";
         this.strings["frm_Travel2_good_event_40_3"] = "<p align=\'center\'><font size=\'+5\'><b>Disastrous Result</b></font></p>\nNibble\'s harassment and bullying backfires, and your crew becomes so infuriated with these underhanded tactics that they go on <font color=\'#F05555\'><b>strike</b></font>!  They demand that you raise their weekly salary or they won\'t come back.\n\nTo settle this strike, you are forced to get rid of Nibble, pay your crew <font color=\'#F05555\'><b>";
         this.strings["frm_Travel2_good_event_40_4"] = " kubars</b></font> in back wages, and <font color=\'#F05555\'><b>raise</b></font> your crew\'s weekly salary by 100 kubars per person.";
         this.strings["frm_Travel2_good_event_40_5"] = "<p align=\'center\'><font size=\'+5\'><b>Disastrous Result</b></font></p>\nNibble\'s harassment and bullying backfires, and your crew becomes so infuriated with these underhanded tactics that they go on <font color=\'#F05555\'><b>strike</b></font>!  They demand that you raise their weekly salary or they won\'t come back.\n\nTo settle this strike, you are forced to get rid of Nibble and <font color=\'#F05555\'><b>raise</b></font> your crew\'s weekly salary by 100 kubars per person.";
         this.strings["frm_Travel2_good_event_40_6"] = "<p align=\'center\'><font size=\'+5\'><b>It Worked</b></font></p>\nNibble\'s intimidation tactics pay off.  He manages to break up the union and scare your crew into <font color=\'#77D7FF\'><b>lowering</b></font> their salary by 100 kubars per person each week.\n\nThis, however, does not leave your crew feeling too good about their working environment.";
         this.strings["frm_Travel2_good_event_41_1"] = "<p align=\'center\'><font size=\'+5\'><b>Waste Wanted</b></font></p>\nA distraught pregnant space fly, commonly known as a Speevak, offers to pay you <font color=\'#91FF4B\'><b>";
         this.strings["frm_Travel2_good_event_41_2"] = " kubars</b></font> if you will empty your ship\'s septic tanks onto her asteroid.\n\nThe waste is perfect for breeding baby flies, and she promises to clean up afterwards.\n\nDo you agree?";
         this.strings["frm_Travel2_good_event_41_3"] = "<p align=\'center\'><font size=\'+5\'><b>Sanitation Hazard</b></font></p>\nWhen the sanitation police learn what you have done, they immediately fine you <font color=\'#F05555\'><b>";
         this.strings["frm_Travel2_good_event_41_4"] = " kubars</b></font> for illegal waste disposal.\n\nThey warn you that if they catch you doing this again, they may have to remove all the toilets from your ship.";
         this.strings["frm_Travel2_good_event_41_4_insurance"] = " kubars</b></font> for illegal waste disposal.\n\nThey warn you that if they catch you doing this again, they may have to remove all the toilets from your ship.\n\nYou are also informed that insurance does not cover illegal waste disposal.";
         this.strings["frm_Travel2_good_event_42_1"] = "<p align=\'center\'><font size=\'+5\'><b>Thug\'s Proposition</b></font></p>\nThe Hapa Jillo Crime Syndicate approaches you with a devious proposal.  They are willing to make life extremely difficult for your competitors if you pay them <font color=\'#91FF4B\'><b>";
         this.strings["frm_Travel2_good_event_42_2a"] = " kubars</b></font>.\n\nDo you want to accept this evil offer?";
         this.strings["frm_Travel2_good_event_42_2b"] = " kubars</b></font>.";
         this.strings["frm_Travel2_good_event_42_2c"] = "\n\nDo you want to accept this evil offer?";
         this.strings["frm_Travel2_good_event_42_3"] = "<p align=\'center\'><font size=\'+5\'><b>You Are Caught</b></font></p>\nLittle did you know, the Imperial Police discover this evil scheme before it can be hatched.\n\nYou are indicted on charges of conspiring to ruin your competitors, fined <font color=\'#F05555\'><b>";
         this.strings["frm_Travel2_good_event_42_4"] = " kubars</b></font>, and warned that if you break the law again you could wind up in jail.";
         this.strings["frm_Travel2_good_event_42_6"] = "A gang of Hapa Jillo street thugs vandalize ";
         this.strings["frm_Travel2_good_event_42_7"] = ", causing <font color=\'#F05555\'><b>";
         this.strings["frm_Travel2_good_event_42_8"] = " kubars</b></font> worth of damage.";
         this.strings["frm_Travel2_good_event_42_10"] = "A Hapa Jillo banker tricks ";
         this.strings["frm_Travel2_good_event_42_11"] = " into investing in a dubious stock fund.  This winds up costing the company <font color=\'#F05555\'><b>";
         this.strings["frm_Travel2_good_event_42_12"] = " kubars</b></font>.";
         this.strings["frm_Travel2_good_event_42_14"] = "A Hapa Jillo cruiser attacks ";
         this.strings["frm_Travel2_good_event_42_15"] = " and steals a shipload of cargo, worth <font color=\'#F05555\'><b>";
         this.strings["frm_Travel2_good_event_42_16"] = " kubars</b></font>.";
         this.strings["frm_Travel2_good_event_42_18"] = "A remote control droid sent from the Hapa Jillo empire intercepts ";
         this.strings["frm_Travel2_good_event_42_19"] = " and explodes, causing <font color=\'#F05555\'><b>";
         this.strings["frm_Travel2_good_event_42_20"] = " kubars</b></font> worth of damage.";
         this.strings["frm_Travel2_good_event_42_22"] = "A group of Hapa Jillos attack ";
         this.strings["frm_Travel2_good_event_42_23"] = "\'s warehouse on ";
         this.strings["frm_Travel2_good_event_42_24"] = ", causing <font color=\'#F05555\'><b>";
         this.strings["frm_Travel2_good_event_42_25"] = " kubars</b></font> worth of damage.";
         this.strings["frm_Travel2_good_event_42_28"] = " loses <font color=\'#F05555\'><b>";
         this.strings["frm_Travel2_good_event_42_29"] = " kubars</b></font> when a corrupt Hapa Jillo merchant sells the company defective goods.";
         this.strings["frm_Travel2_good_event_42_31"] = "A mob of Hapa Jillos attacks ";
         this.strings["frm_Travel2_good_event_42_32"] = ".  Several of the crew members wind up in the hospital, and this costs the company <font color=\'#F05555\'><b>";
         this.strings["frm_Travel2_good_event_42_33"] = " kubars</b></font>.";
         this.strings["frm_Travel2_good_event_42_36"] = " discovers that its fuel has been tampered with.  This ends up ruining the engine and costs the company <font color=\'#F05555\'><b>";
         this.strings["frm_Travel2_good_event_42_37"] = " kubars</b></font> to repair.";
         this.strings["frm_Travel2_good_event_42_39"] = "A scandal breaks out when ";
         this.strings["frm_Travel2_good_event_42_40"] = " is accused of hiring illegal Hapa Jillo employees.  The company winds up paying <font color=\'#F05555\'><b>";
         this.strings["frm_Travel2_good_event_42_41"] = " kubars</b></font> in legal fees to clear up this messy situation.";
         this.strings["frm_Travel2_good_event_42_43"] = "A passenger flying with ";
         this.strings["frm_Travel2_good_event_42_44"] = " becomes ill and is rushed to the hospital.  The company ends up paying <font color=\'#F05555\'><b>";
         this.strings["frm_Travel2_good_event_42_45"] = " kubars</b></font> to the passenger to avoid a costly lawsuit.";
         this.strings["frm_Travel2_good_event_42_47"] = "A Hapa Jillo battle ship attacks ";
         this.strings["frm_Travel2_good_event_42_48"] = ".  Fortunately, ";
         this.strings["frm_Travel2_good_event_42_49"] = " escapes, but not without sustaining <font color=\'#F05555\'><b>";
         this.strings["frm_Travel2_good_event_42_50"] = " kubars</b></font> in damage.";
         this.strings["frm_Travel2_good_event_42_53"] = " is sued by the Hapa Jillo Merchants\' Association for unfair trade practices.  Although a court finds ";
         this.strings["frm_Travel2_good_event_42_54"] = " innocent, the company still winds up paying <font color=\'#F05555\'><b>";
         this.strings["frm_Travel2_good_event_42_55"] = " kubars</b></font> in legal fees.";
         this.strings["frm_Travel2_good_event_43"] = "<p align=\'center\'><font size=\'+5\'><b>Travel Time Shortened</b></font></p>\nBecause of some skillful maneuvering on the part of your pilot, it will take you considerably <font color=\'#77D7FF\'><b>less time</b></font> than expected to reach your destination planet.";
         this.strings["frm_Travel2_good_event_44_1"] = "<p align=\'center\'><font size=\'+5\'><b>Transportation Needed</b></font></p>\nSnoz Lombardo, a less than acclaimed lounge singer, stops your ship.\n\nHe says that he has just landed a contract at a hot lounge on ";
         this.strings["frm_Travel2_good_event_44_2"] = ".  He\'s willing to pay you <font color=\'#91FF4B\'><b>";
         this.strings["frm_Travel2_good_event_44_3"] = " kubars</b></font> if you take him there right away.\n\nHow about it?";
         this.strings["frm_Travel2_good_event_45_1"] = "<p align=\'center\'><font size=\'+5\'><b>Desperate Dancer</b></font></p>\nLady Shimmer, a former polka dancer, waves down your ship.\n\nShe explains that her vessel ran out of gas, and she desperately needs a lift to <font color=\'#91FF4B\'><b>";
         this.strings["frm_Travel2_good_event_45_2"] = "</b></font>, where she\'s supposed to give a performance for the Emperor himself.  She\'d be so grateful if you\'d take her there right away.\n\nDo you give Shimmer a lift to ";
         this.strings["frm_Travel2_good_event_45_3"] = "?";
         this.strings["frm_Travel2_good_event_45_4"] = "<p align=\'center\'><font size=\'+5\'><b>Happy Dancer</b></font></p>\nYou are well on your way to ";
         this.strings["frm_Travel2_good_event_45_5"] = " when another ship comes out to greet Lady Shimmer.  Delighted, Lady Shimmer gives you a bright smile, hands you two free passes to her show, then hops on the ship.\n\nYou watch speechless, as Lady Shimmer waves good-bye from the departing spacecraft.\n\nWas it really worth it?";
         this.strings["frm_Travel2_good_event_45_6"] = "<p align=\'center\'><font size=\'+5\'><b>Kindness Rewarded</b></font></p>\nYou are well on your way to ";
         this.strings["frm_Travel2_good_event_45_7"] = " when another ship comes out to greet Lady Shimmer.  It is none other than Emperor Dred Nicolson himself.\n\nThe Emperor greets you and thanks you for going to all the trouble.\n\nAs compensation, he hands you a gold medallion worth <font color=\'#77D7FF\'><b>";
         this.strings["frm_Travel2_good_event_45_8"] = " kubars</b></font>!";
         this.strings["frm_Travel2_good_event_46_1"] = "<p align=\'center\'><font size=\'+5\'><b>So Far Away</b></font></p>\nYou discover a Teal Tree, a lonely breed of wild space oak, growing on an asteroid.\n\nThis tree begs you to take her to planet <font color=\'#91FF4B\'><b>";
         this.strings["frm_Travel2_good_event_46_2"] = "</b></font>, so she can be reunited with her grove.  It\'s been years since she was uprooted, and she is desperate to get back to her native soil.\n\nDo you take this tree to ";
         this.strings["frm_Travel2_good_event_46_3"] = "?";
         this.strings["frm_Travel2_good_event_46_4"] = "<p align=\'center\'><font size=\'+5\'><b>The Teal\'s Gift</b></font></p>\nThe Teal Tree is so thankful that you are taking her to ";
         this.strings["frm_Travel2_good_event_46_5"] = " to be reunited with her grove that she offers to pay you <font color=\'#77D7FF\'><b>";
         this.strings["frm_Travel2_good_event_46_6"] = " kubars</b></font> for your trouble.\n\nShe insists that you are the kindest person in the galaxy.  She knows the money isn\'t enough, but it\'s all she has, and she hopes it will do.";
         this.strings["frm_Travel2_good_event_47_1"] = "<p align=\'center\'><font size=\'+5\'><b>Water Guzzler</b></font></p>\nStubbs, a crazed water junkie, offers to pay you <font color=\'#91FF4B\'><b>";
         this.strings["frm_Travel2_good_event_47_2"] = " kubars</b></font> for all of the water on your ship.\n\nYou should realize that this will mean your passengers and crew cannot have a drink nor take a bath until they reach the next planet.  If you\'re lucky, this shouldn\'t cause any serious problems, but you can\'t be sure about that.\n\nDo you want to take this chance?";
         this.strings["frm_Travel2_good_event_47_3"] = "<p align=\'center\'><font size=\'+5\'><b>Wrong Planet</b></font></p>\nDue to a lack of water, several passengers start raising a fuss, your crew nearly mutinies, and everyone stinks.\n\nTo make matters worse, your pilot becomes so dehydrated that he performs a serious <font color=\'#F05555\'><b>navigation error</b></font>.\n\nFortunately, nobody dies.  However, your ship winds up travelling to ";
         this.strings["frm_Travel2_good_event_47_4"] = " instead of ";
         this.strings["frm_Travel2_good_event_47_5"] = ".";
         this.strings["frm_Travel2_bad_event_2_1"] = "<p align=\'center\'><font size=\'+5\'><b>Donation Request</b></font></p>\nSupreme Commander Dred Nicolson, Emperor of the New Realm, pays a visit to your company.  He praises your hard work and loyal support of the New Realm.\n\nAt the end of his speech, he asks you to make a small donation of <font color=\'#91FF4B\'><b>";
         this.strings["frm_Travel2_bad_event_2_2"] = " kubars</b></font> to the Imperial Trust Fund.\n\nDo you donate the money?";
         this.strings["frm_Travel2_bad_event_2_3a"] = "Special Tax";
         this.strings["frm_Travel2_bad_event_2_3b"] = "Without any explanation, the Government informs you that they are adding a special one-time fee of <font color=\'#F05555\'><b>";
         this.strings["frm_Travel2_bad_event_2_4"] = " kubars</b></font> to your taxes.";
         this.strings["frm_Travel2_bad_event_3_0"] = "Warehouse Fire";
         this.strings["frm_Travel2_bad_event_3_1"] = "A fire breaks out in your warehouse on planet ";
         this.strings["frm_Travel2_bad_event_3_2"] = ".\n\nLuckily you don\'t have any goods in that warehouse!";
         this.strings["frm_Travel2_bad_event_3_3"] = "A fire breaks out in your warehouse on planet ";
         this.strings["frm_Travel2_bad_event_3_4"] = ".\n\nYou lose 1 ton of goods in the fire.";
         this.strings["frm_Travel2_bad_event_3_4_insurance"] = ".  You lose 1 ton of goods in the fire.\n\nLuckily you have <font color=\'#77D7FF\'><b>Voyagers\' Insurance!</b></font>  The insurance company replaces all of the goods destroyed in the fire.";
         this.strings["frm_Travel2_bad_event_3_5"] = "A fire breaks out in your warehouse on planet ";
         this.strings["frm_Travel2_bad_event_3_6"] = ".\n\nYou lose ";
         this.strings["frm_Travel2_bad_event_3_7"] = " tons of goods in the fire.";
         this.strings["frm_Travel2_bad_event_3_7_insurance"] = " tons of goods in the fire.\n\nLuckily you have <font color=\'#77D7FF\'><b>Voyagers\' Insurance!</b></font>  The insurance company replaces all of the goods destroyed in the fire.";
         this.strings["frm_Travel2_bad_event_4_1"] = "<p align=\'center\'><font size=\'+5\'><b>Insurance Rate Increase</b></font></p>\nDue to a reassessment of your company\'s accident records, your Voyagers\' Insurance premiums have been <font color=\'#F05555\'><b>raised</b></font> an average of ";
         this.strings["frm_Travel2_bad_event_4_2"] = "%.";
         this.strings["frm_Travel2_bad_event_5_1"] = "<p align=\'center\'><font size=\'+5\'><b>Rate Increase</b></font></p>\nOut of pure greed, Mr. Zinn <font color=\'#F05555\'><b>raises</b></font> your interest rate from ";
         this.strings["frm_Travel2_bad_event_5_2"] = " % to ";
         this.strings["frm_Travel2_bad_event_5_3"] = " %.";
         this.strings["frm_Travel2_bad_event_5_3_insurance"] = " %.\n\nSorry, but insurance does not cover this type of problem.";
         this.strings["frm_Travel2_bad_event_6_1"] = "<p align=\'center\'><font size=\'+5\'><b>Rate Increase</b></font></p>\nBecause your company has been labelled as a high credit risk, the Traders\' Union <font color=\'#F05555\'><b>raises</b></font> your loan rate from ";
         this.strings["frm_Travel2_bad_event_6_2"] = " % to ";
         this.strings["frm_Travel2_bad_event_6_3"] = " %.";
         this.strings["frm_Travel2_bad_event_6_3_insurance"] = " %.\n\nSorry, but insurance does not cover this type of problem.";
         this.strings["frm_Travel2_bad_event_7_1"] = "<p align=\'center\'><font size=\'+5\'><b>Lawsuit</b></font></p>\nA crew member gets into an accident while at work, and the United Space Workers\' Union sues your company.\n\nYour company loses, and the court awards the crew member <font color=\'#F05555\'><b>";
         this.strings["frm_Travel2_bad_event_7_2"] = " kubars</b></font>.";
         this.strings["frm_Travel2_bad_event_7_2_insurance"] = " kubars</b></font>.\n\nLuckily you have <font color=\'#77D7FF\'><b>Voyagers\' Insurance!</b></font>  The insurance company reimburses you in full for the losses.";
         this.strings["frm_Travel2_bad_event_8_1"] = "<p align=\'center\'><font size=\'+5\'><b>Demanding Union</b></font></p>\nDue to an increase in the cost of living, the United Space Workers\' Union demands that you <font color=\'#F05555\'><b>raise</b></font> your employees\' weekly salary by 100 kubars per person.\n\nDo you agree to raise their salary?  If you answer no, there is a chance the crew will go on strike.";
         this.strings["frm_Travel2_bad_event_8_1_insurance"] = "<p align=\'center\'><font size=\'+5\'><b> Demanding Union</b></font></p>\nDue to an increase in the cost of living, the United Space Workers\' Union demands that you <font color=\'#F05555\'><b>raise</b></font> your employees\' weekly salary by 100 kubars per person.\n\nDo you agree to raise their salary?  If you answer no, there is a chance the crew will go on strike.  Insurance won\'t cover the cost of wage increase or loss due to strike.";
         this.strings["frm_Travel2_bad_event_9_1"] = "<p align=\'center\'><font size=\'+5\'><b>Must Pay Now</b></font></p>\nMr. Zinn has run into financial difficulties and asks you to <font color=\'#F05555\'><b>pay back half</b></font> the money you owe him.\n\nThat means you must pay Mr. Zinn ";
         this.strings["frm_Travel2_bad_event_9_2"] = " kubars right away!";
         this.strings["frm_Travel2_bad_event_9_2_insurance"] = " kubars right away!\n\nToo bad, but Voyagers\' Insurance cannot help you with this.";
         this.strings["frm_Travel2_bad_event_10_1"] = "<p align=\'center\'><font size=\'+5\'><b>Rebels\' Demand</b></font></p>\nThe Chichi Bobo Rebels intercept your vessel.  They demand you pay a revolutionary tax of <font color=\'#F05555\'><b>";
         this.strings["frm_Travel2_bad_event_10_2"] = " kubars</b></font> in support of the struggle to overthrow Supreme Commander Dred Nicolson.\n\nYou end up giving the rebels valuable parts of your ship, which you must now pay to replace.";
         this.strings["frm_Travel2_bad_event_10_2_insurance"] = " kubars</b></font> in support of the struggle to overthrow Supreme Commander Dred Nicolson.\n\nYou end up giving the rebels valuable parts of your ship, which you must now pay to replace.\n\nLuckily you have <font color=\'#77D7FF\'><b>Voyagers\' Insurance!</b></font>  The insurance company reimburses you in full for all losses and replaces damaged items.";
         this.strings["frm_Travel2_bad_event_10_3"] = "<p align=\'center\'><font size=\'+5\'><b>Unpleasant Visitors</b></font></p>\nThe Darleen Smugglers stop your ship and become furious when they discover that you don\'t have any cargo they can steal.  They harass you and your crew for a few hours, then grow bored and leave.";
         this.strings["frm_Travel2_bad_event_10_4"] = "<p align=\'center\'><font size=\'+5\'><b>Robbed Clean</b></font></p>\nThe Darleen Smugglers stop your ship and help themselves to <font color=\'#F05555\'><b>all your cargo</b></font>.";
         this.strings["frm_Travel2_bad_event_10_4_insurance"] = "<p align=\'center\'><font size=\'+5\'><b>Unpleasant Visitors</b></font></p>\nThe Darleen Smugglers stop your ship and help themselves to all your cargo.\n\nLuckily you have <font color=\'#77D7FF\'><b>Voyagers\' Insurance!</b></font>  The insurance company reimburses you in full for all losses and replaces stolen items.";
         this.strings["frm_Travel2_bad_event_10_5"] = "<p align=\'center\'><font size=\'+5\'><b>Raided By Bandits</b></font></p>\nYou are unlucky enough to get jumped by the Baid-Rowel Bandits.  They become so angry when the find out that you don\'t have any cargo to steal that they inflict <font color=\'#F05555\'><b>";
         this.strings["frm_Travel2_bad_event_10_6"] = " kubars</b></font> worth of damage to your ship.";
         this.strings["frm_Travel2_bad_event_10_6_insurance"] = " kubars</b></font> worth of damage to your ship.\n\nLuckily you have <font color=\'#77D7FF\'><b>Voyagers\' Insurance!</b></font>  The insurance company reimburses you in full for all losses and replaces damaged items.";
         this.strings["frm_Travel2_bad_event_10_7"] = "<p align=\'center\'><font size=\'+5\'><b>Raided By Bandits</b></font></p>\nYou are unlucky enough to get jumped by the Baid-Rowel Bandits.\n\nThey not only <font color=\'#F05555\'><b>steal all your cargo</b></font> but also inflict <font color=\'#F05555\'><b>";
         this.strings["frm_Travel2_bad_event_10_8"] = " kubars</b></font> worth of damage to your ship.";
         this.strings["frm_Travel2_bad_event_10_8_insurance"] = " kubars</b></font> worth of damage to your ship.\n\nLuckily you have <font color=\'#77D7FF\'><b>Voyagers\' Insurance!</b></font>  The insurance company reimburses you in full for all losses and replaces any damaged or stolen items.";
         this.strings["frm_Travel2_bad_event_10_9"] = "<p align=\'center\'><font size=\'+5\'><b>Rowdies</b></font></p>\nYou stumble into a crowd of mad Mooglers, a rowdy group of anarchists.\n\nTo prove their point, they trash your ship, causing <font color=\'#F05555\'><b>";
         this.strings["frm_Travel2_bad_event_10_10"] = " kubars</b></font> worth of damage.";
         this.strings["frm_Travel2_bad_event_10_10_insurance"] = " kubars</b></font> worth of damage.\n\nLuckily you have <font color=\'#77D7FF\'><b>Voyagers\' Insurance!</b></font>  The insurance company reimburses you in full for all losses and replaces damaged items.";
         this.strings["frm_Travel2_bad_event_10_11"] = "<p align=\'center\'><font size=\'+5\'><b>Fez Fa Fa!</b></font></p>\nYou happen to run into a herd of ever hungry Fez Fa Fa.\n\nWith unyielding appetites, these wild beasts break into your ship and begin gobbling up everything in sight, including a few of your crew members.  Their corrosive saliva winds up causing <font color=\'#F05555\'><b>";
         this.strings["frm_Travel2_bad_event_10_12"] = " kubars</b></font> worth of damage to your ship.\n\nYou are lucky they get full by the time they come around to you.";
         this.strings["frm_Travel2_bad_event_10_12_insurance"] = " kubars</b></font> worth of damage to your ship.  You are lucky they get full by the time they come around to you.\n\nYou also have <font color=\'#77D7FF\'><b>Voyagers\' Insurance!</b></font>  The insurance company reimburses you in full for all losses and replaces damaged items.";
         this.strings["frm_Travel2_bad_event_10_13"] = "<p align=\'center\'><font size=\'+5\'><b>Warring Clan</b></font></p>\nYou run smack into a tribe of Hungo Warriors on the war path.\n\nThese legendary fighters do your ship no harm but carry off one of your more attractive crew members for initiation into their clan.";
         this.strings["frm_Travel2_bad_event_10_14"] = "<p align=\'center\'><font size=\'+5\'><b>Warring Clan</b></font></p>\nYou run smack into a tribe of Hungo Warriors on the war path.\n\nThese legendary fighters take <font color=\'#F05555\'><b>all your cargo</b></font> and even carry off one of your more attractive crew members for initiation into their clan.";
         this.strings["frm_Travel2_bad_event_10_14_insurance"] = "<p align=\'center\'><font size=\'+5\'><b>Warring Clan</b></font></p>\nYou run smack into a tribe of Hungo Warriors on the war path.\n\nThese legendary fighters take <font color=\'#F05555\'><b>all your cargo</b></font> and even carry off one of your more attractive crew members for initiation into their clan.\n\nLuckily you have <font color=\'#77D7FF\'><b>Voyagers\' Insurance!</b></font>  The insurance company at least reimburses you in full for all losses and replaces stolen items.";
         this.strings["frm_Travel2_bad_event_10_15"] = "<p align=\'center\'><font size=\'+5\'><b>Brain Robbers</b></font></p>\nYou stumble into the mental channel of the Cylet Mind Buggers.\n\nWithout even boarding your ship, they steal the brains of two of your crew members and melt down your primary navigation circuits in the process, causing <font color=\'#F05555\'><b>";
         this.strings["frm_Travel2_bad_event_10_16"] = " kubars</b></font> worth of damage.";
         this.strings["frm_Travel2_bad_event_10_16_insurance"] = " kubars</b></font> worth of damage.\n\nLuckily you have <font color=\'#77D7FF\'><b>Voyagers\' Insurance!</b></font>  The insurance company reimburses you in full for all losses and replaces damaged items.";
         this.strings["frm_Travel2_bad_event_10_17"] = "<p align=\'center\'><font size=\'+5\'><b>Brain Robbers</b></font></p>\nYou stumble into the mental channel of the Cylet Mind Buggers.\n\nWithout even boarding your ship, they steal the brains of two of your crew members, remove <font color=\'#F05555\'><b>all your cargo</b></font>, and melt down your primary navigation circuits in the process, causing <font color=\'#F05555\'><b>";
         this.strings["frm_Travel2_bad_event_10_18"] = " kubars</b></font> worth of damage.";
         this.strings["frm_Travel2_bad_event_10_18_insurance"] = " kubars</b></font> worth of damage.\n\nLuckily you have <font color=\'#77D7FF\'><b>Voyagers\' Insurance!</b></font>  The insurance company reimburses you in full for all losses and replaces any damaged and stolen items.";
         this.strings["frm_Travel2_bad_event_10_19a"] = "Unfortunate Collision";
         this.strings["frm_Travel2_bad_event_10_19b"] = "You are unlucky enough to run smack into a herd of mindless Lippo Jungies.  These huge space-whales smack right into your ship, inflicting <font color=\'#F05555\'><b>";
         this.strings["frm_Travel2_bad_event_10_20"] = " kubars</b></font> worth of damage.";
         this.strings["frm_Travel2_bad_event_10_20_insurance"] = " kubars</b></font> worth of damage.\n\nLuckily you have <font color=\'#77D7FF\'><b>Voyagers\' Insurance!</b></font>   The insurance company reimburses you in full for all losses and replaces damaged items.";
         this.strings["frm_Travel2_bad_event_10_21"] = "<p align=\'center\'><font size=\'+5\'><b>Unwanted Attachment</b></font></p>\nA group of nasty little Wicky Wicks attach themselves to your ship\'s engine and won\'t let go.  Unable to move, you are at their mercy.\n\nWhen they find out you have no cargo to steal, they let you go unharmed.";
         this.strings["frm_Travel2_bad_event_10_22"] = "<p align=\'center\'><font size=\'+5\'><b>Unwanted Attachment</b></font></p>\nA group of nasty little Wicky Wicks attach themselves to your ship\'s engine and won\'t let go.  Unable to move, you are at their mercy.\n\nThe only way to convince these slime balls to free your ship is to surrender <font color=\'#F05555\'><b>all your cargo</b></font>.";
         this.strings["frm_Travel2_bad_event_10_22_insurance"] = "<p align=\'center\'><font size=\'+5\'><b>Unwanted Attachment</b></font></p>\nA group of nasty little Wicky Wicks attach themselves to your ship\'s engine and won\'t let go.  Unable to move, you are at their mercy.\n\nThe only way to convince these slime balls to free your ship is to surrender <font color=\'#F05555\'><b>all your cargo</b></font>.\n\nLuckily you have <font color=\'#77D7FF\'><b>Voyagers\' Insurance!</b></font>  The insurance company reimburses you in full for all losses and replaces lost cargo.";
         this.strings["frm_Travel2_bad_event_10_23"] = "<p align=\'center\'><font size=\'+5\'><b>Rowdy Visitor</b></font></p>\nA band of space pirates, who happen to be descendants of the infamous Bro Nap Goodshark, overtake your ship.\n\nUnable to find any cargo to steal, they wind up playing around with your navigation controls, drinking all your beverages, and generally making a mess.";
         this.strings["frm_Travel2_bad_event_10_24"] = "<p align=\'center\'><font size=\'+5\'><b>Rowdy Visitor</b></font></p>\nA band of space pirates, who happen to be descendants of the infamous Bro Nap Goodshark, overtake your ship.\n\nAfter a few hours of playing around with your navigation controls, drinking all your beverages, and generally making a mess, they steal <font color=\'#F05555\'><b>all your cargo</b></font> and take off.";
         this.strings["frm_Travel2_bad_event_10_24_insurance"] = "<p align=\'center\'><font size=\'+5\'><b>Rowdy Visitor</b></font></p>\nA band of space pirates, who happen to be descendants of the infamous Bro Nap Goodshark, overtake your ship.\n\nAfter a few hours of playing around with your navigation controls, drinking all your beverages, and generally making a mess, they steal <font color=\'#F05555\'><b>all your cargo</b></font> and take off.\n\nLuckily you have <font color=\'#77D7FF\'><b>Voyagers\' Insurance!</b></font>  The insurance company reimburses you in full for all losses and replaces stolen items.";
         this.strings["frm_Travel2_bad_event_11_1a"] = "Close Escape";
         this.strings["frm_Travel2_bad_event_11_1b"] = "A meteor storm pummels your ship!  Your ship\'s hull is badly damaged, and you must pay <font color=\'#F05555\'><b>";
         this.strings["frm_Travel2_bad_event_11_2"] = " kubars</b></font> to have it repaired.";
         this.strings["frm_Travel2_bad_event_11_2_insurance"] = " kubars</b></font> to have it repaired.\n\nLuckily you have <font color=\'#77D7FF\'><b>Voyagers\' Insurance!</b></font>  Your insurance reimburses you in full and replaces damaged items.";
         this.strings["frm_Travel2_bad_event_11_3a"] = "Pounding Storm";
         this.strings["frm_Travel2_bad_event_11_3b"] = "You are unable to avoid the solar storm, and it thrashes your ship.  Your expensive L-Tech engine is nearly shredded, and you must pay <font color=\'#F05555\'><b>";
         this.strings["frm_Travel2_bad_event_11_4"] = " kubars</b></font> to have it repaired.";
         this.strings["frm_Travel2_bad_event_11_4_insurance"] = " kubars</b></font> to have it repaired.\n\nLuckily you have <font color=\'#77D7FF\'><b>Voyagers\' Insurance!</b></font>  Your insurance reimburses you in full and replaces damaged items.";
         this.strings["frm_Travel2_bad_event_11_5a"] = "Relentless Hurricane";
         this.strings["frm_Travel2_bad_event_11_5b"] = "You encounter a space hurricane, and it batters your ship!  Your ship\'s guidance system is damaged, and you must pay <font color=\'#F05555\'><b>";
