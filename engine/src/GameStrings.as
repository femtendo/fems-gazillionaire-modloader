         this.strings["frm_HowManyPlayers_text"] = "<p align=\'center\'><font size=\'+5\'><b>How Many Players?</b></font></p>\nPlease select how many players (<i>human only</i>) will be playing the game?\n\nIn addition to the human players, six computer companies will also compete in each game.";
