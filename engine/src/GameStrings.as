         this.strings["frm_Market_not_enough_space"] = "You don\'t have cargo capacity to buy that much.";
         this.strings["frm_Market_full"] = "Your ship is already full of cargo.  You can not buy any more until you have room.";
         this.strings["frm_Market_none_for_sale_1"] = "The planet has no ";
         this.strings["frm_Market_none_for_sale_2"] = " available to buy at this time.";
         this.strings["frm_Market_help_1_1"] = "As a space merchant, your goal is to <b>buy commodities</b> for a <b>low price</b> on one planet, then travel to another planet and sell them for a substantially higher price.\n\nYour ship can hold up to <b>";
         this.strings["frm_Market_help_1_2"] = " tons</b> of cargo.  As long as you have enough money and room on your ship, you can purchase any of the goods available for sale.\n\nIf you make a mistake and buy the wrong commodity, just return it right away and you\'ll get a full refund.";
         this.strings["frm_Market_help_2_1"] = "<b>Your Cargo</b> is the amount of commodities you have on your ship.\n\n<b>On ";
         this.strings["frm_Market_help_2_2"] = "</b> is the amount of commodities for sale on this planet.\n\n<b>You Paid</b> is the <b>average</b> price you paid for the commodities.\n\n<b>Market Price</b> is the price that the commodities are selling for on this planet.\n\n<b>Price Range</b> shows the lowest and highest possible prices at which commodities may be sold.";
         this.strings["frm_Market_help_3"] = "While <b>Quick Trade</b> is turned <b>off</b>, you can select a product by clicking on the commodity.\n\nWhen <b>Quick Trade</b> is turned <b>on</b>, clicking on a commodity automatically launches <b>Buy</b> or <b>Sell</b>.\n\n<b>Show Available</b> displays commodities that are available for sale on this planet as well as any commodities you may have on your ship.\n\n<b>Show Cargo</b> displays only commodities that are already on your ship.\n\n<b>Show All</b> displays all commodities.";
         this.strings["frm_Supply_button_market"] = "Marketplace";
