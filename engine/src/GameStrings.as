         this.strings["frm_Warehouse_nothing_selected"] = "To take or store cargo, you must first select something to take or store by clicking on its row.";
         this.strings["frm_Warehouse_take_0"] = "<p align=\'center\'><b>Take ";
         this.strings["frm_Warehouse_take_1"] = "</b></p>\nTons in warehouse: ";
         this.strings["frm_Warehouse_take_2"] = "\nCargo space available on ship: ";
         this.strings["frm_Warehouse_take_3"] = "\n\nTake how many tons?";
         this.strings["frm_Warehouse_store_0"] = "<p align=\'center\'><b>Store ";
         this.strings["frm_Warehouse_store_1"] = "</b></p>\nTons on ship: ";
         this.strings["frm_Warehouse_store_2"] = "\nAvailable Space in warehouse: ";
         this.strings["frm_Warehouse_store_3"] = "\n\nStore how many tons?";
         this.strings["frm_Warehouse_not_enough_space"] = "There is not enough room on your ship.\n\nCheck your cargo capacity.";
         this.strings["frm_Warehouse_not_enough_in_warehouse_1"] = "You cannot take that much.\n\nCheck the tons of ";
         this.strings["frm_Warehouse_not_enough_in_warehouse_2"] = " in the warehouse.";
         this.strings["frm_Warehouse_not_enough_on_ship_1"] = "You don\'t have that many tons of ";
         this.strings["frm_Warehouse_not_enough_on_ship_2"] = " on your ship.";
         this.strings["frm_Warehouse_not_enough_free_warehouse_space"] = "You don\'t have enough room left in your warehouse for that much.";
         this.strings["frm_Warehouse_help_1"] = "You currently have <b>";
         this.strings["frm_Warehouse_help_2"] = " tons</b> of warehouse space.  That means you can store up to ";
         this.strings["frm_Warehouse_help_3"] = " tons of commodities on <b>each planet</b>.\n\nUnfortunately, you cannot increase your warehouse space whenever you feel like it.  The Traders\' Union strictly regulates the sale of all space.  This helps to maintain a trade balance between the various planets and prevents the larger companies from monopolizing the market.\n\nBy virtue of being a member of the Traders\' Union, your name is automatically entered into a lottery.  If your name comes up, you will be given the chance to purchase more space.";
         this.strings["frm_Passengers_button_pick_up"] = "Pick Up Passengers";
         this.strings["frm_Passengers_button_set_price"] = "Set Ticket Price";
         this.strings["frm_Passengers_bar0"] = "Passenger Seats Filled:   ";
         this.strings["frm_Passengers_bar1"] = "%   (";
         this.strings["frm_Passengers_bar2"] = " / ";
         this.strings["frm_Passengers_bar3"] = ")";
         this.strings["frm_Passengers_text_1"] = "Profit This Week:  ";
         this.strings["frm_Passengers_text_2"] = "Passenger Capacity:  ";
         this.strings["frm_Passengers_text_3"] = "Passengers On Ship:  ";
         this.strings["frm_Passengers_text_4"] = "Passengers Waiting:  ";
         this.strings["frm_Passengers_text_5a"] = "Ticket Price This Week:  <font size=\'+3\'><b>";
         this.strings["frm_Passengers_text_5b"] = "</b></font>          Ticket Price For Next Planet:  <font size=\'+3\'><b>";
         this.strings["frm_Passengers_text_5c"] = "</b></font>";
         this.strings["frm_Passengers_already_picked_up"] = "You have already picked up your passengers.";
         this.strings["frm_Passengers_set_price"] = "<p align=\'center\'><b>Set Ticket Price</b>\n\nEnter new ticket price:</p>";
         this.strings["frm_Passengers_price_too_low"] = "You cannot charge less than 100 kubars per ticket.";
         this.strings["frm_Passengers_help_1"] = "Your ship can accommodate up to <b>";
         this.strings["frm_Passengers_help_2"] = " passengers</b>.\n\nYou can charge as much or as little as you like for tickets.  If your ticket price is too high, nobody will want to travel on your ship.  If your ticket price is too low, it will be difficult to make a profit.\n\nIn the future, you may be given the opportunity to buy a larger ship.  The larger your ship, the more passengers you can carry.";
         this.strings["frm_Advertising_button_place_ad"] = "Place Ads";
         this.strings["frm_Advertising_passenger_head"] = "Passenger";
         this.strings["frm_Advertising_commodity_head"] = "Commodity";
         this.strings["frm_Advertising_ad_level_0_1"] = "Do Not Advertise (<b>";
         this.strings["frm_Advertising_ad_level_0_2"] = "</b> kubars)";
         this.strings["frm_Advertising_ad_level_1_1"] = "Fliers (<b>";
         this.strings["frm_Advertising_ad_level_1_2"] = "</b> kubars)";
         this.strings["frm_Advertising_ad_level_2_1"] = "Newspaper (<b>";
         this.strings["frm_Advertising_ad_level_2_2"] = "</b> kubars)";
         this.strings["frm_Advertising_ad_level_3_1"] = "Magazine (<b>";
         this.strings["frm_Advertising_ad_level_3_2"] = "</b> kubars)";
         this.strings["frm_Advertising_ad_level_4_1"] = "Radio (<b>";
         this.strings["frm_Advertising_ad_level_4_2"] = "</b> kubars)";
         this.strings["frm_Advertising_ad_level_5_1"] = "TV (<b>";
         this.strings["frm_Advertising_ad_level_5_2"] = "</b> kubars)";
         this.strings["frm_Advertising_ad_level_6_1"] = "Everything (<b>";
         this.strings["frm_Advertising_ad_level_6_2"] = "</b> kubars)";
         this.strings["frm_Advertising_text_1"] = "Advertising For Next Planet";
         this.strings["frm_Advertising_text_1_none"] = "None";
         this.strings["frm_Advertising_text_2"] = "Passenger Advertising";
         this.strings["frm_Advertising_text_3"] = "Commodity Advertising";
         this.strings["frm_Advertising_text_4"] = "Your Cash";
         this.strings["frm_Advertising_text_5"] = "Choose advertising and click on Place Ads to advertise for the next planet.";
         this.strings["frm_Advertising_not_enough_cash"] = "You don\'t have enough money.\n\nCheck your cash.";
         this.strings["frm_Advertising_help_1"] = "There are two types of advertising:   Passenger Advertising and Commodity Advertising.\n\nThe more you spend on <b>Passenger Advertising</b>, the greater the chance that more passengers will be waiting to buy tickets on the next planet.\n\nThe more you invest in <b>Commodity Advertising</b>, the more units will be available for you to purchase on the next planet.";
         this.strings["frm_Advertising_help_2"] = "Commodity Advertising does not affect the price of the commodities.  It only affects the amount of commodities available for you to purchase on the next planet.\n\nAny money you spend on advertising is only effective for <b>one week</b>.  If you forget to advertise before travelling to a planet, don\'t expect any results.";
         this.strings["frm_Advertising_help_3"] = "If you purchase a new, larger ship, your advertising costs will go up because you will need more passengers and commodities to fill the larger ship.";
         this.strings["frm_Employee_button_pay"] = "Pay Crew";
         this.strings["frm_Employee_image_txt"] = "Union Boss";
         this.strings["frm_Employee_text_1"] = "Number of Employees (Crew)";
         this.strings["frm_Employee_text_2"] = "Weekly Salary per Person";
         this.strings["frm_Employee_text_3"] = "Total Wages Owed";
         this.strings["frm_Employee_text_4"] = "Your Cash";
         this.strings["frm_Employee_text_message_1"] = "Your crew demands that you pay them their salary!";
         this.strings["frm_Employee_text_message_2"] = "Your crew appears to be upset over the fact that you haven\'t paid them.";
         this.strings["frm_Employee_text_message_3"] = "Your crew seems mildly annoyed over the fact that you haven\'t paid them.";
         this.strings["frm_Employee_text_message_4"] = "Your crew\'s morale is high and everyone seems to be happy.";
         this.strings["frm_Employee_no_wages_owed"] = "You don\'t owe your employees any money.\n\nCheck total wages owed.";
         this.strings["frm_Employee_not_enough_cash"] = "You don\'t have enough money.\n\nCheck your cash.";
         this.strings["frm_Employee_help_1"] = "The number of employees you have depends on the size and type of your ship.\n\nYour company currently employs <b>";
         this.strings["frm_Employee_help_2"] = " crew members</b>.  You must pay <b>each</b> employee a weekly salary of <b>";
         this.strings["frm_Employee_help_3"] = " kubars</b>.\n\nYou will not be required to hire any additional employees until you purchase a larger ship.";
         this.strings["frm_Tax_button_pay"] = "Pay All";
         this.strings["frm_Tax_text_1"] = "Passenger Taxes Accrued";
         this.strings["frm_Tax_text_2"] = "Commodity Tariffs Accrued";
         this.strings["frm_Tax_text_3"] = "Total Taxes Accrued";
         this.strings["frm_Tax_text_4"] = "Your Cash";
         this.strings["frm_Tax_text_message_1"] = "The Tax Auditor warns you to pay your taxes immediately.";
         this.strings["frm_Tax_text_message_2"] = "The Tax Auditor reminds you not to wait until the last minute to pay your taxes.";
         this.strings["frm_Tax_text_message_3"] = "The Tax Auditor says it never hurts to pay your taxes ahead of time.";
         this.strings["frm_Tax_text_message_4"] = "The Tax Auditor says you don\'t have to pay your taxes right away.";
         this.strings["frm_Tax_text_message_5"] = "The Tax Auditor says you don\'t owe the government any money.";
         this.strings["frm_Tax_no_taxes_owed"] = "You don\'t owe the government any money.";
         this.strings["frm_Tax_not_enough_cash"] = "You don\'t have enough money.\n\nCheck your cash.";
         this.strings["frm_Tax_help_1"] = "The Imperial Government, which rules over all of Kukubia, levies two types of taxes:  a <b>Passenger Tax</b> and a <b>Commodities Tariff</b>.\n\nThe Passenger Tax is a <b>";
         this.strings["frm_Tax_help_2"] = "% tax</b> on all income from passengers.\n\nThe Commodities Tariff is a <b>";
         this.strings["frm_Tax_help_3"] = "% tax</b> on all goods <b>exported</b> from a planet and a <b>";
         this.strings["frm_Tax_help_4"] = "% tax</b> on all goods <b>imported</b> to a planet.  If the goods never leave a planet, you will not be charged any tariffs.";
         this.strings["frm_Insurance_button_buy"] = "Buy";
         this.strings["frm_Insurance_image_txt"] = "Insurance Agent";
         this.strings["frm_Insurance_text_1"] = "Your Cash";
         this.strings["frm_Insurance_text_2a"] = "Price Range";
         this.strings["frm_Insurance_text_2b"] = " - ";
         this.strings["frm_Insurance_text_3"] = "Insurance Cost";
         this.strings["frm_Insurance_text_4"] = "Insurance Coverage Next Week";
         this.strings["frm_Insurance_text_4_no"] = "No";
         this.strings["frm_Insurance_text_4_yes"] = "Yes";
         this.strings["frm_Insurance_already_have_insurance"] = "You have already purchased Voyager\'s Insurance.";
         this.strings["frm_Insurance_not_enough_cash"] = "You don\'t have enough money.\n\nCheck your cash.";
         this.strings["frm_Insurance_help_1"] = "Any time you are on a planet, you may purchase Voyager\'s Insurance.\n\nThis insurance will <b>protect you</b> against a number of misfortunes which may occur during space travel, such as damage from asteroids, losses due to space pirates, warehouse fires, and much more.";
         this.strings["frm_Insurance_help_2"] = "If you purchase insurance, it will <b>only</b> cover your <b>next trip</b>.  You must pay an insurance premium every week if you want to be fully covered.\n\nYour insurance costs will rise and fall depending on local conditions, natural disasters, your accident record and fluctuations in the insurance market.";
         this.strings["frm_Insurance_help_3"] = "If you purchase a larger ship or more warehouse space, your insurance costs will also rise.";
         this.strings["frm_Explore_button_special"] = "Special";
         this.strings["frm_Explore_button_news"] = "News";
         this.strings["frm_Explore_button_weather"] = "Weather";
         this.strings["frm_Explore_button_history"] = "About ";
         this.strings["frm_Explore_button_time"] = "Time";
         this.strings["frm_Explore_explored"] = "You have already completed your Planet Special for this week.\n\nTry again next week.";
         this.strings["frm_Explore_help_no_tutorial_1"] = "While on a planet you may visit any of the local institutions.\n\nThe <b>Special</b> allows you to access each planet\'s special resources such as banking, insurance, taxes, religion, engine construction and so on.\n\nThe <b>Weather</b> can alert you to dangerous storms in the area.";
         this.strings["frm_Explore_help_no_tutorial_2_1"] = "The <b>News</b> can provide you with updates on pirate attacks, revolutions and other events which will affect your business.\n\nThe <b>Time</b> and <b>About ";
         this.strings["frm_Explore_help_no_tutorial_2_2"] = "</b> are good sources of Kukubian trivia and background information.";
         this.strings["frm_Explore_help_tutorial_1"] = "From the View City Menu you may access the <b>Ministry of Time</b> or <b>About ";
         this.strings["frm_Explore_help_tutorial_2"] = "</b>.\n\nThese are good sources of Kukubian trivia and background information.";
         this.strings["frm_Special_button_return"] = "Return to Main Menu";
         this.strings["frm_Special_action_return"] = "You have already completed your Planet Special for this week.\n\nTry again next week.";
         this.strings["frm_Special_button_action_0"] = "Petition for Lower Taxes";
         this.strings["frm_Special_action_0"] = "<p align=\'center\'><font size=\'+5\'><b>Imperial Magistrate</b></font></p>\nVexx is the seat of the Imperial Magistrate for the entire system of Kukubia.\n\nWhile on Vexx you can petition the government for <font color=\'#91FF4B\'><b>lower</b></font> import tariffs, export tariffs and passenger taxes.";
         this.strings["frm_Special_button_action_1"] = "Buy Faster Engine";
         this.strings["frm_Special_action_1_1"] = "<p align=\'center\'><font size=\'+5\'><b>L-Tech Sales Rep.</b></font></p>\nPyke is home to L-Tech, the largest engine manufacturer in Kukubia.\n\nWhile on Pyke you can obtain the best deals on new <font color=\'#91FF4B\'><b>faster ";
         this.strings["frm_Special_action_1_2"] = "-kuarp engines</b></font>.\n\nThe cost varies depending on demand.  This week you can purchase a ";
         this.strings["frm_Special_action_1_3"] = "-kuarp engine for <font color=\'#91FF4B\'><b>";
         this.strings["frm_Special_action_1_4"] = " kubars</b></font>.";
         this.strings["frm_Special_action_1_5"] = "  How about it?";
         this.strings["frm_Special_button_action_2"] = "Visit Grand Sages";
         this.strings["frm_Special_action_2"] = "<p align=\'center\'><font size=\'+5\'><b>Grand Sage</b></font></p>\nMira is the oldest and most mystical of all the planets in Kukubia.  The majority of Kukubia\'s religions have their origin on Mira.\n\nWhile on Mira, you may pay a visit to the renowned Grand Sages and ask them for a blessing, which can help to turn a bad luck streak into good fortune.";
         this.strings["frm_Special_button_action_3"] = "Ask for Assistance";
         this.strings["frm_Special_action_3"] = "<p align=\'center\'><font size=\'+5\'><b>Traders\' Union Official</b></font></p>\nStye is the financial capital of Kukubia and where the Traders\' Union Headquarters is located.\n\nWhile on Stye, you can ask the Traders\' Union for financial assistance.\n\nIf you are lucky, they may lower the interest rate on your loan, increase your credit limit, or raise the interest rate on your savings account.";
         this.strings["frm_Special_button_action_4"] = "Grant Crew Ship Leave";
         this.strings["frm_Special_action_4"] = "<p align=\'center\'><font size=\'+5\'><b>Peelia Veelia, Queen of Loro</b></font></p>\nLoro is known throughout Kukubia as the <font color=\'#91FF4B\'><b>Pleasure Planet</b></font>.\n\nIt is the most popular resort and vacation spot in the entire system.\n\nWhile on Loro, you can grant your crew ship leave.  This will boost their morale and make for a better working relationship.";
         this.strings["frm_Special_button_action_5"] = "Ask Zinn a Favor";
         this.strings["frm_Special_action_5"] = "<p align=\'center\'><font size=\'+5\'><b>Mr. Zinn</b></font></p>\nZile is Mr. Zinn\'s home planet.\n\nWhile on Zile, you may pay Mr. Zinn a visit and ask him for a favor.\n\nIf you are lucky, he will lower the interest rate on your loan or increase your credit limit.";
         this.strings["frm_Special_button_action_6"] = "Ask for Lower Premiums";
         this.strings["frm_Special_action_6"] = "<p align=\'center\'><font size=\'+5\'><b>Your Insurance Agent</b></font></p>\nFrac is a bustling business center.\n\nWhile on Frac you can pay a visit to the Voyager\'s Insurance Company headquarters and ask for a reduction in your weekly premiums.";
         this.strings["frm_Special_button_action_7"] = "Try Gambling";
         this.strings["frm_Special_action_7"] = "<p align=\'center\'><font size=\'+5\'><b>Casino Dealer</b></font></p>\nTilo is the only planet in Kukubia with legalized gambling.\n\nIf you\'re feeling lucky, you can try your hand at Tilo\'s most popular game:\n\n<p align=\'center\'><font color=\'#91FF4B\'><b>All Or Nothing</b></font></p>\nIf you win, you\'ll double whatever you bet.\n\nIf you lose, the fun is over.\n\nPlease keep in mind that under Imperial Law, no one is allowed to gamble more than 5% of their total cash in one week.";
         this.strings["frm_Special_button_action_8"] = "Buy from Cornucopia";
         this.strings["frm_Special_action_8_1"] = "<p align=\'center\'><font size=\'+5\'><b>Lady Cornucopia</b></font></p>\nQueg is the infamous renegade planet.  It is here that the galaxy\'s most notorious gangsters come to unload their wares.\n\nThis week Lady Cornucopia, the ruler of Queg, offers to sell you <font color=\'#91FF4B\'><b>";
         this.strings["frm_Special_action_8_2"] = " tons</b></font> of <font color=\'#91FF4B\'><b>";
         this.strings["frm_Special_action_8_3"] = "</b></font> for only <font color=\'#91FF4B\'><b>";
         this.strings["frm_Special_action_8_4"] = " kubars</b></font> per ton.\n\nThe current market price of ";
         this.strings["frm_Special_action_8_5"] = " on Queg is ";
         this.strings["frm_Special_action_8_6"] = " kubars per ton.";
         this.strings["frm_Special_action_8_7"] = "\n\nDo you want this deal?";
         this.strings["frm_Special_button_action_9"] = "Upgrade Your Ship";
         this.strings["frm_Special_action_9_1_1"] = "<p align=\'center\'><font size=\'+5\'><b>Your Mechanic</b></font></p>\nXeen is one giant junkyard filled with spare parts and brilliant mechanics.\n\nYour favorite mechanic claims he has found the necessary parts and can turbocharge your ship\'s engine, but it will cost you <font color=\'#91FF4B\'><b>";
         this.strings["frm_Special_action_9_1_2"] = " kubars</b></font>.";
         this.strings["frm_Special_action_9_2_1"] = "<p align=\'center\'><font size=\'+5\'><b>Your Mechanic</b></font></p>\nXeen is one giant junkyard filled with spare parts and brilliant mechanics.\n\nYour favorite mechanic claims he has found the necessary parts and can expand your ship\'s cargo bay by 10 tons, but it will cost you <font color=\'#91FF4B\'><b>";
         this.strings["frm_Special_action_9_2_2"] = " kubars</b></font>.";
         this.strings["frm_Special_action_9_3_1"] = "<p align=\'center\'><font size=\'+5\'><b>Your Mechanic</b></font></p>\nXeen is one giant junkyard filled with spare parts and brilliant mechanics.\n\nYour favorite mechanic claims he has found the necessary parts and can expand your ship\'s passenger capacity by 1 seat, but it will cost you <font color=\'#91FF4B\'><b>";
         this.strings["frm_Special_action_9_3_2"] = " kubars</b></font>.";
         this.strings["frm_Special_action_9_4_1"] = "<p align=\'center\'><font size=\'+5\'><b>Your Mechanic</b></font></p>\nXeen is one giant junkyard filled with spare parts and brilliant mechanics.\n\nYour favorite mechanic claims he has found the necessary parts and can expand your ship\'s fuel tank capacity by 5 tons, but it will cost you <font color=\'#91FF4B\'><b>";
         this.strings["frm_Special_action_9_4_2"] = " kubars</b></font>.";
         this.strings["frm_Special_action_9_5"] = "</b></font>\n\nDo you want him to work on it?";
         this.strings["frm_Special_button_action_10"] = "Have Your Fortune Read";
         this.strings["frm_Special_action_10_1"] = "<p align=\'center\'><font size=\'+5\'><b>Soothsayer</b></font></p>\nOoom is known throughout the galaxy as the Fortune Tellers\' Planet.  This is because the Soothsayers of Ooom have the uncanny ability to predict the future by scanning one\'s aura for positive or negative energy.\n\nThis week the Soothsayers are charging <font color=\'#91FF4B\'><b>";
         this.strings["frm_Special_action_10_2"] = " kubars</b></font> for their service.";
         this.strings["frm_Special_action_10_3"] = "\n\nDo you want to take out the loan to have your fortune read?";
         this.strings["frm_Special_button_action_11"] = "Do it!";
         this.strings["frm_Special_action_11_1"] = "<p align=\'center\'><font size=\'+5\'><b>Your Agent</b></font></p>\nHork is the media capital of Kukubia, affectionately known as Horkywood.  You have an agent, whose job is to get your company <font color=\'#91FF4B\'><b>free publicity</b></font>.\n\nThis week your agent claims to have a mega media event scheduled for you on the hottest daytime TV talk show.\n\nDo you want to do it?";
         this.strings["frm_Special_action_11_2"] = "<p align=\'center\'><font size=\'+5\'><b>Your Agent</b></font></p>\nHork is the media capital of Kukubia, affectionately known as Horkywood.  You have an agent, whose job is to get your company <font color=\'#91FF4B\'><b>free publicity</b></font>.\n\nThis week your agent claims to have a mega media event scheduled for you on prime time TV.\n\nDo you want to do it?";
         this.strings["frm_Special_action_11_3"] = "<p align=\'center\'><font size=\'+5\'><b>Your Agent</b></font></p>\nHork is the media capital of Kukubia, affectionately known as Horkywood.  You have an agent, whose job is to get your company <font color=\'#91FF4B\'><b>free publicity</b></font>.\n\nThis week your agent claims to have a mega media event scheduled for you with Kukubia\'s most famous sports star.\n\nDo you want to do it?";
         this.strings["frm_Special_action_11_4"] = "<p align=\'center\'><font size=\'+5\'><b>Your Agent</b></font></p>\nHork is the media capital of Kukubia, affectionately known as Horkywood.  You have an agent, whose job is to get your company <font color=\'#91FF4B\'><b>free publicity</b></font>.\n\nThis week your agent claims to have a mega media event scheduled for you with the Ministry of Travel.\n\nDo you want to do it?";
         this.strings["frm_Special_action_11_5"] = "<p align=\'center\'><font size=\'+5\'><b>Your Agent</b></font></p>\nHork is the media capital of Kukubia, affectionately known as Horkywood.  You have an agent, whose job is to get your company <font color=\'#91FF4B\'><b>free publicity</b></font>.\n\nThis week your agent claims to have a mega media event scheduled for you with a journalist from the Astral Reporter.\n\nDo you want to do it?";
         this.strings["frm_Special_action_11_6"] = "<p align=\'center\'><font size=\'+5\'><b>Your Agent</b></font></p>\nHork is the media capital of Kukubia, affectionately known as Horkywood.  You have an agent, whose job is to get your company <font color=\'#91FF4B\'><b>free publicity</b></font>.\n\nThis week your agent claims to have a mega media event scheduled for you on late night TV.\n\nDo you want to do it?";
         this.strings["frm_Special_action_11_7"] = "<p align=\'center\'><font size=\'+5\'><b>Your Agent</b></font></p>\nHork is the media capital of Kukubia, affectionately known as Horkywood.  You have an agent, whose job is to get your company <font color=\'#91FF4B\'><b>free publicity</b></font>.\n\nThis week your agent claims to have a mega media event scheduled for you with the Cosmic Consumer Caucus.\n\nDo you want to do it?";
         this.strings["frm_Special_action_11_8"] = "<p align=\'center\'><font size=\'+5\'><b>Your Agent</b></font></p>\nHork is the media capital of Kukubia, affectionately known as Horkywood.  You have an agent, whose job is to get your company <font color=\'#91FF4B\'><b>free publicity</b></font>.\n\nThis week your agent claims to have a mega media event scheduled for you with the Interplanetary Inquirer.\n\nDo you want to do it?";
         this.strings["frm_Special_action_11_9"] = "<p align=\'center\'><font size=\'+5\'><b>Your Agent</b></font></p>\nHork is the media capital of Kukubia, affectionately known as Horkywood.  You have an agent, whose job is to get your company <font color=\'#91FF4B\'><b>free publicity</b></font>.\n\nThis week your agent claims to have a mega media event scheduled for you on Planet Line News.\n\nDo you want to do it?";
         this.strings["frm_Special_action_11_10"] = "<p align=\'center\'><font size=\'+5\'><b>Your Agent</b></font></p>\nHork is the media capital of Kukubia, affectionately known as Horkywood.  You have an agent, whose job is to get your company <font color=\'#91FF4B\'><b>free publicity</b></font>.\n\nThis week your agent claims to have a mega media event scheduled for you at the Ceremony of the Stars.\n\nDo you want to do it?";
         this.strings["frm_Special_button_action_12"] = "Visit Your Broker";
         this.strings["frm_Special_action_12"] = "<p align=\'center\'><font size=\'+5\'><b>Your Stock Broker</b></font></p>\nBass is where all the stock brokers, market analysts and traders congregate to exchange information.\n\nIf your stock broker is not too busy, she can provide you with detailed information on market conditions across Kukubia.\n\nDo you want to pay her a visit?";
         this.strings["frm_Special_button_action_13"] = "Visit Zobrok";
         this.strings["frm_Special_action_13_1"] = "<p align=\'center\'><font size=\'+5\'><b>Zobrok the Fuel Wholesaler</b></font></p>\nNosh is the fuel depot of Kukubia, and you hear that Zobrok, a big-time wholesaler, is selling fuel at <font color=\'#91FF4B\'><b>";
         this.strings["frm_Special_action_13_2"] = "% off</b></font> the retail price.\n\nIn other words, Zobrok is selling fuel at ";
         this.strings["frm_Special_action_13_3"] = " kubars per ton, while most other distributors are selling it at ";
         this.strings["frm_Special_action_13_4"] = " kubars per ton.";
         this.strings["frm_Special_action_13_5"] = "\n\nDo you want to fill up your tank?";
         this.strings["frm_Special_result_0_1"] = "<p align=\'center\'><font size=\'+5\'><b>Imperial Magistrate</b></font></p>\nThe Imperial Magistrate apologizes for not being able to help, but says his hands are tied.  He has no latitude to raise or lower taxes at the present time.";
         this.strings["frm_Special_result_0_2"] = "<p align=\'center\'><font size=\'+5\'><b>Imperial Magistrate</b></font></p>\nThe Imperial Magistrate does not even bother to respond to your petition.";
         this.strings["frm_Special_result_0_3"] = "<p align=\'center\'><font size=\'+5\'><b>Imperial Magistrate</b></font></p>\nThe Imperial Magistrate promises to do his best to convince the Supreme Commander to lower taxes the next time the Supreme Commander visits Kukubia.";
         this.strings["frm_Special_result_0_4"] = "<p align=\'center\'><font size=\'+5\'><b>Imperial Magistrate</b></font></p>\nThe Imperial Magistrate says he is working on this problem and hopes to make headway in the near future.";
         this.strings["frm_Special_result_0_5"] = "<p align=\'center\'><font size=\'+5\'><b>Imperial Magistrate</b></font></p>\nThe Imperial Magistrate says he is too busy to cater to the needs of every special interest group in the system.  He warns you to think seriously before asking him for any more favors.";
         this.strings["frm_Special_result_0_6"] = "<p align=\'center\'><font size=\'+5\'><b>Imperial Magistrate</b></font></p>\nThe assistant to the Magistrate informs you that the Imperial Magistrate is out on vacation.";
         this.strings["frm_Special_result_0_7_1_1"] = "<p align=\'center\'><font size=\'+5\'><b>Imperial Magistrate</b></font></p>\nThe Imperial Magistrate <font color=\'#77D7FF\'><b>lowers</b></font> the <font color=\'#77D7FF\'><b>passenger tax</b></font> from ";
         this.strings["frm_Special_result_0_7_1_2"] = "% to ";
         this.strings["frm_Special_result_0_7_1_3"] = "%.";
         this.strings["frm_Special_result_0_7_2_1"] = "<p align=\'center\'><font size=\'+5\'><b>Imperial Magistrate</b></font></p>\nAnnoyed by continually being pestered to lower taxes, the Imperial Magistrate instead <font color=\'#F05555\'><b>raises passenger taxes</b></font> from ";
         this.strings["frm_Special_result_0_7_2_2"] = "% to ";
         this.strings["frm_Special_result_0_7_2_3"] = "%.";
         this.strings["frm_Special_result_0_8_1_1"] = "<p align=\'center\'><font size=\'+5\'><b>Imperial Magistrate</b></font></p>\nThe Imperial Magistrate <font color=\'#77D7FF\'><b>lowers</b></font> the <font color=\'#77D7FF\'><b>import tariffs</b></font> from ";
         this.strings["frm_Special_result_0_8_1_2"] = "% to ";
         this.strings["frm_Special_result_0_8_1_3"] = "%.";
         this.strings["frm_Special_result_0_8_2_1"] = "<p align=\'center\'><font size=\'+5\'><b>Imperial Magistrate</b></font></p>\nAnnoyed by continually being pestered to lower taxes, the Imperial Magistrate instead <font color=\'#F05555\'><b>raises</b></font> the <font color=\'#F05555\'><b>import tariffs</b></font> from ";
         this.strings["frm_Special_result_0_8_2_2"] = "% to ";
         this.strings["frm_Special_result_0_8_2_3"] = "%.";
         this.strings["frm_Special_result_0_9_1_1"] = "<p align=\'center\'><font size=\'+5\'><b>Imperial Magistrate</b></font></p>\nThe Imperial Magistrate <font color=\'#77D7FF\'><b>lowers</b></font> the <font color=\'#77D7FF\'><b>export tariffs</b></font> from ";
         this.strings["frm_Special_result_0_9_1_2"] = "% to ";
         this.strings["frm_Special_result_0_9_1_3"] = "%.";
         this.strings["frm_Special_result_0_9_2_1"] = "<p align=\'center\'><font size=\'+5\'><b>Imperial Magistrate</b></font></p>\nAnnoyed by continually being pestered to lower taxes, the Imperial Magistrate instead <font color=\'#F05555\'><b>raises</b></font> the <font color=\'#F05555\'><b>export tariffs</b></font> from ";
         this.strings["frm_Special_result_0_9_2_2"] = "% to ";
         this.strings["frm_Special_result_0_9_2_3"] = "%.";
         this.strings["frm_Special_result_0_10_1_1"] = "<p align=\'center\'><font size=\'+5\'><b>Imperial Magistrate</b></font></p>\nThe Imperial Magistrate generously grants your company an <font color=\'#77D7FF\'><b>emergency tax break</b></font>.  That means you don\'t have to pay <font color=\'#77D7FF\'><b>";
         this.strings["frm_Special_result_0_10_1_2"] = " kubars</b></font> in taxes!  You now owe 0 kubars in taxes and tariffs.";
         this.strings["frm_Special_result_0_10_2"] = "<p align=\'center\'><font size=\'+5\'><b>Imperial Magistrate</b></font></p>\nThe Imperial Magistrate\'s secretary tells you he is in a meeting right now, but the next time you visit the planet, he will be more than happy to talk with you.";
         this.strings["frm_Special_result_0_11"] = "<p align=\'center\'><font size=\'+5\'><b>Imperial Magistrate</b></font></p>\nThe Imperial Magistrate\'s secretary tells you he is in a meeting right now, but the next time you visit the planet, he will be more than happy to talk with you.";
         this.strings["frm_Special_result_0_12"] = "<p align=\'center\'><font size=\'+5\'><b>Imperial Magistrate</b></font></p>\nThe Imperial Magistrate criticizes you for even daring to ask about lowering taxes.  Where is your community spirit?  Don\'t you have any loyalty to the government?";
         this.strings["frm_Special_result_0_13"] = "<p align=\'center\'><font size=\'+5\'><b>Imperial Magistrate</b></font></p>\nThe Imperial Magistrate says he is simply too busy to heed every individual\'s petty request.  If you have an issue worth discussing, such as a donation to the Imperial Treasury, then he will talk to you.";
         this.strings["frm_Special_result_0_14"] = "<p align=\'center\'><font size=\'+5\'><b>Imperial Magistrate</b></font></p>\nThe Imperial Magistrate says he will be meeting with Supreme Commander Dred Nicolson next week, and if the Emperor seems in a good mood, he might dare to bring up the issue of taxes.";
         this.strings["frm_Special_result_0_15"] = "<p align=\'center\'><font size=\'+5\'><b>Imperial Magistrate</b></font></p>\nThe Imperial Magistrate sits you down in his office, and for the next two hours, he complains about how underpaid government bureaucrats are.  He can\'t even afford to take his family on a vacation, and all you think about is paying less taxes!";
         this.strings["frm_Special_result_0_16"] = "<p align=\'center\'><font size=\'+5\'><b>Imperial Magistrate</b></font></p>\nThe Imperial Magistrate instructs you to put down your request in writing, and he will forward it to the Department of Petitions for review.";
         this.strings["frm_Special_result_0_17"] = "<p align=\'center\'><font size=\'+5\'><b>Imperial Magistrate</b></font></p>\nThe Imperial Magistrate has an ulcer and refuses to talk to you.";
         this.strings["frm_Special_result_0_18_1_1"] = "<p align=\'center\'><font size=\'+5\'><b>Imperial Magistrate</b></font></p>\nThe Imperial Magistrate says he understands the trouble your industry is having and is willing to <font color=\'#77D7FF\'><b>lower</b></font> the <font color=\'#77D7FF\'><b>passenger tax</b></font> across the board from ";
         this.strings["frm_Special_result_0_18_1_2"] = "% to ";
         this.strings["frm_Special_result_0_18_1_3"] = "%.";
         this.strings["frm_Special_result_0_18_2_1"] = "<p align=\'center\'><font size=\'+5\'><b>Imperial Magistrate</b></font></p>\nAfter examining your industry\'s tax rates, The Imperial Magistrate comes to the conclusion that your sector is not paying its fair share in taxes.  Consequently, he <font color=\'#F05555\'><b>raises passenger taxes</b></font> for all trading companies from ";
         this.strings["frm_Special_result_0_18_2_2"] = "% to ";
         this.strings["frm_Special_result_0_18_2_3"] = "%.";
         this.strings["frm_Special_result_0_19_1_1"] = "<p align=\'center\'><font size=\'+5\'><b>Imperial Magistrate</b></font></p>\nThe Imperial Magistrate says he understands the need to support trade and commerce between the planets of Kukubia, and he offers to <font color=\'#77D7FF\'><b>lower</b></font> the <font color=\'#77D7FF\'><b>import tariffs</b></font> from ";
         this.strings["frm_Special_result_0_19_1_2"] = "% to ";
         this.strings["frm_Special_result_0_19_1_3"] = "%.";
         this.strings["frm_Special_result_0_19_2_1"] = "<p align=\'center\'><font size=\'+5\'><b>Imperial Magistrate</b></font></p>\nThe Imperial Magistrate says he will not participate in corporate welfare while there are starving children around the galaxy.  Hence, instead of lowering your taxes, he <font color=\'#F05555\'><b>raises</b></font> the <font color=\'#F05555\'><b>import tariffs</b></font> for all the trading companies from ";
         this.strings["frm_Special_result_0_19_2_2"] = "% to ";
         this.strings["frm_Special_result_0_19_2_3"] = "%.";
         this.strings["frm_Special_result_0_20_1_1"] = "<p align=\'center\'><font size=\'+5\'><b>Imperial Magistrate</b></font></p>\nThe Imperial Magistrate says the government\'s new policy is to stimulate growth and lower taxes.  Consequently, he <font color=\'#77D7FF\'><b>cuts</b></font> the <font color=\'#77D7FF\'><b>export tariffs</b></font> for all trading companies from ";
         this.strings["frm_Special_result_0_20_1_2"] = "% to ";
         this.strings["frm_Special_result_0_20_1_3"] = "%.";
         this.strings["frm_Special_result_0_20_2_1"] = "<p align=\'center\'><font size=\'+5\'><b>Imperial Magistrate</b></font></p>\nThe Imperial Magistrate asks you how you expect Kukubia to grow and prosper without paying your fair share?  You use the government\'s navigation system, docking ports, and currency exchange, but you don\'t want to pay taxes.  Well, here\'s something for you.  He is <font color=\'#F05555\'><b>raising</b></font> the <font color=\'#F05555\'><b>export tariffs</b></font> for all companies from ";
         this.strings["frm_Special_result_0_20_2_2"] = "% to ";
         this.strings["frm_Special_result_0_20_2_3"] = "%.";
         this.strings["frm_Special_result_0_21_1_1"] = "<p align=\'center\'><font size=\'+5\'><b>Imperial Magistrate</b></font></p>\nAfter you eloquently explain your company\'s financial situation, the Imperial Magistrate is so moved that he grants your company an <font color=\'#77D7FF\'><b>emergency tax break</b></font>.  That means you don\'t have to pay <font color=\'#77D7FF\'><b>";
         this.strings["frm_Special_result_0_21_1_2"] = " kubars</b></font> in taxes! You now owe 0 kubars in taxes and tariffs.";
         this.strings["frm_Special_result_0_21_2"] = "<p align=\'center\'><font size=\'+5\'><b>Imperial Magistrate</b></font></p>\nWhen you show up at the government office, the Imperial Magistrate\'s assistant informs you that he is booked for the entire week.  If you want to see the Magistrate, you will have to try another time.";
         this.strings["frm_Special_result_0_22"] = "<p align=\'center\'><font size=\'+5\'><b>Imperial Magistrate</b></font></p>\nThe Imperial Magistrate is away on official business.  Please try again another week.";
         this.strings["frm_Special_result_1_1_1_1"] = "<p align=\'center\'><font size=\'+5\'><b>L-Tech Sales Rep.</b></font></p>\nUnfortunately, L-Tech informs you that they are sold out of ";
         this.strings["frm_Special_result_1_1_1_2"] = "-kuarp engines.  If you want a ";
         this.strings["frm_Special_result_1_1_1_3"] = "-kuarp engine, you will have to come back next week.";
         this.strings["frm_Special_result_1_1_2"] = "<p align=\'center\'><font size=\'+5\'><b>L-Tech Sales Rep.</b></font></p>\nWhen you show up at the L-Tech engine plant, they inform you that their mechanic is ill, and they cannot install a new engine.  They ask you to come back next week.";
         this.strings["frm_Special_result_1_1_3"] = "<p align=\'center\'><font size=\'+5\'><b>L-Tech Sales Rep.</b></font></p>\nFor no apparent reason, when you show up at the L-Tech engine plant, it is closed.  You wait for a couple of hours, then end up leaving empty-handed.";
         this.strings["frm_Special_result_1_1_4"] = "<p align=\'center\'><font size=\'+5\'><b>L-Tech Sales Rep.</b></font></p>\nYour L-Tech representative informs you that Emperor Dred Nicolson has requested 500 L-Tech engines for the Imperial Fleet this week.  Things are a madhouse right now, and you will have to come back another time when they are less busy.";
         this.strings["frm_Special_result_1_1_5"] = "<p align=\'center\'><font size=\'+5\'><b>L-Tech Sales Rep.</b></font></p>\nAn L-Tech manager apologizes for the situation.  There is simply no way L-Tech can sell you an engine this week.  The factory has been shut down due to a strike, and no engines are being sold or serviced.";
         this.strings["frm_Special_result_1_1_6"] = "<p align=\'center\'><font size=\'+5\'><b>L-Tech Sales Rep.</b></font></p>\nWhen you show up at the L-Tech factory, a worker runs out shouting fire, fire, fire!  A second later the L-Tech plant explodes in a ball of flames.  So much for buying an engine this week.";
         this.strings["frm_Special_result_1_1_7_1"] = "<p align=\'center\'><font size=\'+5\'><b>L-Tech Sales Rep.</b></font></p>\nA representative from the L-Tech plant informs you that they have just found a serious defect in their latest batch of ";
         this.strings["frm_Special_result_1_1_7_2"] = "-kuarp engines, and they have stopped selling them until the problem is fixed.";
         this.strings["frm_Special_result_1_1_8_1"] = "<p align=\'center\'><font size=\'+5\'><b>L-Tech Sales Rep.</b></font></p>\nWhen you show up at the L-Tech factory, you are informed that Mr. Zinn has just ordered a shipment of fifty ";
         this.strings["frm_Special_result_1_1_8_2"] = "-kuarp engines for his latest business venture.  This means there is nothing left to sell you this week.";
         this.strings["frm_Special_result_1_1_9_1"] = "<p align=\'center\'><font size=\'+5\'><b>L-Tech Sales Rep.</b></font></p>\nJust as you are about to install a brand new ";
         this.strings["frm_Special_result_1_1_9_2"] = "-kuarp L-Tech engine on your ship, one of the dock workers informs you that a disgruntled L-Tech employee has planted bombs in the last three engines they installed.  Hearing this, you decide to cancel your order.";
         this.strings["frm_Special_result_1_1_10"] = "<p align=\'center\'><font size=\'+5\'><b>L-Tech Sales Rep.</b></font></p>\nWhen you show up at L-Tech Engines, the plant is shut down due to a week long national holiday.  Too bad, you\'ll have to wait until next time to buy your engine upgrade.";
         this.strings["frm_Special_result_1_2_1_1"] = "<p align=\'center\'><font size=\'+5\'><b>L-Tech Sales Rep.</b></font></p>\nYou just purchased L-Tech\'s super ";
         this.strings["frm_Special_result_1_2_1_2"] = "-kuarp engine for ";
         this.strings["frm_Special_result_1_2_1_3"] = " kubars.\n\n";
         this.strings["frm_Special_result_1_2_2_1"] = "This should help speed things up!";
         this.strings["frm_Special_result_1_2_2_2"] = "Faster is better!";
         this.strings["frm_Special_result_1_2_2_3"] = "It pays to be first!";
         this.strings["frm_Special_result_1_2_2_4"] = "L-Tech is the best!";
         this.strings["frm_Special_result_1_2_2_5"] = "It\'s worth every kubar!";
         this.strings["frm_Special_result_1_2_2_6"] = "The early bird gets the worm!";
         this.strings["frm_Special_result_1_2_2_7"] = "There\'s a need for speed!";
         this.strings["frm_Special_result_1_2_2_8"] = "Got to keep up with the Joneses!";
         this.strings["frm_Special_result_1_2_2_9"] = "Time is money!";
         this.strings["frm_Special_result_1_2_2_10"] = "You can never be too fast!";
         this.strings["frm_Special_result_1_2_2_11"] = "The race is on!";
         this.strings["frm_Special_result_1_2_2_12"] = "Okay, now you\'re moving!";
         this.strings["frm_Special_result_1_2_2_13"] = "A kuarp a day keeps the competition at bay!";
         this.strings["frm_Special_result_1_2_2_14"] = "Now you\'re cooking!";
         this.strings["frm_Special_result_1_2_2_15"] = "Full speed ahead!";
         this.strings["frm_Special_result_2_1"] = "<p align=\'center\'><font size=\'+5\'><b>Grand Sage</b></font></p>\nThe Grand Sages tell you to give to others before asking for yourself.";
         this.strings["frm_Special_result_2_2"] = "<p align=\'center\'><font size=\'+5\'><b>Grand Sage</b></font></p>\nThe Grand Sages tell you to examine your own actions before asking others to act.";
         this.strings["frm_Special_result_2_3"] = "<p align=\'center\'><font size=\'+5\'><b>Grand Sage</b></font></p>\nThe Grand Sages tell you that the pursuit of money drains the soul and obscures the path to true fulfillment.";
         this.strings["frm_Special_result_2_4"] = "<p align=\'center\'><font size=\'+5\'><b>Grand Sage</b></font></p>\nThe Grand Sages tell you to look to your neighbor\'s needs before thinking of your own.";
         this.strings["frm_Special_result_2_5"] = "<p align=\'center\'><font size=\'+5\'><b>Grand Sage</b></font></p>\nThe Grand Sages tell you that the way to solve your problems is to first understand yourself before asking for help from others.";
         this.strings["frm_Special_result_2_6"] = "<p align=\'center\'><font size=\'+5\'><b>Grand Sage</b></font></p>\nThe Grand Sages say that hardship makes the soul grow faster.  They cast an <font color=\'#F05555\'><b>evil curse</b></font> on you in the hopes that overcoming this obstacle will help you to become a stronger person.";
         this.strings["frm_Special_result_2_7"] = "<p align=\'center\'><font size=\'+5\'><b>Grand Sage</b></font></p>\nThe Grand Sages <font color=\'#77D7FF\'><b>bless</b></font> you and your crew and urge you to give as much to others as you expect for yourself.";
         this.strings["frm_Special_result_2_8"] = "<p align=\'center\'><font size=\'+5\'><b>Grand Sage</b></font></p>\nThe Grand Sages <font color=\'#77D7FF\'><b>bless</b></font> your business and predict that your luck will soon take a turn for the better.";
         this.strings["frm_Special_result_2_9"] = "<p align=\'center\'><font size=\'+5\'><b>Grand Sage</b></font></p>\nThe Grand Sages grant you a <font color=\'#77D7FF\'><b>small blessing</b></font> and urge you to take care of those who depend upon you.";
         this.strings["frm_Special_result_2_10"] = "<p align=\'center\'><font size=\'+5\'><b>Grand Sage</b></font></p>\nThe Grand Sages grant you their <font color=\'#77D7FF\'><b>highest blessing</b></font> and urge you to make good use of your fortunes.";
         this.strings["frm_Special_result_2_11"] = "<p align=\'center\'><font size=\'+5\'><b>Grand Sage</b></font></p>\nThe Grand Sages say a <font color=\'#77D7FF\'><b>special prayer</b></font> for you and your crew and urge you to look at life as a process, not a goal.";
         this.strings["frm_Special_result_2_12"] = "<p align=\'center\'><font size=\'+5\'><b>Grand Sage</b></font></p>\nOne of the apprentice monks informs you that the Grand Sages are in meditation right now.  He asks you to come back next week.";
         this.strings["frm_Special_result_2_13"] = "<p align=\'center\'><font size=\'+5\'><b>Grand Sage</b></font></p>\nThe Grand Sages advise you not to depend upon others for your happiness.";
         this.strings["frm_Special_result_2_14"] = "<p align=\'center\'><font size=\'+5\'><b>Grand Sage</b></font></p>\nThe Grand Sages remind you that the pursuit of material wealth will only lead to discontent.";
         this.strings["frm_Special_result_2_15"] = "<p align=\'center\'><font size=\'+5\'><b>Grand Sage</b></font></p>\nThe Grand Sages remind you that the path to enlightenment leads inward.";
         this.strings["frm_Special_result_2_16"] = "<p align=\'center\'><font size=\'+5\'><b>Grand Sage</b></font></p>\nThe Grand Sages instruct you to avoid becoming overly emotional and embrace the transitory nature of existence.";
         this.strings["frm_Special_result_2_17"] = "<p align=\'center\'><font size=\'+5\'><b>Grand Sage</b></font></p>\nThe Grand Sages instruct you to submit to reality instead of struggling to alter it.";
         this.strings["frm_Special_result_2_18"] = "<p align=\'center\'><font size=\'+5\'><b>Grand Sage</b></font></p>\nThe Grand Sages harshly criticize you for failing to give back to the world what you have taken, and they <font color=\'#F05555\'><b>curse</b></font the ground you walk on.";
         this.strings["frm_Special_result_2_19"] = "<p align=\'center\'><font size=\'+5\'><b>Grand Sage</b></font></p>\nThe Grand Sages reluctantly grant you their <font color=\'#77D7FF\'><b>blessing</b></font>, asking you to work as hard to improve your spirit as you do to improve your business.";
         this.strings["frm_Special_result_2_20"] = "<p align=\'center\'><font size=\'+5\'><b>Grand Sage</b></font></p>\nThe Grand Sages congratulate you on your devotion and effort towards improving your spiritual side.  You still have a long way to go, but they have given you their <font color=\'#77D7FF\'><b>highest blessing</b></font>.";
         this.strings["frm_Special_result_2_21"] = "<p align=\'center\'><font size=\'+5\'><b>Grand Sage</b></font></p>\nThe Grand Sages grant you a <font color=\'#77D7FF\'><b>small blessing</b></font>, but warn you to keep to the path you know in your heart to be true.";
         this.strings["frm_Special_result_2_22"] = "<p align=\'center\'><font size=\'+5\'><b>Grand Sage</b></font></p>\nThe Grand Sages praise you for your efforts to make your actions conform to your conscience.  Then they sprinkle Mutta juice on your arms and grant you the <font color=\'#77D7FF\'><b>highest blessing</b></font> possible.";
         this.strings["frm_Special_result_2_23"] = "<p align=\'center\'><font size=\'+5\'><b>Grand Sage</b></font></p>\nThe Grand Sages say a <font color=\'#77D7FF\'><b>short prayer</b></font> for you, then forgive you for your transgressions and pettiness.";
         this.strings["frm_Special_result_2_24"] = "<p align=\'center\'><font size=\'+5\'><b>Grand Sage</b></font></p>\nYou quickly learn from the villagers that the Grand Sages are busy bathing the Quaso Mutta and refuse to see anyone this week.";
         this.strings["frm_Special_result_3_1"] = "<p align=\'center\'><font size=\'+5\'><b>Traders\' Union Official</b></font></p>\nThe Traders\' Union urges you to improve your business practices rather than relying on them to bail you out.";
         this.strings["frm_Special_result_3_2_1"] = "<p align=\'center\'><font size=\'+5\'><b>Traders\' Union Official</b></font></p>\nThe Traders\' Union says they will work on reducing your loan interest rates, but they can\'t promise anything.";
         this.strings["frm_Special_result_3_2_2"] = "<p align=\'center\'><font size=\'+5\'><b>Traders\' Union Official</b></font></p>\nThe Traders\' Union says they will work on raising the interest rate on your savings account, but they can\'t promise anything.";
         this.strings["frm_Special_result_3_3"] = "<p align=\'center\'><font size=\'+5\'><b>Traders\' Union Official</b></font></p>\nThe Traders\' Union asks you to be patient and keep up the hard work.";
         this.strings["frm_Special_result_3_4"] = "<p align=\'center\'><font size=\'+5\'><b>Traders\' Union Official</b></font></p>\nThe Traders\' Union informs you that their budget is tight and they cannot do anything at the present time.";
         this.strings["frm_Special_result_3_5"] = "<p align=\'center\'><font size=\'+5\'><b>Traders\' Union Official</b></font></p>\nThe Traders\' Union says it would be unfair to change your rates while not doing the same for their other members.";
         this.strings["frm_Special_result_3_6_1"] = "<p align=\'center\'><font size=\'+5\'><b>Traders\' Union Official</b></font></p>\nThe Traders\' Union says that first you must prove your company is sound before they can address any of your concerns.";
         this.strings["frm_Special_result_3_6_2"] = "<p align=\'center\'><font size=\'+5\'><b>Traders\' Union Official</b></font></p>\nThe Traders\' Union says they will work on raising the interest rate on your savings account.";
         this.strings["frm_Special_result_3_7"] = "<p align=\'center\'><font size=\'+5\'><b>Traders\' Union Official</b></font></p>\nThe Traders\' Union generously offers to <font color=\'#77D7FF\'><b>increase</b></font> your <font color=\'#77D7FF\'><b>credit limit</b></font> by 50,000 kubars.";
         this.strings["frm_Special_result_3_8_1_1"] = "<p align=\'center\'><font size=\'+5\'><b>Traders\' Union Official</b></font></p>\nThe Traders\' Union offers to <font color=\'#77D7FF\'><b>lower</b></font> the interest rate on your loan from ";
         this.strings["frm_Special_result_3_8_1_2"] = "% to ";
         this.strings["frm_Special_result_3_8_1_3"] = "%.";
         this.strings["frm_Special_result_3_8_2_1"] = "<p align=\'center\'><font size=\'+5\'><b>Traders\' Union Official</b></font></p>\nThe Traders\' Union regrets to inform you that they must <font color=\'#F05555\'><b>raise</b></font> the interest rate on your loan from ";
         this.strings["frm_Special_result_3_8_2_2"] = "% to ";
         this.strings["frm_Special_result_3_8_2_3"] = "%.";
         this.strings["frm_Special_result_3_9_1_1"] = "<p align=\'center\'><font size=\'+5\'><b>Traders\' Union Official</b></font></p>\nThe Traders\' Union offers to <font color=\'#77D7FF\'><b>increase</b></font> the interest rate on your savings account from ";
         this.strings["frm_Special_result_3_9_1_2"] = "% to ";
         this.strings["frm_Special_result_3_9_1_3"] = "%.";
         this.strings["frm_Special_result_3_9_2_1"] = "<p align=\'center\'><font size=\'+5\'><b>Traders\' Union Official</b></font></p>\nThe Traders\' Union regrets to inform you that they must <font color=\'#F05555\'><b>lower</b></font> the interest rate on your savings account from ";
         this.strings["frm_Special_result_3_9_2_2"] = "% to ";
         this.strings["frm_Special_result_3_9_2_3"] = "%.";
         this.strings["frm_Special_result_3_10_1_1"] = "<p align=\'center\'><font size=\'+5\'><b>Traders\' Union Official</b></font></p>\nThe Traders\' Union generously offers to <font color=\'#77D7FF\'><b>forgive</b></font> one third of your debt. That means you now owe the Traders\' Union only ";
         this.strings["frm_Special_result_3_10_1_2"] = " kubars instead of ";
         this.strings["frm_Special_result_3_10_1_3"] = " kubars.";
         this.strings["frm_Special_result_3_10_2_1"] = "<p align=\'center\'><font size=\'+5\'><b>Traders\' Union Official</b></font></p>\nDue to inflationary pressures, the Traders\' Union is willing to <font color=\'#77D7FF\'><b>increase</b></font> the interest rate on your savings account from ";
         this.strings["frm_Special_result_3_10_2_2"] = "% to ";
         this.strings["frm_Special_result_3_10_2_3"] = "%.";
         this.strings["frm_Special_result_3_10_3_1"] = "<p align=\'center\'><font size=\'+5\'><b>Traders\' Union Official</b></font></p>\nDue to a cut in interest rates at the Imperial Treasury, the Traders\' Union regrets to inform you that they must <font color=\'#F05555\'><b>lower</b></font> the interest rate on your savings account from ";
         this.strings["frm_Special_result_3_10_3_2"] = "% to ";
         this.strings["frm_Special_result_3_10_3_3"] = "%.";
         this.strings["frm_Special_result_3_11_1_1"] = "<p align=\'center\'><font size=\'+5\'><b>Traders\' Union Official</b></font></p>\nYour plea for assistance backfires!  Instead of raising the interest rate on your savings account, the Traders\' Union <font color=\'#F05555\'><b>lowers</b></font> it from ";
         this.strings["frm_Special_result_3_11_1_2"] = "% to ";
         this.strings["frm_Special_result_3_11_1_3"] = "%.";
         this.strings["frm_Special_result_3_11_2_1"] = "<p align=\'center\'><font size=\'+5\'><b>Traders\' Union Official</b></font></p>\nYour plea for assistance backfires!  Instead of lowering your rates, the Traders\' Union <font color=\'#F05555\'><b>raises</b></font> the interest on your loan from ";
         this.strings["frm_Special_result_3_11_2_2"] = "% to ";
         this.strings["frm_Special_result_3_11_2_3"] = "%.";
         this.strings["frm_Special_result_3_12"] = "<p align=\'center\'><font size=\'+5\'><b>Traders\' Union Official</b></font></p>\nThe Traders\' Union regrets to inform you that they are unable to provide financial assistance at this time.";
         this.strings["frm_Special_result_3_13"] = "<p align=\'center\'><font size=\'+5\'><b>Traders\' Union Official</b></font></p>\nThe Traders\' Union urges you to increase your profit margins and avoid borrowing money unless you absolutely have to.";
         this.strings["frm_Special_result_3_14_1"] = "<p align=\'center\'><font size=\'+5\'><b>Traders\' Union Official</b></font></p>\nThe Traders\' Union Official says he cannot possibly lower your loan interest rate right now because of government regulations.";
         this.strings["frm_Special_result_3_14_2"] = "<p align=\'center\'><font size=\'+5\'><b>Traders\' Union Official</b></font></p>\nThe Traders\' Union Official says he cannot possibly raise the interest rate on your savings account at this time because of an agreement with the Imperial Council.";
         this.strings["frm_Special_result_3_15"] = "<p align=\'center\'><font size=\'+5\'><b>Traders\' Union Official</b></font></p>\nThe Traders\' Union Official explains how the last time someone asked him for a favor, he got into big trouble.  This time he is being very careful before making any promises.";
         this.strings["frm_Special_result_3_16"] = "<p align=\'center\'><font size=\'+5\'><b>Traders\' Union Official</b></font></p>\nThe Traders\' Union Official complains how last week his salary was cut.  He doesn\'t even know if the Traders\' Union will be in business much longer if they keep losing money at the current rate.";
         this.strings["frm_Special_result_3_17"] = "<p align=\'center\'><font size=\'+5\'><b>Traders\' Union Official</b></font></p>\nThe Traders\' Union Official doesn\'t bother to return your phone calls, and his assistant refuses to arrange any meeting while you are on Stye.";
         this.strings["frm_Special_result_3_18_1"] = "<p align=\'center\'><font size=\'+5\'><b>Traders\' Union Official</b></font></p>\nThe Traders\' Union Official says he has doubts about your company, and honestly doesn\'t feel it is a good idea to lend you any more money at this time.";
         this.strings["frm_Special_result_3_18_2"] = "<p align=\'center\'><font size=\'+5\'><b>Traders\' Union Official</b></font></p>\nThe Traders\' Union Official invites you into his office, then begins complaining for an hour about how you already have a higher interest rate on your savings account than he does.  He feels this is unfair and refuses to help you become even richer than you already are.";
         this.strings["frm_Special_result_3_19"] = "<p align=\'center\'><font size=\'+5\'><b>Traders\' Union Official</b></font></p>\nThe Traders\' Union Official <font color=\'#77D7FF\'><b>increases</b></font> your <font color=\'#77D7FF\'><b>credit limit</b></font> by 75,000 kubars.  However, he reminds you that he went out of his way and expects a favor in return.";
         this.strings["frm_Special_result_3_20_1_1"] = "<p align=\'center\'><font size=\'+5\'><b>Traders\' Union Official</b></font></p>\nThe Traders\' Union Official says he has done extensive research on your company, and from the data, it appears you are a good credit risk.  Under the Union\'s current policy, your <font color=\'#77D7FF\'><b>loan interest rate</b></font> will be <font color=\'#77D7FF\'><b>reduced</b></font> from ";
         this.strings["frm_Special_result_3_20_1_2"] = "% to ";
         this.strings["frm_Special_result_3_20_1_3"] = "%.";
         this.strings["frm_Special_result_3_20_2_1"] = "<p align=\'center\'><font size=\'+5\'><b>Traders\' Union Official</b></font></p>\nThe Traders\' Union Official informs you that after reviewing your company\'s financial standing, it turns out you are a higher credit risk than they previously thought.  He regrets to inform you that the Union must <font color=\'#F05555\'><b>raise</b></font> the <font color=\'#F05555\'><b>interest rate</b></font> on your loan from ";
         this.strings["frm_Special_result_3_20_2_2"] = "% to ";
         this.strings["frm_Special_result_3_20_2_3"] = "%.";
         this.strings["frm_Special_result_3_21_1_1"] = "<p align=\'center\'><font size=\'+5\'><b>Traders\' Union Official</b></font></p>\nThe Traders\' Union Official implies that the Traders\' Union is short on money and would rather you put your money in the bank than in other investments, like the stock market.  Therefore, he is <font color=\'#77D7FF\'><b>increasing</b></font> the <font color=\'#77D7FF\'><b>interest rate</b></font> on your savings account from ";
         this.strings["frm_Special_result_3_21_1_2"] = "% to ";
         this.strings["frm_Special_result_3_21_1_3"] = "%.";
         this.strings["frm_Special_result_3_21_2_1"] = "<p align=\'center\'><font size=\'+5\'><b>Traders\' Union Official</b></font></p>\nThe Traders\' Union Official regrets to inform you that due to low inflation and other economic pressures, the bank is lowering interest rates on certain accounts.  As a result, the <font color=\'#F05555\'><b>interest rate</b></font> on your savings account will <font color=\'#F05555\'><b>decrease</b></font> from ";
         this.strings["frm_Special_result_3_21_2_2"] = "% to ";
         this.strings["frm_Special_result_3_21_2_3"] = "%.";
         this.strings["frm_Special_result_3_22_1_1"] = "<p align=\'center\'><font size=\'+5\'><b>Traders\' Union Official</b></font></p>\nThe Traders\' Union Official informs you that due to a new government subsidy program meant to stimulate the Kukubian economy, he is authorized to <font color=\'#77D7FF\'><b>forgive</b></font> one quarter of your debt.  That means you now owe the Traders\' Union only ";
         this.strings["frm_Special_result_3_22_1_2"] = " kubars instead of ";
         this.strings["frm_Special_result_3_22_1_3"] = " kubars.";
         this.strings["frm_Special_result_3_22_2_1"] = "<p align=\'center\'><font size=\'+5\'><b>Traders\' Union Official</b></font></p>\nIn an effort to boost the bank\'s working capital, the Traders\' Union Official informs you that he is <font color=\'#77D7FF\'><b>increasing</b></font> the <font color=\'#77D7FF\'><b>interest rate</b></font> on your savings account from ";
         this.strings["frm_Special_result_3_22_2_2"] = "% to ";
         this.strings["frm_Special_result_3_22_2_3"] = "%.  He hopes this will encourage you to deposit more money in the bank, rather than shifting it to other investments.";
         this.strings["frm_Special_result_3_22_3_1"] = "<p align=\'center\'><font size=\'+5\'><b>Traders\' Union Official</b></font></p>\nDue to a severe setback in the economy and declining inflationary pressures, the Traders\' Union Official informs you that the bank must <font color=\'#F05555\'><b>lower</b></font> the <font color=\'#F05555\'><b>interest rate</b></font> on your savings account from ";
         this.strings["frm_Special_result_3_22_3_2"] = "% to ";
         this.strings["frm_Special_result_3_22_3_3"] = "%.";
         this.strings["frm_Special_result_3_23_1_1"] = "<p align=\'center\'><font size=\'+5\'><b>Traders\' Union Official</b></font></p>\nYour plea for assistance annoys the Traders\' Union Official, and he becomes upset.  Feeling that you are greedy and unappreciative, he single-handedly authorizes the bank to <font color=\'#F05555\'><b>lower</b></font> the <font color=\'#F05555\'><b>interest rate</b></font> on your savings account from ";
         this.strings["frm_Special_result_3_23_1_2"] = "% to ";
         this.strings["frm_Special_result_3_23_1_3"] = "%.";
         this.strings["frm_Special_result_3_23_2_1"] = "<p align=\'center\'><font size=\'+5\'><b>Traders\' Union Official</b></font></p>\nYour plea for assistance prompts the Traders\' Union Official to audit your company.  What he finds is that you are not as good an investment as previously thought.  Therefore, instead of lowering your loan rate, the Traders\' Union <font color=\'#F05555\'><b>raises</b></font> the <font color=\'#F05555\'><b>interest rate</b></font> on your loan from ";
         this.strings["frm_Special_result_3_23_2_2"] = "% to ";
         this.strings["frm_Special_result_3_23_2_3"] = "%.";
         this.strings["frm_Special_result_3_24"] = "<p align=\'center\'><font size=\'+5\'><b>Traders\' Union Official</b></font></p>\nWhen you show up at the Traders\' Union Headquarters, there is a huge line.  In fact, it seems like everyone is asking them for something.  After waiting six hours with no results, you become frustrated and give up.";
         this.strings["frm_Special_result_4_1"] = "<p align=\'center\'><font size=\'+5\'><b>Peelia Veelia, Queen of Loro</b></font></p>\nYour crew has a wonderful time surfing the Vorpal Pools, stuffing themselves with a Lorinian grapes and WaWa pies, and dancing the night away.";
         this.strings["frm_Special_result_4_2"] = "<p align=\'center\'><font size=\'+5\'><b>Peelia Veelia, Queen of Loro</b></font></p>\nWhen your crew returns to the ship, they are so exhausted after a night of partying that they can barely see straight.";
         this.strings["frm_Special_result_4_3"] = "<p align=\'center\'><font size=\'+5\'><b>Peelia Veelia, Queen of Loro</b></font></p>\nYour crew thanks you for the much-needed vacation and promises to work harder than ever.";
         this.strings["frm_Special_result_4_4"] = "<p align=\'center\'><font size=\'+5\'><b>Peelia Veelia, Queen of Loro</b></font></p>\nYour crew brings you a giant Bigaloo Pie as a gift to show their gratitude for letting them have a few days off.";
         this.strings["frm_Special_result_4_5_1"] = "<p align=\'center\'><font size=\'+5\'><b>Peelia Veelia, Queen of Loro</b></font></p>\nYour crew gets into a fight with a rowdy bunch of Lepro Ulps and winds up in jail.  It costs you <font color=\'#F05555\'><b>";
         this.strings["frm_Special_result_4_5_2"] = " kubars</b></font> to bail them out.  What a vacation!";
         this.strings["frm_Special_result_4_6_1_1"] = "<p align=\'center\'><font size=\'+5\'><b>Peelia Veelia, Queen of Loro</b></font></p>\nYour crew has such a good time on the planet that when they return to the ship, they offer to <font color=\'#77D7FF\'><b>reduce</b></font> their <font color=\'#77D7FF\'><b>salary</b></font> from ";
         this.strings["frm_Special_result_4_6_1_2"] = " to ";
         this.strings["frm_Special_result_4_6_1_3"] = " kubars per person.";
         this.strings["frm_Special_result_4_6_2"] = "<p align=\'center\'><font size=\'+5\'><b>Peelia Veelia, Queen of Loro</b></font></p>\nYour crew brings you an inflatable baby carriage as a gift to show their gratitude for letting them have a few days off.";
         this.strings["frm_Special_result_4_7_1_1"] = "<p align=\'center\'><font size=\'+5\'><b>Peelia Veelia, Queen of Loro</b></font></p>\nYour crew is so happy with their vacation that they offer to <font color=\'#77D7FF\'><b>forget</b></font> about any money you owe them.\n\nThat means you no longer have to pay <font color=\'#77D7FF\'><b>";
         this.strings["frm_Special_result_4_7_1_2"] = " kubars</b></font> in back wages.";
         this.strings["frm_Special_result_4_7_2"] = "<p align=\'center\'><font size=\'+5\'><b>Peelia Veelia, Queen of Loro</b></font></p>\nYour crew has a marvelous time seeing the famous Loro Opera, going to all the museums, and visiting the tomb of the great Bass Nicolson.";
         this.strings["frm_Special_result_4_8"] = "<p align=\'center\'><font size=\'+5\'><b>Peelia Veelia, Queen of Loro</b></font></p>\nYour crew enjoys their short vacation and returns to the ship refreshed and ready to work.";
         this.strings["frm_Special_result_4_9"] = "<p align=\'center\'><font size=\'+5\'><b>Peelia Veelia, Queen of Loro</b></font></p>\nLoro is bliss.  Your pilot falls in love with one of the local girls, your navigator goes deep sea phonging, and the rest of your crew spend all their time paying court to Peelia Veelia.";
         this.strings["frm_Special_result_4_10"] = "<p align=\'center\'><font size=\'+5\'><b>Peelia Veelia, Queen of Loro</b></font></p>\nWhen your crew returns to the ship, they can barely keep their eyes open.  They stayed up for three nights in a row talking about the metaphysics of astral projection with a tent full of Mamo Wuzzies, and now they are too pooped to pop.";
         this.strings["frm_Special_result_4_11"] = "<p align=\'center\'><font size=\'+5\'><b>Peelia Veelia, Queen of Loro</b></font></p>\nAfter a few days on Loro, your crew seems 10 years younger.  They become happier, healthier and more alert.  The clean air and stimulating conversations appear to have energized them like nothing else could have.";
         this.strings["frm_Special_result_4_12"] = "<p align=\'center\'><font size=\'+5\'><b>Peelia Veelia, Queen of Loro</b></font></p>\nYour crew has such a marvelous time on Loro that they can\'t stop thanking you.  They even try to make you promise to come back within a few weeks, but you manage to avoid this tricky situation.";
         this.strings["frm_Special_result_4_13_1"] = "<p align=\'center\'><font size=\'+5\'><b>Peelia Veelia, Queen of Loro</b></font></p>\nTwo of your crew members get carried away while having fun at a beach side resort and manage to sink a 30-foot sun-bathing raft.  You can\'t imagine how they did this, but it ends up costing you <font color=\'#F05555\'><b>";
         this.strings["frm_Special_result_4_13_2"] = " kubars</b></font>.";
         this.strings["frm_Special_result_4_14_1_1"] = "<p align=\'center\'><font size=\'+5\'><b>Peelia Veelia, Queen of Loro</b></font></p>\nAfter a few days on Loro, your crew feels so relaxed that you manage to talk them into <font color=\'#77D7FF\'><b>reducing</b></font> their <font color=\'#77D7FF\'><b>salary</b></font> from ";
         this.strings["frm_Special_result_4_14_1_2"] = " to ";
         this.strings["frm_Special_result_4_14_1_3"] = " kubars per person.\n\nOf course, as part of the bargain, you promise to return to Loro as often as possible.";
         this.strings["frm_Special_result_4_14_2"] = "<p align=\'center\'><font size=\'+5\'><b>Peelia Veelia, Queen of Loro</b></font></p>\nYour crew is so grateful at having this unexpected vacation that they all chip-in to <font color=\'#77D7FF\'><b>fill up</b></font> the ship\'s <font color=\'#77D7FF\'><b>fuel tank</b></font>.";
         this.strings["frm_Special_result_4_15_1_1"] = "<p align=\'center\'><font size=\'+5\'><b>Peelia Veelia, Queen of Loro</b></font></p>\nPeelia Veelia and the Mamo Wuzzies treat your crew like royalty.  In fact, your crew ends up having so much fun that they don\'t want to leave.  When you come to bring them back to the ship, they volunteer to <font color=\'#77D7FF\'><b>forget</b></font> all about the <font color=\'#77D7FF\'><b>";
         this.strings["frm_Special_result_4_15_1_2"] = " kubars</b></font> you owe them if you allow them to stay just one more day.\n\nHow can you refuse?";
         this.strings["frm_Special_result_4_15_2"] = "<p align=\'center\'><font size=\'+5\'><b>Peelia Veelia, Queen of Loro</b></font></p>\nYour crew has a splendid time on Loro painting their skin yellow, sipping the sacred nectar of the Halua Blossoms, and grooming the wild Mantapillars.";
         this.strings["frm_Special_result_4_16"] = "<p align=\'center\'><font size=\'+5\'><b>Peelia Veelia, Queen of Loro</b></font></p>\nYour crew can\'t get enough of Loro and the Mamo Wuzzies, and you literally have to call the local police and have them dragged back to the ship.";
         this.strings["frm_Special_result_5_1"] = "<p align=\'center\'><font size=\'+5\'><b>Mr. Zinn</b></font></p>\nMr. Zinn apologizes for being unable to lower his rates or extend you any more credit at this time.";
         this.strings["frm_Special_result_5_2"] = "<p align=\'center\'><font size=\'+5\'><b>Mr. Zinn</b></font></p>\nMr. Zinn tells you that he is all out of money.  His business is barely surviving, and he cannot lower his rates.";
         this.strings["frm_Special_result_5_3"] = "<p align=\'center\'><font size=\'+5\'><b>Mr. Zinn</b></font></p>\nMr. Zinn says that times are tough for everyone, and you have to do your best with the current rates.";
         this.strings["frm_Special_result_5_4"] = "<p align=\'center\'><font size=\'+5\'><b>Mr. Zinn</b></font></p>\nMr. Zinn says he\'s afraid his own company is about to go bankrupt, so please don\'t ask him for any more favors.";
         this.strings["frm_Special_result_5_5"] = "<p align=\'center\'><font size=\'+5\'><b>Mr. Zinn</b></font></p>\nMr. Zinn says he can\'t lower his rates right now, but maybe in a few weeks he can help you.  Please come back again later.";
         this.strings["frm_Special_result_5_6"] = "<p align=\'center\'><font size=\'+5\'><b>Mr. Zinn</b></font></p>\nMr. Zinn says the situation is out of his control.  His shareholders have set the rate, and he can do nothing about it.";
         this.strings["frm_Special_result_5_7_1_1"] = "<p align=\'center\'><font size=\'+5\'><b>Mr. Zinn</b></font></p>\nMr. Zinn <font color=\'#77D7FF\'><b>lowers</b></font> your <font color=\'#77D7FF\'><b>interest rate</b></font> from ";
         this.strings["frm_Special_result_5_7_1_2"] = "% to ";
         this.strings["frm_Special_result_5_7_1_3"] = "%.";
         this.strings["frm_Special_result_5_7_2"] = "<p align=\'center\'><font size=\'+5\'><b>Mr. Zinn</b></font></p>\nMr. Zinn becomes angry.  He says your rate is already 1%, the lowest in the system, and you still pester him for more.  He decides to <font color=\'#F05555\'><b>raise</b></font> your <font color=\'#F05555\'><b>rate</b></font> to 2%.";
         this.strings["frm_Special_result_5_8"] = "<p align=\'center\'><font size=\'+5\'><b>Mr. Zinn</b></font></p>\nMr. Zinn generously <font color=\'#77D7FF\'><b>extends</b></font> your <font color=\'#77D7FF\'><b>credit limit</b></font> by 50,000 kubars.";
         this.strings["frm_Special_result_5_9_1_1"] = "<p align=\'center\'><font size=\'+5\'><b>Mr. Zinn</b></font></p>\nMr. Zinn feels sorry for you and offers to <font color=\'#77D7FF\'><b>forgive 1/3 of your debt</b></font>.\n\nThat means your debt shrinks from ";
         this.strings["frm_Special_result_5_9_1_2"] = " kubars to ";
         this.strings["frm_Special_result_5_9_1_3"] = " kubars.";
         this.strings["frm_Special_result_5_9_2"] = "<p align=\'center\'><font size=\'+5\'><b>Mr. Zinn</b></font></p>\nMr. Zinn invites you to share dinner with him.";
         this.strings["frm_Special_result_5_10"] = "<p align=\'center\'><font size=\'+5\'><b>Mr. Zinn</b></font></p>\nAs a true friend, Mr. Zinn <font color=\'#77D7FF\'><b>loans</b></font> you 50,000 more kubars and <font color=\'#77D7FF\'><b>extends</b></font> your <font color=\'#77D7FF\'><b>credit limit</b></font> by 75,000 kubars.\n\nIf you don\'t need the money, just pay him back before you leave Zile, and you won\'t be charged any interest.";
         this.strings["frm_Special_result_5_11"] = "<p align=\'center\'><font size=\'+5\'><b>Mr. Zinn</b></font></p>\nThe butler informs you that Mr. Zinn is away on business and should return sometime soon.";
         this.strings["frm_Special_result_5_12"] = "<p align=\'center\'><font size=\'+5\'><b>Mr. Zinn</b></font></p>\nMr. Zinn has come down with a recurring case of Nefratic Fever and cancels his meeting with you.";
         this.strings["frm_Special_result_5_13"] = "<p align=\'center\'><font size=\'+5\'><b>Mr. Zinn</b></font></p>\nMr. Zinn invites you into his home and asks you what you think of him getting a nose transplant operation.  How would he look?  Do you think it\'s beautiful?  Is it worth 100,000 kubars?";
         this.strings["frm_Special_result_5_14"] = "<p align=\'center\'><font size=\'+5\'><b>Mr. Zinn</b></font></p>\nMr. Zinn knows how difficult it must be for you, but he cannot help at this time.  After all, he must maintain his luxurious lifestyle, and how can he possibly do that if his clients are charity cases.";
         this.strings["frm_Special_result_5_15"] = "<p align=\'center\'><font size=\'+5\'><b>Mr. Zinn</b></font></p>\nMr. Zinn encourages you to borrow more from the Traders\' Union and stop pestering him for help.";
         this.strings["frm_Special_result_5_16"] = "<p align=\'center\'><font size=\'+5\'><b>Mr. Zinn</b></font></p>\nMr. Zinn explains how he\'s involved in several major business deals right now and cannot loan you any cash.  He may even need to borrow money from the Traders\' Union to cover his debts.";
         this.strings["frm_Special_result_5_17"] = "<p align=\'center\'><font size=\'+5\'><b>Mr. Zinn</b></font></p>\nMr. Zinn sits you down and ask you to give him half a million kubars.  Then begins to laugh!  He\'s just teasing you.  But seriously, he cannot afford to help you at this time.  If you come back in a few weeks, things may be different...";
         this.strings["frm_Special_result_5_18_1_1"] = "<p align=\'center\'><font size=\'+5\'><b>Mr. Zinn</b></font></p>\nMr. Zinn says you\'ve been a longtime family friend and a good customer.  Because of this, he is willing to <font color=\'#77D7FF\'><b>lower</b></font> your <font color=\'#77D7FF\'><b>interest rate</b></font> from ";
         this.strings["frm_Special_result_5_18_1_2"] = "% to ";
         this.strings["frm_Special_result_5_18_1_3"] = "%.";
         this.strings["frm_Special_result_5_18_2"] = "<p align=\'center\'><font size=\'+5\'><b>Mr. Zinn</b></font></p>\nMr. Zinn opens the door a crack but won\'t let you inside.  In a nervous voice, he mutters that your rate is already too low, and he has no choice but to <font color=\'#F05555\'><b>raise</b></font> it.  From now on you will pay 2% interest per week.\n\nThen he shuts the door and double locks it.";
         this.strings["frm_Special_result_5_19"] = "<p align=\'center\'><font size=\'+5\'><b>Mr. Zinn</b></font></p>\nMr. Zinn is in a jolly mood.  One of his daughters just gave birth.  Today, he will <font color=\'#77D7FF\'><b>raise</b></font> your <font color=\'#77D7FF\'><b>credit limit</b></font> by 75,000 kubars.";
         this.strings["frm_Special_result_5_20_1_1"] = "<p align=\'center\'><font size=\'+5\'><b>Mr. Zinn</b></font></p>\nMr. Zinn sits you down.  He says he is worried about your company and fears you may fall far behind the competition unless you take action right away.  To help you out, he is willing to <font color=\'#77D7FF\'><b>forgive one quarter of your debt</b></font>.\n\nThat means your debt will shrink from ";
         this.strings["frm_Special_result_5_20_1_2"] = " kubars to ";
         this.strings["frm_Special_result_5_20_1_3"] = " kubars.";
         this.strings["frm_Special_result_5_20_2"] = "<p align=\'center\'><font size=\'+5\'><b>Mr. Zinn</b></font></p>\nMr. Zinn introduces you to his family.  There is Mrs. Zinn and his 12 daughters.  He is a proud father, and he encourages you not to let your business get in the way of having a family.  He believes it\'s the best part of his life.";
         this.strings["frm_Special_result_5_21"] = "<p align=\'center\'><font size=\'+5\'><b>Mr. Zinn</b></font></p>\nMr. Zinn realizes how tough the competition is and wants to help.  This one time he is willing to <font color=\'#77D7FF\'><b>lend</b></font> you 40,000 more kubars and <font color=\'#77D7FF\'><b>extend</b></font> your <font color=\'#77D7FF\'><b>credit limit</b></font> by 60,000 kubars.\n\nIf you don\'t need the money, just pay him back before you leave Zile, and you won\'t be charged any interest.";
         this.strings["frm_Special_result_5_22"] = "<p align=\'center\'><font size=\'+5\'><b>Mr. Zinn</b></font></p>\nMrs. Zinn comes to the door and apologizes.  She explains that her husband is tied up in meetings all this week and cannot talk with you.  However, please drop by the next time you visit Zile.";
         this.strings["frm_Special_result_6_1"] = "<p align=\'center\'><font size=\'+5\'><b>Your Insurance Agent</b></font></p>\nThe insurance company says they are working on offering lower rates to everyone.";
         this.strings["frm_Special_result_6_2"] = "<p align=\'center\'><font size=\'+5\'><b>Your Insurance Agent</b></font></p>\nThe insurance company informs you that their rates are absolutely the lowest in all the galaxy.";
         this.strings["frm_Special_result_6_3"] = "<p align=\'center\'><font size=\'+5\'><b>Your Insurance Agent</b></font></p>\nThe insurance company says they\'ll take your request into consideration the next time they adjust the rates.";
         this.strings["frm_Special_result_6_4"] = "<p align=\'center\'><font size=\'+5\'><b>Your Insurance Agent</b></font></p>\nThe insurance company keeps you waiting two hours, and then tells you the person you need to talk to is not in this week.";
         this.strings["frm_Special_result_6_5"] = "<p align=\'center\'><font size=\'+5\'><b>Your Insurance Agent</b></font></p>\nThe insurance company tells you to come back next week when things are not so busy.";
         this.strings["frm_Special_result_6_6"] = "<p align=\'center\'><font size=\'+5\'><b>Your Insurance Agent</b></font></p>\nThe insurance company shows you your statistical data and says they cannot lower your rates any further.";
         this.strings["frm_Special_result_6_7"] = "<p align=\'center\'><font size=\'+5\'><b>Your Insurance Agent</b></font></p>\nThe insurance company says they\'ll do their best to meet your needs and keep you satisfied.  After all, the customer comes first.";
         this.strings["frm_Special_result_6_8_1_1"] = "<p align=\'center\'><font size=\'+5\'><b>Your Insurance Agent</b></font></p>\nThe insurance company reviews your records and offers to <font color=\'#77D7FF\'><b>lower</b></font> your <font color=\'#77D7FF\'><b>rates</b></font> an average of ";
         this.strings["frm_Special_result_6_8_1_2"] = "%.";
         this.strings["frm_Special_result_6_8_2_1"] = "<p align=\'center\'><font size=\'+5\'><b>Your Insurance Agent</b></font></p>\nThe insurance company informs you that they are short on capital and must <font color=\'#F05555\'><b>raise</b></font> your <font color=\'#F05555\'><b>rates</b></font> an average of ";
         this.strings["frm_Special_result_6_8_2_2"] = "%.";
         this.strings["frm_Special_result_6_9_1"] = "<p align=\'center\'><font size=\'+5\'><b>Your Insurance Agent</b></font></p>\nThe insurance company reviews your records and informs you that your rates are in fact too low and must be <font color=\'#F05555\'><b>raised</b></font> an average of ";
         this.strings["frm_Special_result_6_9_2"] = "%.";
         this.strings["frm_Special_result_6_10"] = "<p align=\'center\'><font size=\'+5\'><b>Your Insurance Agent</b></font></p>\nThe insurance company informs you that their premiums are based on statistical data and cannot be altered unless your accident records show a change.";
         this.strings["frm_Special_result_6_11"] = "<p align=\'center\'><font size=\'+5\'><b>Your Insurance Agent</b></font></p>\nThe insurance company says they are pulling out of several markets because of new government regulations, and this prevents them from lowering any of their existing premiums.";
         this.strings["frm_Special_result_6_12"] = "<p align=\'center\'><font size=\'+5\'><b>Your Insurance Agent</b></font></p>\nYour Insurance Agent informs you that they are currently in the red and do not expect to make a profit in the foreseeable future.  Therefore, they cannot lower anybody\'s premiums for some time.";
         this.strings["frm_Special_result_6_13"] = "<p align=\'center\'><font size=\'+5\'><b>Your Insurance Agent</b></font></p>\nThe insurance company says they are already giving you a rate reduction, considering your poor accident record.  Any further reductions would be impossible.";
         this.strings["frm_Special_result_6_14"] = "<p align=\'center\'><font size=\'+5\'><b>Your Insurance Agent</b></font></p>\nThe insurance company politely informs you that they have a monopoly on insurance sales in the Kukubian system, so complaining about your high rates will get you nowhere.";
         this.strings["frm_Special_result_6_15_1"] = "<p align=\'center\'><font size=\'+5\'><b>Your Insurance Agent</b></font></p>\nYour Insurance Agent explains to you that he has found a grave mistake.  For the past few months, Voyager\'s Insurance has been under-charging you.  In fact, you owe them <font color=\'#F05555\'><b>";
         this.strings["frm_Special_result_6_15_2"] = " kubars</b></font>.";
         this.strings["frm_Special_result_6_16"] = "<p align=\'center\'><font size=\'+5\'><b>Your Insurance Agent</b></font></p>\nYour insurance company representative rants and raves about possible pending government interference.  He won\'t stop talking about how the government is trying to break up Voyager\'s Insurance Company\'s monopoly on the Kukubian market.";
         this.strings["frm_Special_result_6_17"] = "<p align=\'center\'><font size=\'+5\'><b>Your Insurance Agent</b></font></p>\nThe insurance company explains how Voyager\'s Insurance Company is dedicated to quality service.  They always pay their claims, and you should be thankful to have an opportunity to be a member of the Voyager family.";
         this.strings["frm_Special_result_6_18_1_1"] = "<p align=\'center\'><font size=\'+5\'><b>Your Insurance Agent</b></font></p>\nYour Insurance Agent says he will <font color=\'#77D7FF\'><b>reduce</b></font> your <font color=\'#77D7FF\'><b>rates</b></font> by an average of ";
         this.strings["frm_Special_result_6_18_1_2"] = "%.\n\nHe explains how this will severely cut into his commissions and lifestyle, but he values you as a customer and is willing to sacrifice on your behalf.";
         this.strings["frm_Special_result_6_18_2_1"] = "<p align=\'center\'><font size=\'+5\'><b>Your Insurance Agent</b></font></p>\nYour Insurance Agent is not in a good mood.  In fact, he says that after reviewing your records, he has no choice but to <font color=\'#F05555\'><b>raise</b></font> your <font color=\'#F05555\'><b>rates</b></font> by an average of ";
         this.strings["frm_Special_result_6_18_2_2"] = "%.\n\nHe\'s sorry, but there is nothing he can do about this.";
         this.strings["frm_Special_result_6_19_1"] = "<p align=\'center\'><font size=\'+5\'><b>Your Insurance Agent</b></font></p>\nYour meeting with your Insurance Agent goes well.  He promises to lower you rates.  That is why you are surprised to receive a note in the mail the next day indicating that your <font color=\'#F05555\'><b>premiums</b></font> have been <font color=\'#F05555\'><b>raised</b></font> an average of ";
         this.strings["frm_Special_result_6_19_2"] = "%.\n\nSorry, but there is nothing you can do about this.";
         this.strings["frm_Special_result_6_20_1"] = "<p align=\'center\'><font size=\'+5\'><b>Your Insurance Agent</b></font></p>\nYour insurance agent reviews your records and informs you that there has been a grave mistake.  The Voyager\'s Insurance Company has been overcharging you for the past several months.\n\nTo your surprise, you are due a <font color=\'#77D7FF\'><b>refund</b></font> in the amount of <font color=\'#77D7FF\'><b>";
         this.strings["frm_Special_result_6_20_2"] = " kubars</b></font>!";
         this.strings["frm_Special_result_7_1"] = "<p align=\'center\'><font size=\'+5\'><b>Casino Dealer</b></font></p>\nUnfortunately, all the casinos are closed this week in compliance with Emperor Dred Nicolson\'s <font color=\'#F05555\'><b><i>\"Just Say No to Gambling\"</i></b></font> campaign.";
         this.strings["frm_Special_result_7_2"] = "<p align=\'center\'><font size=\'+5\'><b>Casino Dealer</b></font></p>\nIt is just your luck that the <font color=\'#F05555\'><b>casinos</b></font> on Tilo are <font color=\'#F05555\'><b>closed</b></font> for a local religious holiday.";
         this.strings["frm_Special_result_7_3"] = "<p align=\'center\'><font size=\'+5\'><b>Casino Dealer</b></font></p>\nThe Imperial Magistrate happens to be visiting Tilo this week, and he has ordered all the <font color=\'#F05555\'><b>casinos closed</b></font> for a complete audit.";
         this.strings["frm_Special_result_7_4"] = "<p align=\'center\'><font size=\'+5\'><b>Casino Dealer</b></font></p>\nA major earthquake shook the planet yesterday, and all the <font color=\'#F05555\'><b>casinos</b></font> have <font color=\'#F05555\'><b>closed</b></font> for the remainder of the week.";
         this.strings["frm_Special_result_7_5"] = "<p align=\'center\'><font size=\'+5\'><b>Casino Dealer</b></font></p>\nThe night you arrived on Tilo, a band of pirates sacked and pillaged several of the largest casinos.\n\nThe Governor of the planet has called for a <font color=\'#F05555\'><b>state of emergency</b></font> and shut down all operations for the next few days.";
         this.strings["frm_Special_result_7_6"] = "<p align=\'center\'><font size=\'+5\'><b>Casino Dealer</b></font></p>\nThe owner of one of the major casinos on Tilo died last night, and all the casinos have <font color=\'#F05555\'><b>shut down</b></font> for a week to pay their respects.";
         this.strings["frm_Special_result_7_7"] = "<p align=\'center\'><font size=\'+5\'><b>Casino Dealer</b></font></p>\nThe Governor of Tilo has ordered the <font color=\'#F05555\'><b>casinos shut down</b></font> for a week due to a series of fights which have erupted.\n\nApparently, the casinos attract a lot of low-life pirates, petty thieves and mercenaries.";
         this.strings["frm_Special_result_7_8"] = "<p align=\'center\'><b>All Or Nothing</b>\n\nEnter your bet:</p>";
         this.strings["frm_Special_result_7_9"] = "<p align=\'center\'><font size=\'+5\'><b>Casino Dealer</b></font></p>\nYou did not make a wager.\n\nThe Casino Dealer politely asks you to leave and come back when you are ready to gamble.";
         this.strings["frm_Special_result_7_10"] = "<p align=\'center\'><font size=\'+5\'><b>Casino Dealer</b></font></p>\nYou cannot bet more than you have.\n\nThe Casino Dealer politely asks you to leave and come back when you have enough money.";
         this.strings["frm_Special_result_7_11"] = "<p align=\'center\'><font size=\'+5\'><b>Casino Dealer</b></font></p>\nUnder Kukubian Law, you cannot place a bet greater than 5% of your total cash in any one week.\n\nThe Casino Dealer politely informs you that the casino would love to take all of your money, but unfortunately, that would mean breaking the law.";
         this.strings["frm_Special_result_7_12_1"] = "<p align=\'center\'><font size=\'+5\'><b>Casino Dealer</b></font></p>\nSorry, but you <font color=\'#F05555\'><b>lose</b></font>.\n\nThe Casino Dealer takes your <font color=\'#F05555\'><b>";
         this.strings["frm_Special_result_7_12_2"] = " kubars</b></font> and informs you that if you want to continue gambling, you\'ll have to come back another time.";
         this.strings["frm_Special_result_7_13_1"] = "You <font color=\'#227BFF\'><b>win</b></font>!!!\n\nThe Casino Dealer informs you that you\'ve just won <font color=\'#227BFF\'><b>";
         this.strings["frm_Special_result_7_13_2"] = " kubars</b></font>!  Under the house rules, you now have the option of going for double or nothing.\n\nDo you want to continue gambling?";
         this.strings["frm_Special_result_7_14"] = "<p align=\'center\'><font size=\'+5\'><b>Casino Dealer</b></font></p>\nSorry, but you <font color=\'#F05555\'><b>lose it all</b></font>.\n\nThe Casino Dealer politely takes your money and informs you that if you want to continue gambling, you\'ll have to come back next week.";
         this.strings["frm_Special_result_7_15_1"] = "<p align=\'center\'><font size=\'+5\'><b>Casino Dealer</b></font></p>\nCongratulations, you just won <font color=\'#77D7FF\'><b>";
         this.strings["frm_Special_result_7_15_2"] = " kubars</b></font>!\n\nYou know what they say...  It\'s better to be lucky than smart.";
         this.strings["frm_Special_result_8_1_1"] = "<p align=\'center\'><font size=\'+5\'><b>Lady Cornucopia</b></font></p>\nYou cannot purchase ";
         this.strings["frm_Special_result_8_1_2"] = " tons of cargo because your ship only has room for ";
         this.strings["frm_Special_result_8_1_3"] = " tons.\n\nLady Cornucopia insists upon selling all or nothing.  Before you purchase any goods from Lady Cornucopia, you must first make room by unloading some of the cargo from your ship.";
         this.strings["frm_Special_result_8_2"] = "<p align=\'center\'><font size=\'+5\'><b>Lady Cornucopia</b></font></p>\nWhen you show up at Lady Cornucopia\'s Palace, she refuses to sell you anything.  No reason is given, and two armed guards quickly escort you off the palace grounds.";
         this.strings["frm_Special_result_8_3"] = "<p align=\'center\'><font size=\'+5\'><b>Lady Cornucopia</b></font></p>\nWhen you dock your ship at Lady Cornucopia\'s warehouse, the security guard says he does not have authorization to sell you anything.  You try to talk to the head administrator, but this does little good.  They refuse to sell you any cargo.";
         this.strings["frm_Special_result_8_4"] = "<p align=\'center\'><font size=\'+5\'><b>Lady Cornucopia</b></font></p>\nWhen you arrive at Lady Cornucopia\'s Palace, you are promptly told that you must leave or your ship will be blown up.  This is enough to convince you that it is not a good time to bother the Lady.";
         this.strings["frm_Special_result_8_5"] = "<p align=\'center\'><font size=\'+5\'><b>Lady Cornucopia</b></font></p>\nOne of Lady Cornucopia\'s servants informs you that the Lady has a severe headache and has cancelled all business transactions this week.  You are told to come back when the Lady is feeling better.";
         this.strings["frm_Special_result_8_6"] = "<p align=\'center\'><font size=\'+5\'><b>Lady Cornucopia</b></font></p>\nLady Cornucopia takes one look at your face, then says she feels sick to her stomach.  That\'s it.  You are told to leave and not come back.";
         this.strings["frm_Special_result_8_7"] = "<p align=\'center\'><font size=\'+5\'><b>Lady Cornucopia</b></font></p>\nWhen you arrive at the palace, Lady Cornucopia is in a meeting with Emperor Dred Nicolson and refuses to sell you anything.";
         this.strings["frm_Special_result_8_8"] = "<p align=\'center\'><font size=\'+5\'><b>Lady Cornucopia</b></font></p>\nWhen you pull your ship up to the palace, several buildings are on fire.\n\nYou quickly discover there has been a skirmish between Lady Cornucopia\'s security forces and a band of Hapa Jillos.  Armed guards are running around everywhere, and you are told to leave the area immediately.";
         this.strings["frm_Special_result_8_9"] = "<p align=\'center\'><font size=\'+5\'><b>Lady Cornucopia</b></font></p>\nLady Cornucopia comes out of her palace and personally apologizes for the situation.  Apparently she has run out of goods to sell, and you must come back next week.";
         this.strings["frm_Special_result_8_10"] = "<p align=\'center\'><font size=\'+5\'><b>Lady Cornucopia</b></font></p>\nOne of Lady Cornucopia\'s servants informs you that the entire warehouse full of goods is defective and must be destroyed.  There will be no sales to anyone this week.";
         this.strings["frm_Special_result_8_11"] = "<p align=\'center\'><font size=\'+5\'><b>Lady Cornucopia</b></font></p>\nLady Cornucopia invites you for tea and explains how business has not been so good lately.  She would love to sell you some products, but since you are one of her smaller clients, she must hold onto the goods for her bigger customers.  She hopes you understand.";
         this.strings["frm_Special_result_8_12_1"] = "<p align=\'center\'><font size=\'+5\'><b>Lady Cornucopia</b></font></p>\nYou just purchased ";
         this.strings["frm_Special_result_8_12_2"] = " tons of ";
         this.strings["frm_Special_result_8_12_3"] = " at ";
         this.strings["frm_Special_result_8_12_4"] = " kubars/ton.\n\nYou spent a total of ";
         this.strings["frm_Special_result_8_12_5"] = " kubars.\n\nIt\'s now up to you to make some profit on ";
         this.strings["frm_Special_result_8_12_6"] = ".";
         this.strings["frm_Special_result_9_1_1"] = "<p align=\'center\'><font size=\'+5\'><b>Your Mechanic</b></font></p>\nAs luck would have it, your brilliant mechanic isn\'t quite as smart as he thought he was.\n\nAfter taking apart your ship and making a big mess, he discovers it\'s impossible to turbocharge your ship\'s engine.";
         this.strings["frm_Special_result_9_1_2"] = "<p align=\'center\'><font size=\'+5\'><b>Your Mechanic</b></font></p>\nAs luck would have it, your brilliant mechanic isn\'t quite as smart as he thought he was.\n\nAfter taking apart your ship and making a big mess, he discovers it\'s impossible to expand your ship\'s cargo bay by 10 tons.";
         this.strings["frm_Special_result_9_1_3"] = "<p align=\'center\'><font size=\'+5\'><b>Your Mechanic</b></font></p>\nAs luck would have it, your brilliant mechanic isn\'t quite as smart as he thought he was.\n\nAfter taking apart your ship and making a big mess, he discovers it\'s impossible to expand your ship\'s passenger capacity by 1 seat.";
         this.strings["frm_Special_result_9_1_4"] = "<p align=\'center\'><font size=\'+5\'><b>Your Mechanic</b></font></p>\nAs luck would have it, your brilliant mechanic isn\'t quite as smart as he thought he was.\n\nAfter taking apart your ship and making a big mess, he discovers it\'s impossible to expand your ship\'s fuel tank capacity by 5 tons.";
         this.strings["frm_Special_result_9_2"] = "<p align=\'center\'><font size=\'+5\'><b>Your Mechanic</b></font></p>\nYou show up at your mechanic\'s garage, and the place is a disaster.  To make matters worse, your mechanic is passed out on the floor.\n\nIt seems like your favorite mechanic has been having some trouble lately.";
         this.strings["frm_Special_result_9_3"] = "<p align=\'center\'><font size=\'+5\'><b>Your Mechanic</b></font></p>\nWhen you show up at your mechanic\'s workshop, he is not there.\n\nYou wait around for three hours, then get fed up and leave.";
         this.strings["frm_Special_result_9_4"] = "<p align=\'center\'><font size=\'+5\'><b>Your Mechanic</b></font></p>\nIt turns out that the day you are scheduled to bring in your ship for an upgrade, your favorite mechanic has agreed to host the Mechanics\' Union Dance at his garage.\n\nInstead of fixing your ship, you spend the afternoon dancing with a bunch of greasy mechanics.";
         this.strings["frm_Special_result_9_5"] = "<p align=\'center\'><font size=\'+5\'><b>Your Mechanic</b></font></p>\nAs it turns out, your mechanic is unable to get the proper parts to make the upgrade to your ship.";
         this.strings["frm_Special_result_9_6"] = "<p align=\'center\'><font size=\'+5\'><b>Your Mechanic</b></font></p>\nYour mechanic works for 48 hours straight trying to upgrade your ship, but he can\'t seem to get it right.\n\nIn the end, he finally gives up and collapses on the ground exhausted.";
         this.strings["frm_Special_result_9_7"] = "<p align=\'center\'><font size=\'+5\'><b>Your Mechanic</b></font></p>\nYour mechanic spends the entire afternoon telling jokes and having a jolly good time.\n\nThe only problem is that he never actually gets around to making the changes on your ship.";
         this.strings["frm_Special_result_9_8"] = "<p align=\'center\'><font size=\'+5\'><b>Your Mechanic</b></font></p>\nYour mechanic and three of his assistants go to work on your ship.\n\nThey\'ve nearly completed the job when they run into a critical problem with the ship\'s power system and are forced to scrap the whole idea.";
         this.strings["frm_Special_result_9_9"] = "<p align=\'center\'><font size=\'+5\'><b>Your Mechanic</b></font></p>\nYour mechanic struggles to make the necessary changes, but in the end it proves too difficult for him.";
         this.strings["frm_Special_result_9_10"] = "<p align=\'center\'><font size=\'+5\'><b>Your Mechanic</b></font></p>\nYour mechanic makes the upgrade.  However, by the time he\'s finished, there is no room for the crew.\n\nYou are furious and force him to return the ship to the way it was.";
         this.strings["frm_Special_result_9_11"] = "<p align=\'center\'><font size=\'+5\'><b>Your Mechanic</b></font></p>\nYour mechanic confides in you that this change he is about to make may permanently damage your ship\'s drive system.\n\nYou wisely decide not to go ahead with the upgrade.";
         this.strings["frm_Special_result_9_12"] = "<p align=\'center\'><font size=\'+5\'><b>Your Mechanic</b></font></p>\nYour mechanic is simply too busy to get around to upgrading your ship.\n\nSorry, but you\'ll have to come back another week.";
         this.strings["frm_Special_result_9_13"] = "<p align=\'center\'><font size=\'+5\'><b>Your Mechanic</b></font></p>\nYour cautious mechanic examines your ship, then concludes that it might not be such a good idea to upgrade it after all.";
         this.strings["frm_Special_result_9_14"] = "<p align=\'center\'><font size=\'+5\'><b>Your Mechanic</b></font></p>\nYour mechanic examines your ship, then concludes it\'s a piece of junk.\n\nHe refuses to waste his time and your money working on it.";
         this.strings["frm_Special_result_9_15"] = "<p align=\'center\'><font size=\'+5\'><b>Your Mechanic</b></font></p>\nYour mechanic can\'t seem to find the right tools to make the necessary upgrades to your ship.\n\nAfter searching for several hours, he finally gives up and tells you to come back another week.";
         this.strings["frm_Special_result_9_16_1"] = "<p align=\'center\'><font size=\'+5\'><b>Your Mechanic</b></font></p>\nWith a few spare parts and some hard work, your mechanic manages to <font color=\'#77D7FF\'><b>turbocharge</b></font> your ship\'s engine.";
         this.strings["frm_Special_result_9_16_2"] = "<p align=\'center\'><font size=\'+5\'><b>Your Mechanic</b></font></p>\nWith a few spare parts and some hard work, your mechanic manages to <font color=\'#77D7FF\'><b>expand</b></font> your ship\'s <font color=\'#77D7FF\'><b>cargo bay</b></font> by 10 tons.";
         this.strings["frm_Special_result_9_16_3"] = "<p align=\'center\'><font size=\'+5\'><b>Your Mechanic</b></font></p>\nWith a few spare parts and some hard work, your mechanic manages to <font color=\'#77D7FF\'><b>increase passenger capacity</b></font> by 1 seat.";
         this.strings["frm_Special_result_9_16_4"] = "<p align=\'center\'><font size=\'+5\'><b>Your Mechanic</b></font></p>\nWith a few spare parts and some hard work, your mechanic manages to <font color=\'#77D7FF\'><b>expand</b></font> your ship\'s <font color=\'#77D7FF\'><b>fuel tank capacity</b></font> by 5 tons.";
         this.strings["frm_Special_result_9_17_1"] = "<p align=\'center\'><font size=\'+5\'><b>Your Mechanic</b></font></p>\nYour mechanic is successful!\n\nIn no time, he manages to <font color=\'#77D7FF\'><b>turbocharge</b></font> your ship\'s engine.";
         this.strings["frm_Special_result_9_17_2"] = "<p align=\'center\'><font size=\'+5\'><b>Your Mechanic</b></font></p>\nYour mechanic is successful!\n\nIn no time, he manages to <font color=\'#77D7FF\'><b>expand</b></font> your ship\'s <font color=\'#77D7FF\'><b>cargo bay</b></font> by 10 tons.";
         this.strings["frm_Special_result_9_17_3"] = "<p align=\'center\'><font size=\'+5\'><b>Your Mechanic</b></font></p>\nYour mechanic is successful!\n\nIn no time, he manages to <font color=\'#77D7FF\'><b>increase passenger capacity</b></font> by 1 seat.";
         this.strings["frm_Special_result_9_17_4"] = "<p align=\'center\'><font size=\'+5\'><b>Your Mechanic</b></font></p>\nYour mechanic is successful!\n\nIn no time, he manages to <font color=\'#77D7FF\'><b>expand</b></font> your ship\'s <font color=\'#77D7FF\'><b>fuel tank capacity</b></font> by 5 tons.";
         this.strings["frm_Special_result_9_18_1"] = "<p align=\'center\'><font size=\'+5\'><b>Your Mechanic</b></font></p>\nYour mechanic labors day and night to <font color=\'#77D7FF\'><b>turbocharge</b></font> your ship\'s engine.\n\nIt\'s difficult work, but he does a <font color=\'#77D7FF\'><b>fantastic job</b></font>!";
         this.strings["frm_Special_result_9_18_2"] = "<p align=\'center\'><font size=\'+5\'><b>Your Mechanic</b></font></p>\nYour mechanic labors day and night to <font color=\'#77D7FF\'><b>expand</b></font> your ship\'s <font color=\'#77D7FF\'><b>cargo bay</b></font> by 10 tons.\n\nIt\'s difficult work, but he does a <font color=\'#77D7FF\'><b>fantastic job</b></font>!";
         this.strings["frm_Special_result_9_18_3"] = "<p align=\'center\'><font size=\'+5\'><b>Your Mechanic</b></font></p>\nYour mechanic labors day and night to <font color=\'#77D7FF\'><b>increase passenger capacity</b></font> by 1 seat.\n\nIt\'s difficult work, but he does a <font color=\'#77D7FF\'><b>fantastic job</b></font>!";
         this.strings["frm_Special_result_9_18_4"] = "<p align=\'center\'><font size=\'+5\'><b>Your Mechanic</b></font></p>\nYour mechanic labors day and night to <font color=\'#77D7FF\'><b>expand</b></font> your ship\'s <font color=\'#77D7FF\'><b>fuel tank capacity</b></font> by 5 tons.\n\nIt\'s difficult work, but he does a <font color=\'#77D7FF\'><b>fantastic job</b></font>!";
         this.strings["frm_Special_result_10_1"] = "<p align=\'center\'><font size=\'+5\'><b>Soothsayer</b></font></p>\nAs it turns out, all the Soothsayers are having a party.  They invite you to join in the festivities.\n\nAfter several hours of dancing and singing, you leave the Soothsayers with no idea what will become of you.";
         this.strings["frm_Special_result_10_2"] = "<p align=\'center\'><font size=\'+5\'><b>Soothsayer</b></font></p>\nAs luck would have it, the Soothsayers are having a religious festival this week and refuse to perform any aura readings.";
         this.strings["frm_Special_result_10_3"] = "<p align=\'center\'><font size=\'+5\'><b>Soothsayer</b></font></p>\nAn assistant Soothsayer informs you that the Soothsayers are restoring their aura this week and cannot be disturbed.";
         this.strings["frm_Special_result_10_4"] = "<p align=\'center\'><font size=\'+5\'><b>Soothsayer</b></font></p>\nYou are ushered into a waiting room and told that if a Soothsayer is available, you will be helped.\n\nAfter three hours of waiting, you become frustrated and leave.";
         this.strings["frm_Special_result_10_5"] = "<p align=\'center\'><font size=\'+5\'><b>Soothsayer</b></font></p>\nThe Soothsayer assigned to read your energy levels keeps hopping up and down with her eyes closed and refuses to talk to you.";
         this.strings["frm_Special_result_10_6"] = "<p align=\'center\'><font size=\'+5\'><b>Soothsayer</b></font></p>\nThe Soothsayers inform you that an energy shift around Ooom has distorted their aura readings, and they cannot help anyone this week.";
         this.strings["frm_Special_result_10_7"] = "<p align=\'center\'><font size=\'+5\'><b>Soothsayer</b></font></p>\nThe Soothsayers inform you that this is a religious holiday, and you will have to come back another week.";
         this.strings["frm_Special_result_10_8"] = "<p align=\'center\'><font size=\'+5\'><b>Soothsayer</b></font></p>\nThe Soothsayer assigned to you takes your reading, mumbles something to himself, then leaves the room.";
         this.strings["frm_Special_result_10_9"] = "<p align=\'center\'><font size=\'+5\'><b>Soothsayer</b></font></p>\nA Soothsayer enters the room, feels your forehead, then informs you that you are too hot to read.  Your aura is on fire, and you must meditate for a week before your energy levels can be accurately assessed.";
         this.strings["frm_Special_result_10_10"] = "<p align=\'center\'><font size=\'+5\'><b>Soothsayer</b></font></p>\nThe Soothsayer takes your hand and squeezes it twice, then falls fast asleep.\n\nYou try to wake her, but it is impossible.";
         this.strings["frm_Special_result_10_11"] = "<p align=\'center\'><font size=\'+5\'><b>Soothsayer</b></font></p>\nThe Soothsayer lays his sticky yellow fingers against your forehead and starts screaming wildly!  Breaking away, the Soothsayer falls to the ground, then shouts out that <font color=\'#F05555\'><b>you are cursed</b></font>.  You are headed for death and destruction.\n\nIf you value your life, you must seek out a blessing right away before something terrible happens.";
         this.strings["frm_Special_result_10_12"] = "<p align=\'center\'><font size=\'+5\'><b>Soothsayer</b></font></p>\nThe Soothsayer reports that you have an <font color=\'#F05555\'><b>extremely negative aura</b></font> and will probably suffer some great calamity.";
         this.strings["frm_Special_result_10_13"] = "<p align=\'center\'><font size=\'+5\'><b>Soothsayer</b></font></p>\nAfter the Soothsayer licks your fingers and examines your ear cavities, her eyes turn white and she begins shaking.  She informs you that you are radiating an <font color=\'#F05555\'><b>extremely negative energy</b></font>.\n\nThat can only mean one thing:  you are headed for trouble and should be cautious in the near future.";
         this.strings["frm_Special_result_10_14"] = "<p align=\'center\'><font size=\'+5\'><b>Soothsayer</b></font></p>\nThe Soothsayer slides her slimy yellow fingers between your toes and lets out a gasp.  Your aura is <font color=\'#F05555\'><b>not good</b></font>, <font color=\'#F05555\'><b>not good at all</b></font>.\n\nThe Soothsayer warns you to be careful to avoid any precarious situations in the next few weeks.";
         this.strings["frm_Special_result_10_15"] = "<p align=\'center\'><font size=\'+5\'><b>Soothsayer</b></font></p>\nThe Soothsayer informs you that your aura is <font color=\'#F05555\'><b>rather negative</b></font>, and you should be careful for the next few weeks.";
         this.strings["frm_Special_result_10_16"] = "<p align=\'center\'><font size=\'+5\'><b>Soothsayer</b></font></p>\nThe Soothsayer performs a series of readings and comes to the conclusion that your aura is <b><i>slightly</i></b> on the <b><i>negative</i></b> side, but this is nothing to worry about.";
         this.strings["frm_Special_result_10_17"] = "<p align=\'center\'><font size=\'+5\'><b>Soothsayer</b></font></p>\nAfter the reading has been completed, the Soothsayer informs you that your aura is <b><i>average</i></b>.\n\nYour luck could go either way in the near future.";
         this.strings["frm_Special_result_10_18"] = "<p align=\'center\'><font size=\'+5\'><b>Soothsayer</b></font></p>\nThe Soothsayer wraps his thick legs around your neck and begins wailing incomprehensibly.\n\nAfter 20 minutes of this, the Soothsayer sits up and politely explains that your aura is <b><i>not perfect</i></b>, but it\'s <b><i>not terrible</i></b> either.\n\nAs far as he can see, it\'s a slightly light shade of gray, which isn\'t great but isn\'t anything to worry about.";
         this.strings["frm_Special_result_10_19"] = "<p align=\'center\'><font size=\'+5\'><b>Soothsayer</b></font></p>\nThe Soothsayer rubs her elbows in your face while singing to herself.  It seems like she\'s having fun, but you definitely are not.\n\nFinally, after what feels like an eternity, she says she couldn\'t detect much of anything.  Your energy level is <b><i>slightly positive</i></b>, which is good, but it\'s nothing to write home about.";
         this.strings["frm_Special_result_10_20_1"] = "<p align=\'center\'><font size=\'+5\'><b>Soothsayer</b></font></p>\nThe Soothsayer performs the standard reading and comes back with good news.\n\nYour aura is <font color=\'#77D7FF\'><b>positive</b></font>.  In fact, it\'s <font color=\'#77D7FF\'><b>well above average</b></font>.\n\nYou can rest assured the odds are in your favor.";
         this.strings["frm_Special_result_10_20_2_1"] = "<p align=\'center\'><font size=\'+5\'><b>Soothsayer</b></font></p>\nThe Soothsayer explains that your aura is <font color=\'#77D7FF\'><b>positive</b></font> and may lead to some good fortune.\n\nAs luck would have it, on your way home from the Soothsayer, you find a wallet stuffed with <font color=\'#77D7FF\'><b>";
         this.strings["frm_Special_result_10_20_2_2"] = " kubars</b></font> and no ID.  When you take this to the local police, they tell you that no one has reported a lost wallet, so you can keep the money.";
         this.strings["frm_Special_result_10_21_1"] = "<p align=\'center\'><font size=\'+5\'><b>Soothsayer</b></font></p>\nThe Soothsayer sits on your back and begins pulling out small hairs with a tweezers.  This doesn\'t hurt, but you find it rather strange.\n\nAfter examining these hairs for several hours, the Soothsayer says things are looking up.  Your <font color=\'#77D7FF\'><b>energy levels</b></font> are on the <font color=\'#77D7FF\'><b>rise</b></font>.  You aren\'t the most blessed person ever, but you don\'t have anything to worry about.";
         this.strings["frm_Special_result_10_21_2_1"] = "<p align=\'center\'><font size=\'+5\'><b>Soothsayer</b></font></p>\nThe Soothsayer explains that your aura is <font color=\'#77D7FF\'><b>above average</b></font> and good fortune is bound to come your way.\n\nThat night, when you return to your ship, you find out that one of your passengers was a wealthy foreign monarch, and he was so impressed with your company that he has given you a gift of <font color=\'#77D7FF\'><b>";
         this.strings["frm_Special_result_10_21_2_2"] = " kubars</b></font>.";
         this.strings["frm_Special_result_10_22_1"] = "<p align=\'center\'><font size=\'+5\'><b>Soothsayer</b></font></p>\nThe Soothsayer reads your aura, then congratulates you on a fine showing.\n\nYour aura is <font color=\'#77D7FF\'><b>very positive</b></font>, and you should expect good fortune in the next few weeks.  At least, the odds are stacked in your favor.";
         this.strings["frm_Special_result_10_22_2_1"] = "<p align=\'center\'><font size=\'+5\'><b>Soothsayer</b></font></p>\nThe Soothsayer explains that your aura is <font color=\'#77D7FF\'><b>very positive</b></font>, and the chance of bad luck occurring is rather remote.\n\nThis is why you aren\'t surprised when a reckless driver slams into your taxi on the way home, then offers to pay you <font color=\'#77D7FF\'><b>";
         this.strings["frm_Special_result_10_22_2_2"] = " kubars</b></font> if you promise not to sue him.  To make matters better, you aren\'t even injured in the accident.";
         this.strings["frm_Special_result_10_23_1"] = "<p align=\'center\'><font size=\'+5\'><b>Soothsayer</b></font></p>\nThe Soothsayer wraps your entire body up in wet rags, which smell like vinegar.\n\nAfter several hours, he returns with a big grin on his face.  Your energy levels are <font color=\'#77D7FF\'><b>fantastic</b></font>.\n\nIn fact, you are radiating such positive energy that you can expect good things to come in the near future.";
         this.strings["frm_Special_result_10_23_2_1"] = "<p align=\'center\'><font size=\'+5\'><b>Soothsayer</b></font></p>\nThe Soothsayer explains that you have an <font color=\'#77D7FF\'><b>extremely positive</b></font> aura and should encounter a string of good luck.\n\nIt just so happens that only minutes later you receive a phone call from the Governor of Ooom, pledging to give your company <font color=\'#77D7FF\'><b>";
         this.strings["frm_Special_result_10_23_2_2"] = " kubars</b></font> in financial aid with no strings attached!";
         this.strings["frm_Special_result_10_24_1"] = "<p align=\'center\'><font size=\'+5\'><b>Soothsayer</b></font></p>\nThe Soothsayer asks you to stand in a bucket of mouth wash.  This lasts only two minutes, then the Soothsayer jumps up and hysterically hugs you.  Your energy levels are off the charts!\n\nFalling to his knees the Soothsayer begins kissing your toes, which now smell like peppermint.  You have the <font color=\'#77D7FF\'><b>most positive</b></font> energy levels the Soothsayer has seen in the past 10 months!!!\n\nYou are <font color=\'#77D7FF\'><b>truly blessed</b></font>.";
         this.strings["frm_Special_result_10_24_2_1"] = "<p align=\'center\'><font size=\'+5\'><b>Soothsayer</b></font></p>\nThe Soothsayer explains that you have an<font color=\'#77D7FF\'><b> extraordinarily positive</b></font> aura and are <font color=\'#77D7FF\'><b>truly blessed</b></font>.\n\nThe next day, you are fortunate enough to receive a <font color=\'#77D7FF\'><b>";
         this.strings["frm_Special_result_10_24_2_2"] = " kubar</b></font> refund from the Imperial Tax Office.  They explain that they made a mistake in your taxes and have refunded you the difference plus compensation.";
         this.strings["frm_Special_result_11_1_1"] = "<p align=\'center\'><font size=\'+5\'><b>Your Agent</b></font></p>\nYou appear on Evy Ev\'s Planet Chat, the hottest daytime TV talk show.  Evy\'s topic of the day is self-made entrepreneurs, and you are the star of the show.\n\nThis helps to boost your company\'s reputation and nets you <font color=\'#77D7FF\'><b>";
         this.strings["frm_Special_result_11_1_2"] = " kubars</b></font>.";
         this.strings["frm_Special_result_11_2_1"] = "<p align=\'center\'><font size=\'+5\'><b>Your Agent</b></font></p>\nThanks to your agent, you end up on prime time TV selling jelly beans.\n\nSelling candy to kids on interplanetary TV isn\'t your idea of a perfect job, but it winds up paying you <font color=\'#77D7FF\'><b>";
         this.strings["frm_Special_result_11_2_2"] = " kubars</b></font>.";
         this.strings["frm_Special_result_11_3"] = "<p align=\'center\'><font size=\'+5\'><b>Your Agent</b></font></p>\nYou spend the afternoon at an orphanage bouncing Borly Balls with Kukubia\'s most famous sports star. \n\nThe kids at the orphanage love it, but you wind up with a sore back the next morning.";
         this.strings["frm_Special_result_11_4"] = "<p align=\'center\'><font size=\'+5\'><b>Your Agent</b></font></p>\nThe Ministry of Travel says it has planned a new promotion to get Kukubians moving, and they wind up using your company as an example of what can be achieved.\n\nThis free advertising significantly boosts your company\'s reputation.";
         this.strings["frm_Special_result_11_5"] = "<p align=\'center\'><font size=\'+5\'><b>Your Agent</b></font></p>\nYou meet with a journalist from the Astral Reporter, Kukubia\'s largest newspaper.  To your surprise, the reporter writes a glowing article, making you out to be some sort of financial genius.";
         this.strings["frm_Special_result_11_6_1"] = "<p align=\'center\'><font size=\'+5\'><b>Your Agent</b></font></p>\nYou get booked on the Geeg Matiss Extravaganza, Kukubia\'s most popular late night TV show.\n\nYou wind up talking all about the silly products you import and export.  Not only is the show a hit, but you are paid <font color=\'#77D7FF\'><b>";
         this.strings["frm_Special_result_11_6_2"] = " kubars</b></font>.";
         this.strings["frm_Special_result_11_7"] = "<p align=\'center\'><font size=\'+5\'><b>Your Agent</b></font></p>\nTo your horror, you get stuck in a debate with the Cosmic Consumer Caucus, a notorious consumer watchdog.  However, instead of bashing you for charging outrageously high passenger fares, they laud you for your efforts to keep costs down and serve the public.";
         this.strings["frm_Special_result_11_8_1"] = "<p align=\'center\'><font size=\'+5\'><b>Your Agent</b></font></p>\nApparently, your agent thinks a story with the Interplanetary Inquirer, Kukubia\'s most ridiculous gossip rag, won\'t do you much harm.\n\nThe paper winds up printing an erroneous story all about how you are a robot in disguise.  The good part is that they pay you <font color=\'#77D7FF\'><b>";
         this.strings["frm_Special_result_11_8_2"] = " kubars</b></font>, and the story is so silly no one actually believes it.";
         this.strings["frm_Special_result_11_9"] = "<p align=\'center\'><font size=\'+5\'><b>Your Agent</b></font></p>\nYou appear on the well-respected Planet Line News, Kukubia\'s premier news series.  The topic for the evening is Trade Regulations, and you have a lot to say.  This goes over well with the audience, and you gain some good publicity.";
         this.strings["frm_Special_result_11_10"] = "<p align=\'center\'><font size=\'+5\'><b>Your Agent</b></font></p>\nYou are invited to attend the Ceremony of the Stars.  Everyone is there from Mr. Zinn to the Imperial Magistrate.  You spend the evening mingling with the rich and famous.";
         this.strings["frm_Special_result_11_11"] = "<p align=\'center\'><font size=\'+5\'><b>Your Agent</b></font></p>\nYou are excited to appear on the hottest daytime TV talk show in Kukubia.  The only problem is that the topic is ruthless merchants, and you turn out to be the villain.";
         this.strings["frm_Special_result_11_12_1"] = "<p align=\'center\'><font size=\'+5\'><b>Your Agent</b></font></p>\nYour agent lands you a job promoting underwear on prime time TV.  You are forced to walk around virtually naked, making silly poses.\n\nThe only positive thing is that you get paid <font color=\'#77D7FF\'><b>";
         this.strings["frm_Special_result_11_12_2"] = " kubars</b></font>.";
         this.strings["frm_Special_result_11_13_1"] = "<p align=\'center\'><font size=\'+5\'><b>Your Agent</b></font></p>\nYou end up at a charity sports benefit batting around Borly Balls with Kukubia\'s most famous sports star.  After fifteen minutes, you get slammed in the head with a Borly Ball and have to be rushed to the hospital.\n\nYou aren\'t seriously injured, but the ambulance bill comes to <font color=\'#F05555\'><b>";
         this.strings["frm_Special_result_11_13_2"] = " kubars</b></font>.";
         this.strings["frm_Special_result_11_14"] = "<p align=\'center\'><font size=\'+5\'><b>Your Agent</b></font></p>\nYour agent books you on an interplanetary TV show with the Ministry of Travel.\n\nThe only problem is that the topic of discussion is smuggling illegal aliens.  The Ministry accuses you of engaging in smuggling operations, and the show winds up doing more harm than good to your public image.";
         this.strings["frm_Special_result_11_15"] = "<p align=\'center\'><font size=\'+5\'><b>Your Agent</b></font></p>\nYour agent schedules a meeting for you with a journalist from the Astral Reporter.\n\nThe problem is that the reporter believes you are responsible for inflating the price of passenger fares between the planets.  The next day, an article appears, which makes you out to be a robber baron.";
         this.strings["frm_Special_result_11_16"] = "<p align=\'center\'><font size=\'+5\'><b>Your Agent</b></font></p>\nYou get booked on the Geeg Matiss Extravaganza, Kukubia\'s most popular late night talk show.\n\nThe only problem is that you make a complete fool of yourself.  The more you talk, the worse off you appear.";
         this.strings["frm_Special_result_11_17"] = "<p align=\'center\'><font size=\'+5\'><b>Your Agent</b></font></p>\nYou have no idea what your agent was thinking when she scheduled an interview with the Cosmic Consumer Caucus.\n\nApparently, they are waging a war on passenger fare price fixing, and you are put in the awkward position of defending your prices.";
         this.strings["frm_Special_result_11_18"] = "<p align=\'center\'><font size=\'+5\'><b>Your Agent</b></font></p>\nYou should have known better than to do an interview with the Interplanetary Inquirer, Kukubia\'s most notorious gossip rag.\n\nThe magazine winds up painting you as an obsessive money miser, who has billions of kubars stashed away in illegal bank accounts.";
         this.strings["frm_Special_result_11_19"] = "<p align=\'center\'><font size=\'+5\'><b>Your Agent</b></font></p>\nIt just so happens that Planet Line News is doing a feature on underpaid employees.\n\nThey trot out all your workers, including the Union Boss, and have them talk for an hour about how little they are getting paid.";
         this.strings["frm_Special_result_11_20"] = "<p align=\'center\'><font size=\'+5\'><b>Your Agent</b></font></p>\nYou are thrilled to be invited to the Ceremony of the Stars, until you actually show up and discover that nobody wants to talk to you.";
         this.strings["frm_Special_result_11_21"] = "<p align=\'center\'><font size=\'+5\'><b>Your Agent</b></font></p>\nYou are lucky enough to get booked on the hottest daytime TV talk show.\n\nYou spend the entire time explaining how your company provides the best service at the lowest cost.";
         this.strings["frm_Special_result_11_22_1"] = "<p align=\'center\'><font size=\'+5\'><b>Your Agent</b></font></p>\nTo your surprise, you wind up doing a commercial for Lava Lamps on prime time Kuku-cast.  Not only do you get to tell everyone how groovy and amazing Lava Lamps are, but you wind up earning <font color=\'#77D7FF\'><b>";
         this.strings["frm_Special_result_11_22_2"] = " kubars</b></font>.  Remember to thank your agent!";
         this.strings["frm_Special_result_11_23"] = "<p align=\'center\'><font size=\'+5\'><b>Your Agent</b></font></p>\nYour agent books a lunch meeting for you with Kukubia\'s most famous sports star.\n\nYou have such a pleasant time that the sports star volunteers to help promote your company at his next big game.";
         this.strings["frm_Special_result_11_24"] = "<p align=\'center\'><font size=\'+5\'><b>Your Agent</b></font></p>\nYou don\'t know how your agent does it, but she manages to tie your company in with a new government travel program being sponsored by the Ministry of Travel.\n\nThe Ministry promises to recommend your company to its civil servants, who commute regularly between the planets.";
         this.strings["frm_Special_result_11_25"] = "<p align=\'center\'><font size=\'+5\'><b>Your Agent</b></font></p>\nYou meet with a journalist from the Astral Reporter, Kukubia\'s largest newspaper.\n\nYou are prepared to tell your entire life story, but the journalist merely asks you a few questions about your ship size and cargo capacity, then leaves.";
         this.strings["frm_Special_result_11_26"] = "<p align=\'center\'><font size=\'+5\'><b>Your Agent</b></font></p>\nYou get all dressed up and are ready to appear on late night TV.\n\nHowever, when you show up at the studio, you are informed that you have been replaced by Peelia Veelia.  Sorry, but that\'s show biz!";
         this.strings["frm_Special_result_11_27"] = "<p align=\'center\'><font size=\'+5\'><b>Your Agent</b></font></p>\nYou show up at a meeting with the Cosmic Consumer Caucus, a consumer watchdog group.\n\nYou expect them to focus on your excellent safety record, but instead they merely talk about ways to improve service.";
         this.strings["frm_Special_result_11_28"] = "<p align=\'center\'><font size=\'+5\'><b>Your Agent</b></font></p>\nYour agent has signed you up to do an interview with the Interplanetary Inquirer, Kukubia\'s most notorious gossip rag.\n\nHowever, when you show up, they are not interested in you at all.";
         this.strings["frm_Special_result_11_29"] = "<p align=\'center\'><font size=\'+5\'><b>Your Agent</b></font></p>\nWhen you arrive at Planet Line News, Kukubia\'s premier TV news show, you are expecting an in-depth interview.  However, it turns out to be only a sound bite.";
         this.strings["frm_Special_result_11_30"] = "<p align=\'center\'><font size=\'+5\'><b>Your Agent</b></font></p>\nYou show up at the Ceremony of the Stars expecting to be treated like a king.  However, you wind up spending an uneventful evening trapped in a crowd of people trying to catch a glimpse of the Emperor.";
         this.strings["frm_Special_result_12_1"] = "<p align=\'center\'><font size=\'+5\'><b>Your Stock Broker</b></font></p>\nUnfortunately, when you show up at your stock broker\'s office, you discover that she is away at a bond convention on Loro.";
         this.strings["frm_Special_result_12_2"] = "<p align=\'center\'><font size=\'+5\'><b>Your Stock Broker</b></font></p>\nYour broker agrees to meet with you, but she is in a rush.  Her only advice is to invest for the long term.";
         this.strings["frm_Special_result_12_3_1"] = "<p align=\'center\'><font size=\'+5\'><b>Your Stock Broker</b></font></p>\nWhen you enter your broker\'s office, she is in tears.  Apparently, her husband just left her for the ";
         this.strings["frm_Special_result_12_3_2"] = "th time this month, and she can\'t handle it.  You spend the next two hours trying to console her.";
         this.strings["frm_Special_result_12_4"] = "<p align=\'center\'><font size=\'+5\'><b>Your Stock Broker</b></font></p>\nWhen you sit down with your broker, she goes into a tirade about the high taxes she is forced to pay!  She is so obsessed over this tax issue that she can\'t talk about anything else.";
         this.strings["frm_Special_result_12_5"] = "<p align=\'center\'><font size=\'+5\'><b>Your Stock Broker</b></font></p>\nWhen you show up at your broker\'s office, she is not there.  The secretary informs you that your broker is on the stock exchange floor for the rest of the week.";
         this.strings["frm_Special_result_12_6"] = "<p align=\'center\'><font size=\'+5\'><b>Your Stock Broker</b></font></p>\nWhen you show up at your broker\'s office, she shows you her pet Cameo.  You wind up spending the whole afternoon discussing the usefulness of Cameo fur as a household disinfectant.";
         this.strings["frm_Special_result_12_7"] = "<p align=\'center\'><font size=\'+5\'><b>Your Stock Broker</b></font></p>\nYour stock broker sits you down and gives you a long lecture about avoiding risky investments.";
         this.strings["frm_Special_result_12_8"] = "<p align=\'center\'><font size=\'+5\'><b>Your Stock Broker</b></font></p>\nWhen you show up at your stock broker\'s office, the secretary tells you that your broker is on the phone giving investment advice to Emperor Dred Nicolson himself.  You\'ll have to come back another week.";
         this.strings["frm_Special_result_12_9"] = "<p align=\'center\'><font size=\'+5\'><b>Your Stock Broker</b></font></p>\nYour stock broker refuses to give you advice on the market.  She says that with the current economic situation she has no idea what will happen in the next few weeks.";
         this.strings["frm_Special_result_12_10"] = "<p align=\'center\'><font size=\'+5\'><b>Your Stock Broker</b></font></p>\nWhen you show up at your stock broker\'s office, you are informed that she is meeting with the Imperial Magistrate and cannot take any more meetings this week.";
         this.strings["frm_Special_result_12_11_1"] = "<p align=\'center\'><font size=\'+5\'><b>Your Stock Broker</b></font></p>\nYour stock broker gives you the following recommendations:\n\n";
         this.strings["frm_Special_result_12_11_2"] = " Exchange = ";
         this.strings["frm_Special_result_12_11_3"] = "very strong sell\n";
         this.strings["frm_Special_result_12_11_4"] = "strong sell\n";
         this.strings["frm_Special_result_12_11_5"] = "sell\n";
         this.strings["frm_Special_result_12_11_6"] = "hold\n";
         this.strings["frm_Special_result_12_11_7"] = "buy\n";
         this.strings["frm_Special_result_12_11_8"] = "strong buy\n";
         this.strings["frm_Special_result_12_11_9"] = "very strong buy\n";
         this.strings["frm_Special_result_13_1"] = "<p align=\'center\'><font size=\'+5\'><b>Zobrok the Fuel Wholesaler</b></font></p>\nYou go to fill up your tank but discover it is already full.\n\nYou can\'t fill up a full tank, now can you?";
         this.strings["frm_Special_result_13_2"] = "<p align=\'center\'><font size=\'+5\'><b>Zobrok the Fuel Wholesaler</b></font></p>\nWhen you dock your ship at Zobrok\'s refueling station, Zobrok informs you that he is terribly sorry, but the previous customer just purchased the last of his fuel.";
         this.strings["frm_Special_result_13_3"] = "<p align=\'center\'><font size=\'+5\'><b>Zobrok the Fuel Wholesaler</b></font></p>\nWhen you arrive at Zobrok\'s refueling station with your ship, Zobrok says he changed his mind.  You\'ll have to come back another week.";
         this.strings["frm_Special_result_13_4"] = "<p align=\'center\'><font size=\'+5\'><b>Zobrok the Fuel Wholesaler</b></font></p>\nBefore you can pull your ship up to Zobrok\'s refueling station, he informs you that he can\'t sell you anything after all.  The prices have changed, and he is in no position to give you a discount.";
         this.strings["frm_Special_result_13_5"] = "<p align=\'center\'><font size=\'+5\'><b>Zobrok the Fuel Wholesaler</b></font></p>\nAs you pull your ship up to Zobrok\'s refueling station, he apologizes for making you go to all the trouble, but he just found a leak in his main tank.";
         this.strings["frm_Special_result_13_6"] = "<p align=\'center\'><font size=\'+5\'><b>Zobrok the Fuel Wholesaler</b></font></p>\nBefore you can pull your ship up to Zobrok\'s refueling station, he says he has changed his mind.  No fuel for you this week.";
         this.strings["frm_Special_result_13_7"] = "<p align=\'center\'><font size=\'+5\'><b>Zobrok the Fuel Wholesaler</b></font></p>\nWhen you arrive at Zobrok\'s refueling station with your ship, Zobrok is nowhere to be found.  You wait around for a few hours, then become frustrated and leave.";
         this.strings["frm_Special_result_13_8"] = "<p align=\'center\'><font size=\'+5\'><b>Zobrok the Fuel Wholesaler</b></font></p>\nAs you pull up to Zobrok\'s refueling station, he rushes out and begs you to come back another time.  He says he has an emergency to take care of and cannot help you this week!";
         this.strings["frm_Special_result_13_9_1"] = "<p align=\'center\'><font size=\'+5\'><b>Zobrok the Fuel Wholesaler</b></font></p>\nZobrok fills up your tank, <font color=\'#77D7FF\'><b>saving you</b></font> a total of <font color=\'#77D7FF\'><b>";
         this.strings["frm_Special_result_13_9_2"] = " kubars</b></font>.";
         this.strings["frm_Special_help"] = "Each planet has a special feature, which can benefit your business.\n\nA good way to familiarize yourself with the <b>Planet Special</b> is to travel to all of the planets and check out the results.\n\nOccasionally, you may run into a little bad luck.  However, as a rule, it is well worth your while to take advantage of the Planet Specials.";
         this.strings["frm_News_button_return"] = "Return to Main Menu";
         this.strings["frm_News_text_header"] = "News Center";
         this.strings["frm_News_text_1_1"] = "We have reports that the <font color=\'#F05555\'><b>Chichi Bobo Rebels</b></font> have moved into the area around <font color=\'#F05555\'><b>";
         this.strings["frm_News_text_1_2"] = "</b></font>.\n\nOur sources indicate Supreme Commander Dred Nicolson is planning a counter attack this week and fighting will intensify.";
         this.strings["frm_News_text_2_1"] = "Our sources indicate that the <font color=\'#F05555\'><b>Darleen Smugglers</b></font> have increased their activity on and around <font color=\'#F05555\'><b>";
         this.strings["frm_News_text_2_2"] = "</b></font>.\n\nThey appear to be attacking cargo ships importing goods to the planet.";
         this.strings["frm_News_text_3"] = "</b></font> has seen an upsurge in crime with the <font color=\'#F05555\'><b>Baid-Rowel Bandits</b></font> playing a major role.\n\nThey appear to be targeting merchant ships and passenger liners.";
         this.strings["frm_News_text_4_1"] = "Last night, <font color=\'#F05555\'><b>";
         this.strings["frm_News_text_4_2"] = "</b></font> was plunged into chaos as the <font color=\'#F05555\'><b>Mooglers</b></font>, a rowdy group of anarchists, took to the streets to protest Supreme Commander Dred Nicolson\'s colonial rule.  We have reports of them attacking anything that gets in their way.";
         this.strings["frm_News_text_5_1"] = "Our sources inform us that a group of wild <font color=\'#F05555\'><b>Fez Fa Fa</b></font> broke away from their sanctuary yesterday and are headed towards <font color=\'#F05555\'><b>";
         this.strings["frm_News_text_5_2"] = "</b></font>.\n\nThey are known to eat anything in their path, including Kukubian citizens.";
         this.strings["frm_News_text_6_1"] = "Sources indicate that the <font color=\'#F05555\'><b>Hungo Warriors</b></font> have taken to the war path near planet <font color=\'#F05555\'><b>";
         this.strings["frm_News_text_6_2"] = "</b></font>.\n\nThese legendary fighters are pillaging local colonies, merchant ships and government outposts.";
         this.strings["frm_News_text_7_1"] = "The <font color=\'#F05555\'><b>Cylet Mind Buggers</b></font> are reported to be operating out of the <font color=\'#F05555\'><b>";
         this.strings["frm_News_text_7_2"] = "</b></font> region.\n\nThey appear to be using their mental powers to attack vessels approaching or leaving the planet.";
         this.strings["frm_News_text_8_1"] = "Herds of mindless <font color=\'#F05555\'><b>Lippo Jungies</b></font> were spotted migrating towards <font color=\'#F05555\'><b>";
         this.strings["frm_News_text_8_2"] = "</b></font>.\n\nThese enormous roaming space-whales seem to be crushing anything that gets in their path.";
         this.strings["frm_News_text_9_1"] = "A group of <font color=\'#F05555\'><b>Wicky Wicks</b></font> have been spotted moving towards <font color=\'#F05555\'><b>";
         this.strings["frm_News_text_9_2"] = "</b></font>.\n\nThese parasitic creatures have been preying on any merchant ships they encounter.  If you are headed for the region, you are advised to change your travel plans.";
         this.strings["frm_News_text_10_1"] = "<font color=\'#F05555\'><b>Space Pirates</b></font>, descendants of the infamous Bro Nap Goodshark, have been spotted operating around <font color=\'#F05555\'><b>";
         this.strings["frm_News_text_10_2"] = "</b></font>.\n\nWe have numerous reports of their abducting spacecraft and terrorizing any ships unfortunate enough to cross their path.";
         this.strings["frm_News_text_11_1"] = "Supreme Commander Dred Nicolson paid a visit to ";
         this.strings["frm_News_text_11_2"] = " this week.\n\nThousands crowded the Colonial Senate to hear his latest proclamations concerning the planet.";
         this.strings["frm_News_text_12_1"] = "In a speech this morning, the Governor of ";
         this.strings["frm_News_text_12_2"] = " promised to stimulate the economy and boost trade by easing regulations and making it more profitable for merchants to buy and sell commodities.";
         this.strings["frm_News_text_13_1"] = "Last night, the residents of ";
         this.strings["frm_News_text_13_2"] = " celebrated the birth of their Nation with breathtaking fireworks and a speech by the Colonial Elders.";
         this.strings["frm_News_text_14_1"] = "Last night, riots rocked ";
         this.strings["frm_News_text_14_2"] = " as citizens demanded greater autonomy from the Imperial Rule of Dred Nicolson.\n\nPolice responded by arresting hundreds of protesters.";
         this.strings["frm_News_text_15_1"] = "The economy of ";
         this.strings["frm_News_text_15_2"] = " has fallen into a slump.\n\nLocal officials blame the problem on unscrupulous traders and price gouging by local merchants.";
         this.strings["frm_News_text_16_1"] = "The economy of ";
         this.strings["frm_News_text_16_2"] = " has taken off.\n\nTrade is booming and locals are enjoying the benefits of their new found wealth.";
         this.strings["frm_News_text_17_1"] = "The indigenous creatures of ";
         this.strings["frm_News_text_17_2"] = " staged a rally this morning to show solidarity and press for more rights over their native lands.";
         this.strings["frm_News_text_18_1"] = "Top government officials on ";
         this.strings["frm_News_text_18_2"] = " have been indicted on corruption charges.\n\nThe Imperial Council says it will conduct a full investigation.";
         this.strings["frm_News_text_19_1"] = "The Environmental Coalition has targeted ";
         this.strings["frm_News_text_19_2"] = " in its war against pollution.\n\nThe Coalition is pressuring the governor for better regulations on the disposal of toxic chemicals and industrial waste.";
         this.strings["frm_News_text_20"] = " is ranked as the most productive planet in the colonies by the Imperial Bureau of Statistics.";
         this.strings["frm_News_text_21_1"] = "A recent poll shows that ";
         this.strings["frm_News_text_21_2"] = "% of the population on ";
         this.strings["frm_News_text_21_3"] = " supports the current policies of Supreme Commander Dred Nicolson.";
         this.strings["frm_News_text_22_1"] = "A recent survey shows that ";
         this.strings["frm_News_text_22_2"] = "% of the population on ";
         this.strings["frm_News_text_22_3"] = " eats raw Biki Hoppers for breakfast.";
         this.strings["frm_News_text_23_1"] = "A recent survey shows that ";
         this.strings["frm_News_text_23_2"] = "% of the population on ";
         this.strings["frm_News_text_23_3"] = " buys imported Pupi Daga baby food.";
         this.strings["frm_News_text_24_1"] = "A recent poll shows that ";
         this.strings["frm_News_text_24_2"] = "% of the population on ";
         this.strings["frm_News_text_24_3"] = " bothers to vote in local elections.";
         this.strings["frm_News_text_25_1"] = "A recent poll shows that ";
         this.strings["frm_News_text_25_2"] = "% of the population on ";
         this.strings["frm_News_text_25_3"] = " feels crime is the planet\'s most serious problem.";
         this.strings["frm_News_text_26_1"] = "A recent poll shows that ";
         this.strings["frm_News_text_26_2"] = "% of the population on ";
         this.strings["frm_News_text_26_3"] = " would rather their planet break from the New Realm.";
         this.strings["frm_News_text_27_1"] = "A recent poll shows that ";
         this.strings["frm_News_text_27_2"] = "% of the population on ";
         this.strings["frm_News_text_27_3"] = " feels the economy will get worse over the next kuku year.";
         this.strings["frm_News_text_28_1"] = "A recent poll shows that ";
         this.strings["frm_News_text_28_2"] = "% of the population on ";
         this.strings["frm_News_text_28_3"] = " thinks the government should do more about the environmental degradation of the solar system.";
         this.strings["frm_News_text_29_1"] = "A recent poll shows that ";
         this.strings["frm_News_text_29_2"] = "% of the population on ";
         this.strings["frm_News_text_29_3"] = " believes Supreme Commander Dred Nicolson is the Divine Incarnation of the Great Bass.";
         this.strings["frm_News_text_30_1"] = "A recent poll shows that ";
         this.strings["frm_News_text_30_2"] = "% of the population on ";
         this.strings["frm_News_text_30_3"] = " is on a high Lissyreen health diet at the present time.";
         this.strings["frm_News_text_31_1"] = "A recent poll shows that ";
         this.strings["frm_News_text_31_2"] = "% of the population on ";
         this.strings["frm_News_text_31_3"] = " thinks that ";
         this.strings["frm_News_text_31_4"] = " is the best run trading company in Kukubia.";
         this.strings["frm_News_text_32_1"] = "A recent poll shows that ";
         this.strings["frm_News_text_32_2"] = "% of the population on ";
         this.strings["frm_News_text_32_3"] = " thinks that ";
         this.strings["frm_News_text_32_4"] = " is the worst run trading company in Kukubia.";
         this.strings["frm_News_text_33_1"] = "A recent poll shows that ";
         this.strings["frm_News_text_33_2"] = "% of the population on ";
         this.strings["frm_News_text_33_3"] = " thinks that ";
         this.strings["frm_News_text_33_4"] = " is the best run trading company in Kukubia.";
         this.strings["frm_News_text_34_1"] = "A recent poll shows that ";
         this.strings["frm_News_text_34_2"] = "% of the population on ";
         this.strings["frm_News_text_34_3"] = " thinks that ";
         this.strings["frm_News_text_34_4"] = " is the worst run trading company in Kukubia.";
         this.strings["frm_News_text_35"] = "The Supreme Commander Dred Nicolson promises to expand democracy to the colonies just as soon as the situation stabilizes.";
         this.strings["frm_News_text_36_1"] = "Now for our economic update.\n\nIt looks like there is an <font color=\'#91FF4B\'><b>oversupply</b></font> of ";
         this.strings["frm_News_text_36_2"] = " on ";
         this.strings["frm_News_text_36_3"] = " these days.  That means low prices for consumers and a good bargain for exporters.";
         this.strings["frm_News_text_37_1"] = "Now for our economic update.\n\nIt looks like the supply of ";
         this.strings["frm_News_text_37_2"] = " is <font color=\'#91FF4B\'><b>running short</b></font> on ";
         this.strings["frm_News_text_37_3"] = " these days.  That means high prices for consumers and a healthy profit margin for importers.";
         this.strings["frm_News_text_38_1_1"] = "The leading financial analysts at the <font color=\'#91FF4B\'><b>";
         this.strings["frm_News_text_38_1_2"] = " Exchange</b></font> report that earnings are higher than expected, and the market looks <font color=\'#91FF4B\'><b>bullish</b></font>.\n\nThey predict the market will grow at a steady pace.  However, keep in mind, market analysts are not correct 100% of the time.";
         this.strings["frm_News_text_38_2_1"] = "Market analysts reported today that the <font color=\'#91FF4B\'><b>";
         this.strings["frm_News_text_38_2_2"] = " Exchange</b></font> looks <font color=\'#91FF4B\'><b>bearish</b></font>.\n\nEarnings are down, and they expect the stock market to decline.  However, keep in mind, market analysts are not correct 100% of the time.";
         this.strings["frm_News_text_38_3_1"] = "Market analysts at the <font color=\'#91FF4B\'><b>";
         this.strings["frm_News_text_38_3_2"] = " Exchange</b></font> are thoroughly <font color=\'#91FF4B\'><b>confused</b></font> by the market.\n\nThere is a major debate going on as to what direction the market will take in the next few weeks.";
         this.strings["frm_News_text_39_1"] = "There are reports that the <font color=\'#F05555\'><b>Chichi Bobo Rebels</b></font> are having a picnic on <font color=\'#F05555\'><b>";
         this.strings["frm_News_text_39_2"] = "</b></font> this weekend.\n\nIf you\'re planning to travel to that area, you might want to bring along a little extra something in your basket because things could get nasty.";
         this.strings["frm_News_text_40_1"] = "Our sources indicate that the <font color=\'#F05555\'><b>Darleen Smugglers</b></font> are targeting the area around <font color=\'#F05555\'><b>";
         this.strings["frm_News_text_40_2"] = "</b></font>.\n\nApparently, they have cut a deal with Lady Cornucopia, who is willing to purchase everything they can plunder.";
         this.strings["frm_News_text_41_1"] = "It appears that <font color=\'#F05555\'><b>";
         this.strings["frm_News_text_41_2"] = "</b></font> is the new stalking grounds for the <font color=\'#F05555\'><b>Baid-Rowel Bandits</b></font>.\n\nWe have reports of these remorseless thugs attacking ships while dressed only in designer underpants.  Apparently, they think this enhances the overall feeling of bedlam.";
         this.strings["frm_News_text_42_1"] = "</b></font> has erupted in flames as hordes of <font color=\'#F05555\'><b>Mooglers</b></font> riot in the streets.\n\nThese fanatical anarchists are protesting the prevalence of traffic signs, which they insist infringe upon their personal liberties.  They have also been attacking any vehicles, including cargo ships, which happen to obey the traffic laws.";
         this.strings["frm_News_text_43_1"] = "A heard of <font color=\'#F05555\'><b>Fez Fa Fa</b></font> escaped from their sanctuary last night and are heading towards <font color=\'#F05555\'><b>";
         this.strings["frm_News_text_43_2"] = "</b></font>.\n\nThese ravenous eating machines have already consumed a woman, her two pet Poffers, and a lawn mower.";
         this.strings["frm_News_text_44_1"] = "We have reports that the legendary <font color=\'#F05555\'><b>Hungo Warriors</b></font> have attacked a freighter orbiting <font color=\'#F05555\'><b>";
         this.strings["frm_News_text_44_2"] = "</b></font>.\n\nThese extraordinary fighters are known to disguise their ships as asteroids and literally ram into their victims.";
         this.strings["frm_News_text_45_1"] = "The <font color=\'#F05555\'><b>Cylet Mind Buggers</b></font> have been using their incredible mental powers to harass ships around <font color=\'#F05555\'><b>";
         this.strings["frm_News_text_45_2"] = "</b></font>.\n\nIf you\'re headed in that direction be prepared for a mental assault.";
         this.strings["frm_News_text_46_1"] = "Herds of mindless <font color=\'#F05555\'><b>Lippo Jungies</b></font> are known to be performing their seasonal mating rituals off planet <font color=\'#F05555\'><b>";
         this.strings["frm_News_text_46_2"] = "</b></font> this week.\n\nThese clumsy space-whales are not outright hostile.  However, they have been known to accidentally crush anything that happens to be in their way.";
         this.strings["frm_News_text_47_1"] = "We have reports that a pack of parasitic <font color=\'#F05555\'><b>Wicky Wicks</b></font> have been sucking the life blood out of ships near <font color=\'#F05555\'><b>";
         this.strings["frm_News_text_47_2"] = "</b></font>.\n\nIf you are headed for the region next week, you are advised to reconsider your travel plans.";
         this.strings["frm_News_text_48_1"] = "A band of <font color=\'#F05555\'><b>space pirates</b></font> are reported to be looting, pillaging and spray-painting silly slogans on ships in the area around <font color=\'#F05555\'><b>";
         this.strings["frm_News_text_48_2"] = "</b></font>.";
         this.strings["frm_News_text_49_1"] = "This morning, Supreme Commander Dred Nicolson gave a speech about soap to an audience on ";
         this.strings["frm_News_text_49_2"] = ".\n\nEmperor Dred\'s great fear is that one day the galaxy will simply run out of soap.";
         this.strings["frm_News_text_50_1"] = "The Governor of ";
         this.strings["frm_News_text_50_2"] = " was arraigned today on charges of taking bribes and kickbacks from local industrialists.";
         this.strings["frm_News_text_51_1"] = "The indigenous population of ";
         this.strings["frm_News_text_51_2"] = " held a candlelight vigil in honor of Chichi Bobo, who they believe is a martyr to the cause of planetary independence.";
         this.strings["frm_News_text_52_1"] = "The streets of ";
         this.strings["frm_News_text_52_2"] = " turned into a battle ground last night as thousands of laborers rioted.  They were protesting the harsh working conditions and low pay.";
         this.strings["frm_News_text_53_1"] = "The economy of ";
         this.strings["frm_News_text_53_2"] = " has taken a turn for the worse.  Statistical data shows that the gross domestic product is down by ";
         this.strings["frm_News_text_53_3"] = "%.";
         this.strings["frm_News_text_54_1"] = "The economic conditions on ";
         this.strings["frm_News_text_54_2"] = " have shown a marked improvement over the last quarter.  Exports are up ";
         this.strings["frm_News_text_54_3"] = "% and inflation appears to be on the down swing.";
         this.strings["frm_News_text_55_1"] = "The indigenous creatures of ";
         this.strings["frm_News_text_55_2"] = " performed their annual Moxy Milk bath rituals, which they believe will drive off the evil spirits and restore harmony to their souls.";
         this.strings["frm_News_text_56_1"] = "Five top cabinet members on ";
         this.strings["frm_News_text_56_2"] = " have resigned after their party refused to raise the minimum wage for workers on the planet.";
         this.strings["frm_News_text_57_1"] = "The Environmental Coalition on ";
         this.strings["frm_News_text_57_2"] = " has come out strongly against the policy of dumping toxic fuel into the planet\'s oceans.\n\nThey say millions of fish die every year due to this type of reckless behavior.";
         this.strings["frm_News_text_58_1"] = "A new report released by the Bureau of Statistics ranks the population of ";
         this.strings["frm_News_text_58_2"] = " as the laziest in Kukubia.  They spend ";
         this.strings["frm_News_text_58_3"] = "% more time doing nothing than the average Kukubian.";
         this.strings["frm_News_text_59_1"] = "A recent poll shows that ";
         this.strings["frm_News_text_59_2"] = "% of the population on ";
         this.strings["frm_News_text_59_3"] = " consumes two or more post nasal drip pills before going to sleep at night.";
         this.strings["frm_News_text_60_1"] = "A recent poll shows that ";
         this.strings["frm_News_text_60_2"] = "% of the population on ";
         this.strings["frm_News_text_60_3"] = " would rather have two Malakite sandwiches for lunch for 6 months straight than inform a co-worker that he or she has a body odor problem.";
         this.strings["frm_News_text_61_1"] = "A recent poll shows that ";
         this.strings["frm_News_text_61_2"] = "% of the population on ";
         this.strings["frm_News_text_61_3"] = " prefers to drink their Horpi Lactate directly from the nipples of a pregnant Horpi Cow rather than out of a bottle.";
         this.strings["frm_News_text_62_1"] = "A recent poll shows that ";
         this.strings["frm_News_text_62_2"] = "% of the population on ";
         this.strings["frm_News_text_62_3"] = " have had some form of toe surgery in the past 12 months.";
         this.strings["frm_News_text_63_1"] = "A recent poll shows that ";
         this.strings["frm_News_text_63_2"] = "% of the population on ";
         this.strings["frm_News_text_63_3"] = " feel criminals should be given an education in prison rather than being forced to spend 12 hours a day watching TV.";
         this.strings["frm_News_text_64_1"] = "A recent poll shows that ";
         this.strings["frm_News_text_64_2"] = "% of the population on ";
         this.strings["frm_News_text_64_3"] = " have at least one Lava Lamp in their homes.";
         this.strings["frm_News_text_65_1"] = "A recent poll shows that ";
         this.strings["frm_News_text_65_2"] = "% of the population on ";
         this.strings["frm_News_text_65_3"] = " have at least 1,000 kubars invested in the ";
         this.strings["frm_News_text_65_4"] = " Stock Exchange.";
         this.strings["frm_News_text_66_1"] = "A recent poll shows that ";
         this.strings["frm_News_text_66_2"] = "% of the population on ";
         this.strings["frm_News_text_66_3"] = " supports a recycling program for all paper and plastic products produced on the planet.";
         this.strings["frm_News_text_67_1"] = "A recent poll shows that ";
         this.strings["frm_News_text_67_2"] = "% of the population on ";
         this.strings["frm_News_text_67_3"] = " have considered naming at least one of their children Dred.";
         this.strings["frm_News_text_68_1"] = "A recent poll shows that ";
         this.strings["frm_News_text_68_2"] = "% of the population on ";
         this.strings["frm_News_text_68_3"] = " believes that the government should do more to curb the power of large interplanetary corporations.";
         this.strings["frm_News_text_69_1"] = "A recent poll shows that ";
         this.strings["frm_News_text_69_2"] = "% of the population on ";
         this.strings["frm_News_text_69_3"] = " feel that ";
         this.strings["frm_News_text_69_4"] = " is charging too much for passenger fares.";
         this.strings["frm_News_text_70_1"] = "A recent poll shows that ";
         this.strings["frm_News_text_70_2"] = "% of the population on ";
         this.strings["frm_News_text_70_3"] = " believe that ";
         this.strings["frm_News_text_70_4"] = " is partially responsible for the high price of products on the planet.";
         this.strings["frm_News_text_71_1"] = "A recent poll shows that ";
         this.strings["frm_News_text_71_2"] = "% of the population on ";
         this.strings["frm_News_text_71_3"] = " believe that ";
         this.strings["frm_News_text_71_4"] = " is charging too much for passenger fares.";
         this.strings["frm_News_text_72_1"] = "A recent poll shows that ";
         this.strings["frm_News_text_72_2"] = "% of the population on ";
         this.strings["frm_News_text_72_3"] = " thinks that ";
         this.strings["frm_News_text_72_4"] = " is partially responsible for the high price of products on the planet.";
         this.strings["frm_News_text_73"] = "The Supreme Commander Dred Nicolson said he fully supports the concept of democracy in theory.\n\nHowever, in practice, he simply cannot trust the people to make the right choices.";
         this.strings["frm_News_text_74_1"] = "A recently released government report indicates that there is now an <font color=\'#91FF4B\'><b>abundance</b></font> of ";
         this.strings["frm_News_text_74_2"] = " on <font color=\'#91FF4B\'><b>";
         this.strings["frm_News_text_74_3"] = "</b></font>.\n\nThis glut of product should have some impact upon prices in the region.";
         this.strings["frm_News_text_75_1"] = "A recently released government report indicates that there is now a <font color=\'#91FF4B\'><b>scarcity</b></font> of ";
         this.strings["frm_News_text_75_2"] = " on <font color=\'#91FF4B\'><b>";
         this.strings["frm_News_text_75_3"] = "</b></font>.\n\nThis shortage should help to drive up prices in the region.";
         this.strings["frm_News_text_76_1_1"] = "Traders on the <font color=\'#91FF4B\'><b>";
         this.strings["frm_News_text_76_1_2"] = " Exchange</b></font> feel a <font color=\'#91FF4B\'><b>bull market</b></font> is bound to drive up stock prices in the near future.\n\nHowever, their optimistic outlook is based more on the current market trends than any underlying economic factors.";
         this.strings["frm_News_text_76_2_1"] = "Traders on the <font color=\'#91FF4B\'><b>";
         this.strings["frm_News_text_76_2_2"] = " Exchange</b></font> feel a <font color=\'#91FF4B\'><b>bear market</b></font> is bound to drive down stock prices in the near term.\n\nHowever, their pessimistic outlook is based more on the current market trends than any underlying economic factors.";
         this.strings["frm_News_text_76_3_1"] = "Traders on the <font color=\'#91FF4B\'><b>";
         this.strings["frm_News_text_76_3_2"] = " Exchange</b></font> have <font color=\'#91FF4B\'><b>mixed feelings</b></font> about the condition of the market these days.\n\nSome traders are bullish, while others are bearish.  Overall, it appears that no one knows what is going to happen in the next few months.";
         this.strings["frm_News_text_77"] = "The Baid-Rowel Bandits have released a public statement saying that in a good faith effort, they will reduce their looting and pillaging by 33% over the next 24 months.";
         this.strings["frm_News_text_78"] = "Despite their growing popularity, the Mooglers, a rowdy bunch of anarchists, have been unsuccessful at forming any sort of leadership because it goes against all their principles.";
         this.strings["frm_News_text_79"] = "Animal rights activists have taken to the streets across Kukubia this week to protest the slaughter of nearly forty Fez Fa Fa.\n\nApparently, nearly forty Fez Fa Fa, wild creatures with an appetite for raw flesh, escaped from their sanctuary last month and attacked an orbiting hamburger factory, devouring 70,000 patties along with the entire staff.";
         this.strings["frm_News_text_80"] = "The Hungo Warriors met today with the Imperial Magistrate and demanded that Dred Nicolson surrender or they would continue their war against the Nicolson Dynasty.\n\nNeedless to say, the Imperial Magistrate did not surrender the entire empire to a few hundred renegades.";
         this.strings["frm_News_text_81"] = "A gathering of pirates turned into a blood bath last night.\n\nWord is that during the Ceremonial Buccaneer Barbecue, one of the pirate clans showed up with less than enough BBQ ribs for everyone.  This led to a dispute, which quickly escalated into a full-fledged fight.\n\nBy the time it ended, dozens of pirates lay slain.";
         this.strings["frm_News_text_82"] = "Scientists at the Imperial University have been researching the extraordinary mental powers of the Cylet Mind Buggers.\n\nUsing a brain extracted from one of these creatures, they managed to toast a slice of sourdough bread.  Further experiments on other food products are anticipated.";
         this.strings["frm_News_text_83"] = "The Lippo Jungie Task Force has been on high alert.\n\nThese mindless space-whales are expected to be passing through Kukubia sometime in the next few weeks, and the task force doesn\'t want any unpleasant accidents to take place.";
         this.strings["frm_News_text_84"] = "A council has been convened to discuss ways of dealing with the Wicky Wicks, a group of notorious parasitic creatures who prey on unsuspecting merchant ships.";
         this.strings["frm_News_text_85_1"] = "A family on ";
         this.strings["frm_News_text_85_2"] = ", who built their home over an old pirate graveyard, claims to have seen the spirit of Bro Nap Goodshark walking around singing dirty songs and cracking eggs on his head.";
         this.strings["frm_News_text_86"] = "L-Tech Engines claims it has been experiencing production delays this past month due to a new automated production line it just completed.\n\nThe Worker\'s Union refused to comment, except to say <i>\"I told you so.\"</i>";
         this.strings["frm_News_text_87"] = "Scooter Jay, a notorious smuggler, was caught last night with 200 tons of illegally imported Lava Lamps from the galaxy of Pata Pata Pita.\n\nEmperor Dred Nicolson decreed that Scooter Jay will have to pay a one million kubar fine for this transgression.";
         this.strings["frm_News_text_88"] = "Mr. Hands showed up in court today and pleaded guilty to misdemeanor charges of unknowingly selling stolen goods.\n\nThe Imperial Prosecution arranged this plea bargain because they lack the necessary funding and staff to take Hands to trial and win the case.";
         this.strings["frm_News_text_89"] = "Quist, a high flying financier, was arraigned in court today on charges of fraud.\n\nApparently, he is being accused of swindling nearly 2 million kubars out of one of his clients.  The trial will begin next month.\n\nIn the meantime, Quist is already out of jail on bail of only 50,000 kubars.";
         this.strings["frm_News_text_90_1"] = "Emperor Dred Nicolson met with the governor of ";
         this.strings["frm_News_text_90_2"] = " today to discuss the possibility of injecting liquid soap into the planet\'s water supply.\n\nThe Emperor feels this would save time and soap.  The Governor, however, wouldn\'t commit, fearing the water may not taste right.";
         this.strings["frm_News_text_91_1"] = "There has been a warehouse shortage on ";
         this.strings["frm_News_text_91_2"] = ".  Merchants report paying higher prices and struggling to find adequate space for their products.";
         this.strings["frm_News_text_92_1"] = "Emperor Dred Nicolson attended the annual Eat With Your Feet festival on ";
         this.strings["frm_News_text_92_2"] = ".\n\nDuring this one day festival, everyone is required to both prepare and eat a meal entirely with their feet.  The Emperor wound up preparing an elegant dish of Humpato stew, which he only spilled twice.";
         this.strings["frm_News_text_93"] = "We have a report that Mr. Zinn, the wealthiest merchant on Zile, has hit hard times.  He claims his fortunes have been depleted after a series of bad loans.\n\nThis, however, cannot be confirmed, and some suspect it may be a clever ploy to avoid paying taxes.";
         this.strings["frm_News_text_94"] = "Lady Cornucopia reportedly increased her defense spending by 200% over the past year.\n\nThis is seen as a move towards further independence from the New Realm.";
         this.strings["frm_News_text_95"] = "Emperor Dred Nicolson attacked the Traders\' Union, saying it controls a monopoly on banking inside Kukubia and is holding back growth.";
         this.strings["frm_News_text_96"] = "Emperor Dred Nicolson mentioned today that he is now constructing a summer home on Asteroid B153-89065, the largest and slowest moving asteroid in the Galaxy of Gogg.";
         this.strings["frm_News_text_97"] = "Scientists at the Imperial University are working on developing a new type of ship with double the cargo capacity.\n\nThey expect to have a test model ready by early next year.";
         this.strings["frm_News_text_98_1"] = "The Ship Worker\'s Union held a rally today on ";
         this.strings["frm_News_text_98_2"] = " to protest the installation of new robots in the main shipyard.\n\nThey insist that replacing intelligent beings with computers can only lead to disaster.";
         this.strings["frm_News_text_99"] = "The Imperial Council has offered the Chichi Bobo Freedom Fighters general amnesty if they agree to put down their weapons and give up their struggle against the government.\n\nThe Freedom Fighters said they will agree to those terms just as soon as Emperor Dred Nicolson grants the Kukubian Colonies their independence.";
         this.strings["frm_News_text_100_1"] = "The <font color=\'#F05555\'><b>Darleen Smugglers</b></font> were reported to be having a vacation on <font color=\'#F05555\'><b>";
         this.strings["frm_News_text_100_2"] = "</b></font>.\n\nIn fact, several witnesses claim to have spotted them sunbathing on the local beaches.";
         this.strings["frm_News_text_101_1"] = "The Wobbler has announced a new experimental play will be opening on ";
         this.strings["frm_News_text_101_2"] = " this week.\n\nThe Wobbler claims this play will shock the pants off most Kukubians.  However, that remains to be seen.";
         this.strings["frm_News_text_102_1"] = "Brow, a notorious industrial spy, started advertising in the newspapers on ";
         this.strings["frm_News_text_102_2"] = " this week.\n\nBrow hopes that his new publicity campaign will boost his image and bring in clients.";
         this.strings["frm_News_text_103"] = "Yoyo, the well-known gambler, was arrested yesterday after trying to cheat an undercover police officer out of 5,000 kubars.\n\nYoyo is expected to be released on bail by tomorrow morning.";
         this.strings["frm_News_text_104_1"] = "Limpus, a renowned humanitarian and philanthropist, said he is establishing a children\'s hospital on ";
         this.strings["frm_News_text_104_2"] = " this week.\n\nHe plans on naming it the Limpus Loves Children Center.";
         this.strings["frm_News_text_105"] = "Kukubia\'s casinos reported record profits last quarter.  The manager of one of the casinos said:\n\n<i>\"People should be happy to lose money to us.  Otherwise, they would end up gambling in some dirty basement, instead of these luxury resorts.\"</i>";
         this.strings["frm_News_text_106"] = "The Minster of Trash reported that the amount of garbage being taken to Kukubia\'s dumps has fallen by 44% in the past year, due primarily to improved recycling facilities in all the major cities.";
         this.strings["frm_News_text_107"] = "The Soothsayer\'s Union lodged a complaint today with the Minister of Predictions, claiming that unregistered Soothsayers were handing out erroneous readings.";
         this.strings["frm_News_text_108"] = "Horkywood is pumping out movies these days, and many of them seem to be about the royal Nicolson Family.\n\nTwo new feature films will depict the heroic life of the Great Bass Nicolson, while a third film will chronicle the childhood of Emperor Dred Nicolson.";
         this.strings["frm_News_text_109_1"] = " is hosting the 134th Annual Stock Broker\'s Convention this week.\n\nBrokers from all across the galaxy are expected to show up and exchange hot tips and insider information.";
         this.strings["frm_News_text_110_1"] = "A large explosion shook ";
         this.strings["frm_News_text_110_2"] = "  today when a giant oil tanker went up in flames.  This is the third such incident this year, and local authorities are investigating the cause.\n\nThe owners of the tanker insist that it is nothing to worry about... just a small fuel leak.";
         this.strings["frm_News_text_111_1"] = "The Imperial Council met on ";
         this.strings["frm_News_text_111_2"] = " today to debate whether or not to triple the import and export tariffs throughout Kukubia.\n\nOutside, merchants protested claiming this could bankrupt their companies.";
         this.strings["frm_News_text_112"] = "L-Tech, the largest manufacturer of engines in Kukubia, announced it will be laying off 30% of its work force in hopes of increasing corporate profits and boosting shareholder value.";
         this.strings["frm_News_text_113_1"] = "The Governor of ";
         this.strings["frm_News_text_113_2"] = " has drafted a new initiative to save the planet\'s historic business district.\n\nOver the past decade, pollution combined with poor maintenance has led to the disintegration of many of the planet\'s most prized landmarks.";
         this.strings["frm_News_text_114"] = "Voyager\'s Insurance Company came under attack today for charging excessively high premiums.\n\nThe Cosmic Consumer Caucus released figures showing that Voyager\'s is making record profits at the expense of business owners and the general public.";
         this.strings["frm_News_text_115_1"] = "We have reports that the <font color=\'#F05555\'><b>Chichi Bobo Rebels</b></font> have moved into the area around <font color=\'#F05555\'><b>";
         this.strings["frm_News_text_115_2"] = "</b></font>.\n\nOur sources indicate Supreme Commander Dred Nicolson is planning a counter attack this week and fighting will intensify.";
         this.strings["frm_News_text_116_1"] = "Our sources indicate that the <font color=\'#F05555\'><b>Darleen Smugglers</b></font> have increased their activity on and around <font color=\'#F05555\'><b>";
         this.strings["frm_News_text_116_2"] = "</b></font>.\n\nThey appear to be attacking cargo ships importing goods to the planet.";
         this.strings["frm_News_text_117"] = "</b></font> has seen an upsurge in crime with the<font color=\'#F05555\'><b> Baid-Rowel Bandits</b></font> playing a major role.\n\nThey appear to be targeting merchant ships and passenger liners.";
         this.strings["frm_News_text_118_1"] = "Last night, <font color=\'#F05555\'><b>";
         this.strings["frm_News_text_118_2"] = "</b></font> was plunged into chaos as the <font color=\'#F05555\'><b>Mooglers</b></font>, a rowdy group of anarchists, took to the streets to protest Supreme Commander Dred Nicolson\'s colonial rule.\n\nWe have reports of them attacking anything that gets in their way.";
         this.strings["frm_News_text_119_1"] = "Our sources inform us that a group of wild <font color=\'#F05555\'><b>Fez Fa Fa</b></font> broke away from their sanctuary yesterday and are headed towards <font color=\'#F05555\'><b>";
         this.strings["frm_News_text_119_2"] = "</b></font>.\n\nThey are known to eat anything in their path, including Kukubian citizens.";
         this.strings["frm_News_text_120_1"] = "Sources indicate that the <font color=\'#F05555\'><b>Hungo Warriors</b></font> have taken to the war path near planet <font color=\'#F05555\'><b>";
         this.strings["frm_News_text_120_2"] = "</b></font>.\n\nThese legendary fighters are pillaging local colonies, merchant ships and government outposts.";
         this.strings["frm_News_text_121_1"] = "The <font color=\'#F05555\'><b>Cylet Mind Buggers</b></font> are reported to be operating out of the <font color=\'#F05555\'><b>";
         this.strings["frm_News_text_121_2"] = "</b></font> region.\n\nThey appear to be using their mental powers to attack vessels approaching or leaving the planet.";
         this.strings["frm_News_text_122_1"] = "Herds of mindless <font color=\'#F05555\'><b>Lippo Jungies</b></font> were spotted migrating towards <font color=\'#F05555\'><b>";
         this.strings["frm_News_text_122_2"] = "</b></font>.\n\nThese enormous roaming space-whales seem to be crushing anything that gets in their path.";
         this.strings["frm_News_text_123_1"] = "A group of <font color=\'#F05555\'><b>Wicky Wicks</b></font> have been spotted moving towards <font color=\'#F05555\'><b>";
         this.strings["frm_News_text_123_2"] = "</b></font>.\n\nThese parasitic creatures have been preying on any merchant ships they encounter.  If you are headed for the region, you are advised to change your travel plans.";
         this.strings["frm_News_text_124_1"] = "<font color=\'#F05555\'><b>Space Pirates</b></font>, descendants of the infamous Bro Nap Goodshark, have been spotted operating around <font color=\'#F05555\'><b>";
         this.strings["frm_News_text_124_2"] = "</b></font>.\n\nWe have numerous reports of their abducting spacecraft and terrorizing any ships unfortunate enough to cross their path.";
         this.strings["frm_News_text_1000_1"] = "The <font color=\'#77D7FF\'><b>";
         this.strings["frm_News_text_1000_2"] = " Exchange</b></font> shot up this week!!!\n\nThe average share price <font color=\'#77D7FF\'><b>gained</b></font> an amazing <font color=\'#77D7FF\'><b>";
         this.strings["frm_News_text_1000_3"] = " points</b></font> on heavy trading.\n\nWe have reports from the ";
         this.strings["frm_News_text_1000_4"] = " Exchange that a number of big investors, including Mr. Zinn, made a tidy profit on this unexpected market shift.";
         this.strings["frm_News_text_1001_1"] = "The <font color=\'#F05555\'><b>";
         this.strings["frm_News_text_1001_2"] = " Exchange</b></font> plummeted this week, as the average share price <font color=\'#F05555\'><b>fell ";
         this.strings["frm_News_text_1001_3"] = " points</b></font>.\n\nWe have reports from the ";
         this.strings["frm_News_text_1001_4"] = " Exchange that a number of big investors lost a fortune in this unexpected down-turn.";
         this.strings["frm_News_text_1002_1_1"] = "Traders at the <font color=\'#F05555\'><b>";
         this.strings["frm_News_text_1002_1_2"] = " Exchange</b></font> are expecting the <font color=\'#F05555\'><b>worst</b></font>.\n\nMarket analysts predict a downward trend in the stock market on planet ";
         this.strings["frm_News_text_1002_1_3"] = ".  This bear market is likely to affect the share prices of the ";
         this.strings["frm_News_text_1002_1_4"] = " Exchange.";
         this.strings["frm_News_text_1002_2_1"] = "Traders on the floor of the <font color=\'#77D7FF\'><b>";
         this.strings["frm_News_text_1002_2_2"] = " Exchange</b></font> are expecting to see some profits in the long term.\n\nAnalysts are predicting the ";
         this.strings["frm_News_text_1002_2_3"] = " Exchange is about to take off on a gradual <font color=\'#77D7FF\'><b>upward trend</b></font>.";
         this.strings["frm_News_help"] = "The <b>News Center</b> provides you with the latest reports on revolutions, popular trends, pirate attacks and other headline stories.\n\nIf you watch the news carefully, it can provide useful information and help you to make better business decisions.";
         this.strings["frm_Weather_button_return"] = "Return to Main Menu";
         this.strings["frm_Weather_text_header"] = "Weather Bureau";
         this.strings["frm_Weather_text_1_1"] = "Our satellites indicate you should be careful when travelling near <font color=\'#F05555\'><b>";
         this.strings["frm_Weather_text_1_2"] = "</b></font>.\n\nA <font color=\'#F05555\'><b>meteor storm</b></font> is expected to move into the area this week.";
         this.strings["frm_Weather_text_2_1"] = "We expect a <font color=\'#F05555\'><b>solar storm</b></font> to hit <font color=\'#F05555\'><b>";
         this.strings["frm_Weather_text_2_2"] = "</b></font> this week.\n\nIf you plan to travel in that area, be sure to prepare for some rough weather.";
         this.strings["frm_Weather_text_3_1"] = "This week\'s forecast shows a <font color=\'#F05555\'><b>Space Hurricane</b></font> forming around <font color=\'#F05555\'><b>";
         this.strings["frm_Weather_text_3_2"] = "</b></font>.\n\nIf you plan to visit ";
         this.strings["frm_Weather_text_3_3"] = ", you might invest in a little Voyager\'s Insurance.";
         this.strings["frm_Weather_text_4_1"] = "The skies are looking quite turbulent on planet <font color=\'#F05555\'><b>";
         this.strings["frm_Weather_text_4_2"] = "</b></font> these days.\n\nThe locals inform us that a <font color=\'#F05555\'><b>Stellar Typhoon</b></font> will hit the planet any day now.";
         this.strings["frm_Weather_text_5_1"] = "It looks like a corrosive cloud of <font color=\'#F05555\'><b>Dexxy Gas</b></font> is moving towards <font color=\'#F05555\'><b>";
         this.strings["frm_Weather_text_5_2"] = "</b></font>.\n\nIf you plan on being in the area, you should beware.";
         this.strings["frm_Weather_text_6_1"] = "If you\'re planning a trip to <font color=\'#F05555\'><b>";
         this.strings["frm_Weather_text_6_2"] = "</b></font> any time soon, I\'d be on the lookout for <font color=\'#F05555\'><b>Mippi Weeds</b></font>.\n\nA sticky drift of weeds is headed in that direction.";
         this.strings["frm_Weather_text_7_1"] = "We predict a stream of acidic <font color=\'#F05555\'><b>Bollup Juice</b></font> will be flowing past <font color=\'#F05555\'><b>";
         this.strings["frm_Weather_text_7_2"] = "</b></font> in the near future.\n\nThis deadly liquid is known to cause severe damage to engine pods and hull liners.";
         this.strings["frm_Weather_text_8_1"] = "It seems like a pool of <font color=\'#F05555\'><b>Wess Vapor</b></font> is accumulating around <font color=\'#F05555\'><b>";
         this.strings["frm_Weather_text_8_2"] = "</b></font>.\n\nIt should reach harmful levels within a few days.";
         this.strings["frm_Weather_text_9_1"] = "Beware, a <font color=\'#F05555\'><b>Stellar Whirlpool</b></font> is forming off planet <font color=\'#F05555\'><b>";
         this.strings["frm_Weather_text_9_2"] = "</b></font>.\n\nIt should reach critical strength in the next few days.";
         this.strings["frm_Weather_text_10_1"] = "We have reports of a <font color=\'#F05555\'><b>Bobble Warp</b></font>, a dangerous break in the time-space continuum, flaring up in the region around <font color=\'#F05555\'><b>";
         this.strings["frm_Weather_text_10_2"] = "</b></font>.";
         this.strings["frm_Weather_text_11"] = "All is looking clear this week.  No reports of meteor storms or space hurricanes yet.\n\nYou know what they say, <i>\"No news is good news.\"</i>";
         this.strings["frm_Weather_text_12"] = "All is looking clear this week.  No reports of meteor storms or space hurricanes yet.\n\nYou know what they say, <i>\"No news is good news.\"</i>";
         this.strings["frm_Weather_text_13"] = "All is looking clear this week.  No reports of meteor storms or space hurricanes yet.\n\nYou know what they say, <i>\"No news is good news.\"</i>";
         this.strings["frm_Weather_text_14"] = "All is looking clear this week.  No reports of meteor storms or space hurricanes yet.\n\nYou know what they say, <i>\"No news is good news.\"</i>";
         this.strings["frm_Weather_text_15"] = "All is looking clear this week.  No reports of meteor storms or space hurricanes yet.\n\nYou know what they say, <i>\"No news is good news.\"</i>";
         this.strings["frm_Weather_text_16_1"] = "";
         this.strings["frm_Weather_text_16_2"] = " has been experiencing some mighty dry weather lately.\n\nLocal Officials expressed fears that this may turn into a drought.";
         this.strings["frm_Weather_text_17_1"] = "It\'s cloudy over ";
         this.strings["frm_Weather_text_17_2"] = " these days.\n\nExpect occasional showers, but it should clear up later in the week.";
         this.strings["frm_Weather_text_18_1"] = "Don\'t forget your raincoat if you\'re headed to ";
         this.strings["frm_Weather_text_18_2"] = ".\n\nWe expect a healthy dose of wet weather.";
         this.strings["frm_Weather_text_19_1"] = "It looks like the skies around ";
         this.strings["frm_Weather_text_19_2"] = " have cleared up.\n\nGood news for anyone heading that way.";
         this.strings["frm_Weather_text_20_1"] = "It\'s the perfect time of year to travel to ";
         this.strings["frm_Weather_text_20_2"] = ".\n\nThe skies are looking beautiful and the Imo Blossoms are in full bloom.";
         this.strings["frm_Weather_text_21_1"] = "The weather around planet ";
         this.strings["frm_Weather_text_21_2"] = " has taken a turn for the better these days.\n\nNo Bobble Warps or Dexxy Gas has been spotted for quite some time.";
         this.strings["frm_Weather_text_22_1"] = "It appears that the seasonal Meteor Storms around ";
         this.strings["frm_Weather_text_22_2"] = " aren\'t coming this year.\n\nThat\'s good news for merchants operating in the region.";
         this.strings["frm_Weather_text_23_1"] = "We have reports that the Wess Vapor problem around ";
         this.strings["frm_Weather_text_23_2"] = " has completely diminished.\n\nYou shouldn\'t experience any trouble if you are headed in that direction.";
         this.strings["frm_Weather_text_24_1"] = "The space around ";
         this.strings["frm_Weather_text_24_2"] = " is black and beautiful this week.\n\nIt looks like clear sailing for those of you passing through the area.";
         this.strings["frm_Weather_text_25_1"] = "It\'s the perfect time of year to visit ";
         this.strings["frm_Weather_text_25_2"] = " and join in the local Ipnu Festivals.\n\nThe weather is expected to be gorgeous for at least the next week.";
         this.strings["frm_Weather_text_26_1"] = "If you enjoy drinking Gapa Milk under milky green skies, now is a great time to head to ";
         this.strings["frm_Weather_text_26_2"] = ".\n\nThe unusually humid weather this past year has inspired the Gapa Cattle to produced record quantities of this delicious beverage.";
         this.strings["frm_Weather_text_27_1"] = "It looks like the unseasonably hot weather on ";
         this.strings["frm_Weather_text_27_2"] = " has produced an explosion of Kele Jumpers.\n\nThese hungry insects are causing the local farmers a real headache but shouldn\'t be much of a problem to visitors.";
         this.strings["frm_Weather_text_28_1"] = "The temperature on ";
         this.strings["frm_Weather_text_28_2"] = " has dropped lately.\n\nThis climate change may cause some trouble for the local farmers but shouldn\'t inconvenience any visitors to the planet.";
         this.strings["frm_Weather_text_29_1"] = "Don\'t expect perfect weather when you visit ";
         this.strings["frm_Weather_text_29_2"] = ".  It looks like they are in for some heavy rains.\n\nBut no need to worry, only minor flooding is expected this year.";
         this.strings["frm_Weather_text_30_1"] = "The region around ";
         this.strings["frm_Weather_text_30_2"] = " looks like it is finally clearing up.\n\nWe don\'t expect any new problems in the area for quite some time.";
         this.strings["frm_Weather_text_31_1"] = "A recent heat wave on ";
         this.strings["frm_Weather_text_31_2"] = " has caused 2,000 tons of whipped cream to go rancid.\n\nThis is a major loss for the whipped cream industry.";
         this.strings["frm_Weather_text_32_1"] = "The freezing temperatures on ";
         this.strings["frm_Weather_text_32_2"] = " over the past few months have caused a number of outdoor lava lamps to stop functioning.";
         this.strings["frm_Weather_text_33_1"] = "The unseasonably warm temperatures on ";
         this.strings["frm_Weather_text_33_2"] = " have caused the Yiffit Fly population to explode.\n\nIf you\'re headed in that direction, be sure to bring some Yiffit repellent.";
         this.strings["frm_Weather_text_34_1"] = "The extremely hot weather on ";
         this.strings["frm_Weather_text_34_2"] = " this past week has caused literally thousands of tons of jelly beans to melt into giant jelly gobs.\n\nThe manufacturers have no choice but to destroy these gobs and write off the losses.";
         this.strings["frm_Weather_text_35_1"] = "The cold weather on ";
         this.strings["frm_Weather_text_35_2"] = " this past week has kept people indoors, and as a consequence, local shop owners are suffering.";
         this.strings["frm_Weather_text_36_1"] = "An unexpected tidal wave on ";
         this.strings["frm_Weather_text_36_2"] = " wiped out an entire village.\n\nFortunately, this happened during the Hagel Pilgrimage, and the village was almost entirely empty.";
         this.strings["frm_Weather_text_37_1"] = "As a result of the heat wave on ";
         this.strings["frm_Weather_text_37_2"] = ", locals have taken to painting their skin silver.  They claim this reflects the sun and prevents skin cancer.\n\nIf you\'re headed to the planet, be sure to bring sun glasses because at times it can be quite blinding.";
         this.strings["frm_Weather_text_38_1"] = "Locals on ";
         this.strings["frm_Weather_text_38_2"] = " are now engaged in their annual snow eating contest.\n\nThe individual who manages to eat the most snow can claim the Snow Stuffer of the Year Award.";
         this.strings["frm_Weather_text_39_1"] = "Mothers on ";
         this.strings["frm_Weather_text_39_2"] = " claim that the unseasonably hot weather this past summer prevented numerous pregnancies.\n\nStatistical data shows that the birth rate has fallen 14% compared to the same time last year.";
         this.strings["frm_Weather_text_40_1"] = "Because of the heavy rains this past winter on ";
         this.strings["frm_Weather_text_40_2"] = ", umbrella sales were well above average, and store owners report that their inventories are substantially lower than in previous years.";
         this.strings["frm_Weather_text_41_1"] = "Due to the above average snow fall this winter on ";
         this.strings["frm_Weather_text_41_2"] = ", a startup company announced plans to package the fresh snow, keep it frozen, and sell it to ski resorts around Kukubia.\n\nIt remains to be seen whether or not there is a market for this type of product.";
         this.strings["frm_Weather_text_42_1"] = "Gusty winds and non-stop rain fell on ";
         this.strings["frm_Weather_text_42_2"] = " this past week.\n\nUnfortunately, Emperor Dred Nicolson was visiting the planet at the time and became extremely upset.  Taking the terrible weather as a personal insult, the Emperor vowed never to come back to ";
         this.strings["frm_Weather_text_42_3"] = ".";
         this.strings["frm_Weather_text_43_1"] = "Due to the extended drought on ";
         this.strings["frm_Weather_text_43_2"] = ", the entire year\'s grain harvest has been ruined.";
         this.strings["frm_Weather_text_44_1"] = "A major earthquake shook ";
         this.strings["frm_Weather_text_44_2"] = " late last night.\n\nAs of today, ";
         this.strings["frm_Weather_text_44_3"] = " are reported dead and thousands are homeless.  Crews are still working around the clock to rescue those trapped in the rubble.";
         this.strings["frm_Weather_text_45_1"] = "A series of devastating floods has wiped out ";
         this.strings["frm_Weather_text_45_2"] = "% of the farms on ";
         this.strings["frm_Weather_text_45_3"] = ".\n\nEmperor Dred Nicolson has declared this a planetary emergency and is sending one billion kubars in aid to the planet.";
         this.strings["frm_Weather_text_46_1"] = "The warm weather has triggered an explosion in the Catox Bug population, and farmers on ";
         this.strings["frm_Weather_text_46_2"] = " are battling to save their crops from these ravenous insects.\n\nThe Governor has asked for help from the Imperial Magistrate, but as of yet, there has been no official response.";
         this.strings["frm_Weather_text_47_1"] = "The weather on ";
         this.strings["frm_Weather_text_47_2"] = " has been warm and beautiful.  That is why the Governor just enacted a new law outlawing nude sunbathing.\n\nThis is in response to a flood of tourists, who have come to the planet to enjoy the beaches and shed their clothing.";
         this.strings["frm_Weather_text_48_1"] = "The Kukubian Association of Meteorologists is planning a picnic on ";
         this.strings["frm_Weather_text_48_2"] = " this weekend.\n\nUnfortunately, it is supposed to rain both days.";
         this.strings["frm_Weather_text_49_1"] = "A new study shows that our weather predictions are correct ";
         this.strings["frm_Weather_text_49_2"] = "% of the time.\n\nYou\'ll be happy to know this is up from ";
         this.strings["frm_Weather_text_49_3"] = "% last year and is well above the ";
         this.strings["frm_Weather_text_49_4"] = "% national average.";
         this.strings["frm_Weather_text_50"] = "The Kukubian Broadcasters Association is thinking of launching a fruits and vegetables channel.\n\nThis will feature fruit and vegetable related stories 24 hours a day.";
         this.strings["frm_Weather_text_51_1"] = "Clouds of space dust were spotted forming around ";
         this.strings["frm_Weather_text_51_2"] = ".\n\nExperts in the area inform us that the dust may appear ominous, but it should not impede travel at all.";
         this.strings["frm_Weather_text_52_1"] = "Clouds of green gas are reported to be rising from the surface of ";
         this.strings["frm_Weather_text_52_2"] = ".\n\nScientists on the planet say these clouds may look dangerous, but they are nothing to worry about.";
         this.strings["frm_Weather_text_53_1"] = "Last night, a meteor slammed into a merchant ship trying to land on ";
         this.strings["frm_Weather_text_53_2"] = ".  The ship was heavily damaged but managed to land safely.";
         this.strings["frm_Weather_text_54_1"] = "Clouds of radioactive particles were spotted in the region of ";
         this.strings["frm_Weather_text_54_2"] = ".\n\nExperts in the area claim these particles are essentially harmless and should disperse within a few days.";
         this.strings["frm_Weather_text_55_1"] = "A small, commuter craft slammed into a 5,000-ton freighter as it was approaching ";
         this.strings["frm_Weather_text_55_2"] = ".\n\nIt exploded upon impact, and all onboard the ship are reported dead.";
         this.strings["frm_Weather_text_56_1"] = "A corrosive cloud of Dexxy Gas severely damaged a cargo ship headed for ";
         this.strings["frm_Weather_text_56_2"] = ".\n\nFortunately, no one was injured and the Dexxy Gas seems to have naturally dispersed.";
         this.strings["frm_Weather_text_57_1"] = "A stream of Bollup Juice took a bite out of a passing merchant ship near ";
         this.strings["frm_Weather_text_57_2"] = " last night.\n\nFortunately, the Bollup Juice has since been neutralized by an anti-Bollup stream.";
         this.strings["frm_Weather_text_58_1"] = "A meteor shower rained down on ";
         this.strings["frm_Weather_text_58_2"] = " yesterday evening.\n\nIt appears that 17 buildings were damaged and two individuals were injured.  The shower lasted for approximately 24 minutes.";
         this.strings["frm_Weather_text_59_1"] = "Clouds of dense gas around ";
         this.strings["frm_Weather_text_59_2"] = " have created a traffic jam.\n\nShips entering and leaving the planet must now travel at a snail\'s pace to avoid bumping into each other.\n\nThe government is currently trying to figure out a way of dispersing the troublesome gas.";
         this.strings["frm_Weather_text_60_1"] = "A recent survey indicates that weather-related accidents across Kukubia are down ";
         this.strings["frm_Weather_text_60_2"] = "% over the same period last year.\n\nPerhaps this is an indication that more travellers are tuning into our weather reports and planning safer trips.";
         this.strings["frm_Weather_text_61_1"] = "Our satellites indicate you should be careful when travelling near <font color=\'#F05555\'><b>";
         this.strings["frm_Weather_text_61_2"] = "</b></font>.\n\nA <font color=\'#F05555\'><b>meteor storm</b></font> is expected to move into the area this week.";
         this.strings["frm_Weather_text_62_1"] = "We expect a <font color=\'#F05555\'><b>solar storm</b></font> to hit <font color=\'#F05555\'><b>";
         this.strings["frm_Weather_text_62_2"] = "</b></font> this week.\n\nIf you plan to travel in that area, be sure to prepare for some rough weather.";
         this.strings["frm_Weather_text_63_1"] = "This week\'s forecast shows a <font color=\'#F05555\'><b>Space Hurricane</b></font> forming around <font color=\'#F05555\'><b>";
         this.strings["frm_Weather_text_63_2"] = "</b></font>.\n\nIf you plan to visit ";
         this.strings["frm_Weather_text_63_3"] = ", you might invest in a little Voyager\'s Insurance.";
         this.strings["frm_Weather_text_64_1"] = "The skies are looking quite turbulent on planet <font color=\'#F05555\'><b>";
         this.strings["frm_Weather_text_64_2"] = "</b></font> these days.\n\nThe locals inform us that a <font color=\'#F05555\'><b>Stellar Typhoon</b></font> will hit the planet any day now.";
         this.strings["frm_Weather_text_65_1"] = "It looks like a corrosive cloud of <font color=\'#F05555\'><b>Dexxy Gas</b></font> is moving towards <font color=\'#F05555\'><b>";
         this.strings["frm_Weather_text_65_2"] = "</b></font>.\n\nIf you plan on being in the area, you should beware.";
         this.strings["frm_Weather_text_66_1"] = "If you\'re planning a trip to <font color=\'#F05555\'><b>";
         this.strings["frm_Weather_text_66_2"] = "</b></font> any time soon, I\'d be on the lookout for <font color=\'#F05555\'><b>Mippi Weeds</b></font>.\n\nA sticky drift of weeds is headed in that direction.";
         this.strings["frm_Weather_text_67_1"] = "We predict a stream of acidic <font color=\'#F05555\'><b>Bollup Juice</b></font> will be flowing past <font color=\'#F05555\'><b>";
         this.strings["frm_Weather_text_67_2"] = "</b></font> in the near future.\n\nThis deadly liquid is known to cause severe damage to engine pods and hull liners.";
         this.strings["frm_Weather_text_68_1"] = "It seems like a pool of <font color=\'#F05555\'><b>Wess Vapor</b></font> is accumulating around <font color=\'#F05555\'><b>";
         this.strings["frm_Weather_text_68_2"] = "</b></font>.\n\nIt should reach harmful levels within a few days.";
         this.strings["frm_Weather_text_69_1"] = "Beware, a <font color=\'#F05555\'><b>Stellar Whirlpool</b></font> is forming off planet <font color=\'#F05555\'><b>";
         this.strings["frm_Weather_text_69_2"] = "</b></font>.\n\nIt should reach critical strength in the next few days.";
         this.strings["frm_Weather_text_70_1"] = "We have reports of a <font color=\'#F05555\'><b>Bobble Warp</b></font>, a dangerous break in the time-space continuum, flaring up in the region around <font color=\'#F05555\'><b>";
         this.strings["frm_Weather_text_70_2"] = "</b></font>.";
         this.strings["frm_Weather_help"] = "The <b>Weather Bureau</b> provides you with the latest reports on solar storms, typhoons, asteroid belts, and other natural perils which may affect your company.";
         this.strings["frm_History_text_0_1"] = "<p align=\'center\'><font size=\'+5\'><b>History of Vexx</b></font>       <font size=\'-5\'>(Page 1 of 10)</font></p>\nIn 300 B.B., Mono Cheezo, a failed insurance salesman and amateur explorer, decided it was his destiny to seek out and discover new planets and achieve greatness and glory.  He sold his home, bought an ancient 200-ton dairy transport ship, hired a ragtag crew, and headed off for the far reaches of Gogg.\n\nAfter months of zig-zagging across the galaxy, he finally crashlanded on Vexx, an uncharted virgin planet, or so he thought.";
         this.strings["frm_History_text_0_2"] = "<p align=\'center\'><font size=\'+5\'><b>History of Vexx</b></font>       <font size=\'-5\'>(Page 2 of 10)</font></p>\nElated at discovering a lush planet with an abundance of edible vegetation and no dangerous creatures, Mono Cheezo proclaimed Vexx the capital of Kukubia and himself the de facto King.\n\nWhat Mono Cheezo didn\'t realize was that Vexx had already been discovered by the dangerous cult of the Cylet Mind Buggers.  The Cylet Mind Buggers were feared throughout the galaxy for their deadly mental powers and strange eating habits.";
         this.strings["frm_History_text_0_3"] = "<p align=\'center\'><font size=\'+5\'><b>History of Vexx</b></font>       <font size=\'-5\'>(Page 3 of 10)</font></p>\nThe Mind Buggers believed that by eating the brains of intelligent life forms, they could strengthen their own minds.\n\nOne by one, Mono Cheezo\'s crew began disappearing.  Thinking his crew had gone off to form their own government, Mono Cheezo declared them outlaws and banished them from his kingdom.\n\nIt wasn\'t until Mono Cheezo himself was captured and placed in a pot of boiling broth that he realized what was happening.";
         this.strings["frm_History_text_0_4"] = "<p align=\'center\'><font size=\'+5\'><b>History of Vexx</b></font>       <font size=\'-5\'>(Page 4 of 10)</font></p>\nInstead of panicking, Mono Cheezo calmly explained to these brain-eating fanatics that they could not possibly have him for dinner because he was the King of Kukubia and all creatures big and small living on Vexx were his subjects.\n\nThe more Mono Cheezo talked, the more the Cylet Mind Buggers began to lose their appetites.  After all, they believed that eating a madman could cause some serious brain damage.";
         this.strings["frm_History_text_0_5"] = "<p align=\'center\'><font size=\'+5\'><b>History of Vexx</b></font>       <font size=\'-5\'>(Page 5 of 10)</font></p>\nTaking Mono Cheezo out of the pot of boiling broth, the Mind Buggers told Mono Cheezo that they didn\'t want to eat him and he could go home.\n\nThe only problem was that Mono Cheezo didn\'t want to go home.  His entire crew was gone, and these cannibals were the only ones left on the planet.  Much to the Mind Buggers\' dismay, Mono Cheezo moved in with them.";
         this.strings["frm_History_text_0_6"] = "<p align=\'center\'><font size=\'+5\'><b>History of Vexx</b></font>       <font size=\'-5\'>(Page 6 of 10)</font></p>\nThe more comfortable Mono Cheezo became, the more he began to boss the Cylet Mind Buggers around.  As far as Mono was concerned, he was king and they were his subjects.\n\nThe Cylet Mind Buggers wanted to do away with Mono Cheezo, but it was against their religion to kill or in any way harm a living creature whose brain they were not prepared to eat.";
         this.strings["frm_History_text_0_7"] = "<p align=\'center\'><font size=\'+5\'><b>History of Vexx</b></font>       <font size=\'-5\'>(Page 7 of 10)</font></p>\nThe Cylet Mind Buggers tried to escape several times.  They would wait until late at night when Mono Cheezo was asleep, then sneak away to another part of the planet.  However, sooner or later Mono Cheezo would find them.\n\nThis went on for months, until finally the Mind Buggers decided to bug out altogether.  Packing up everything, the Cylet Mind Buggers fled Vexx.";
         this.strings["frm_History_text_0_8"] = "<p align=\'center\'><font size=\'+5\'><b>History of Vexx</b></font>       <font size=\'-5\'>(Page 8 of 10)</font></p>\nMono Cheezo remained alone on the planet for the next 130 years, until Supreme Commander Bass Nicolson (Emperor Dred\'s grandfather) and his army landed.\n\nWhen Bass Nicolson heard the story of how Mono Cheezo single-handedly drove the Mind Buggers from Vexx, he took pity on poor Mono and decided to make him the honorary governor of the planet.";
         this.strings["frm_History_text_0_9"] = "<p align=\'center\'><font size=\'+5\'><b>History of Vexx</b></font>       <font size=\'-5\'>(Page 9 of 10)</font></p>\nLike always, Mono Cheezo made himself at home and began ordering everyone around, including Supreme Commander Bass.  Within a few months, Bass had become so sick of Mono Cheezo\'s mandates that he banished Mono from Vexx and sent him to the Imperial Mental Institution.\n\nAs it happens, that is where Mono Cheezo met up with another infamous historical figure, Sir Lily Slimwagon, whose adventures are described in other sections.";
         this.strings["frm_History_text_0_10"] = "<p align=\'center\'><font size=\'+5\'><b>History of Vexx</b></font>       <font size=\'-5\'>(Page 10 of 10)</font></p>\nIronically, Vexx became the capital of Kukubia as Mono had predicted, and to this day a statue of him stands in the courtyard of the Governor\'s Palace.";
         this.strings["frm_History_text_1_1"] = "<p align=\'center\'><font size=\'+5\'><b>History of Pyke</b></font>       <font size=\'-5\'>(Page 1 of 11)</font></p>\nThe Hungo Warriors colonized Pyke 800 years before anyone in the New Realm ever heard of the planet.\n\nThe legendary Hungo Warriors were known throughout the galaxy for their ongoing war with the Army of the New Realm.  The Hungo won every battle they fought, but they were losing the war.  The Hungo were a small tribe.  Attrition had reduced them to a fraction of their original numbers, yet they continued to fight on.";
         this.strings["frm_History_text_1_2"] = "<p align=\'center\'><font size=\'+5\'><b>History of Pyke</b></font>       <font size=\'-5\'>(Page 2 of 11)</font></p>\nIn 335 B.B. the Great Bass Nicolson (Emperor Dred Nicolson\'s grandfather) intensified his war against the Hungo and took over Pyke, one of their last strongholds in Gogg.\n\nThe weakened Hungo gradually retreated back into the Galaxy of Pata Pata Pita, allowing Bass Nicolson to consolidate his hold over Kukubia.";
         this.strings["frm_History_text_1_3"] = "<p align=\'center\'><font size=\'+5\'><b>History of Pyke</b></font>       <font size=\'-5\'>(Page 3 of 11)</font></p>\nBass erected one of the first military outposts in Kukubia on Pyke.  Because he needed a ready supply of weapons and military machinery, Bass encouraged heavy industry to relocate to Pyke.\n\nThat is how L-Tech engines, the largest engine manufacturer came to the planet.  Originally L-Tech produced only military engines, but recently they have branched out, selling their engines to commercial traders.";
         this.strings["frm_History_text_1_4"] = "<p align=\'center\'><font size=\'+5\'><b>History of Pyke</b></font>       <font size=\'-5\'>(Page 4 of 11)</font></p>\nPyke has been the target of a number of rebellions.\n\nThe first and best known of these is the Chichi Bobo uprising.  In 1 A.B. Chichi Bobo, an outspoken Imperial Senator and indigenous creatures rights supporter, broke from the Imperial rule of Hork Nicolson (Bass Nicolson\'s son and Dred Nicolson\'s father).  She proclaimed that the creatures of Gogg should speak up and oust the corrupt Nicolson family.";
         this.strings["frm_History_text_1_5"] = "<p align=\'center\'><font size=\'+5\'><b>History of Pyke</b></font>       <font size=\'-5\'>(Page 5 of 11)</font></p>\nWith 10,000 supporters, mostly creatures native to Kukubia, Chichi Bobo stormed the military base on Pyke and took it over.  Holding 21 generals hostage, she demanded that Hork Nicolson resign and allow democratic elections.\n\nHork agreed to allow democratic elections on the local level, but refused to give up his position as Supreme Commander, since he felt it was his birthright.";
         this.strings["frm_History_text_1_6"] = "<p align=\'center\'><font size=\'+5\'><b>History of Pyke</b></font>       <font size=\'-5\'>(Page 6 of 11)</font></p>\nAfter a series of failed negotiations, Hork ordered a bloody assault on the base.  Chichi and her followers were annihilated.\n\nThis triggered a chain of events which destabilized the government and paralyzed Hork.  Unlike his father Bass, Hork was not too clever and could not figure out how to keep things under control.\n\nThe Mooglers, a motley group of anarchists, took to the streets protesting the government\'s brutal tactics.";
         this.strings["frm_History_text_1_7"] = "<p align=\'center\'><font size=\'+5\'><b>History of Pyke</b></font>       <font size=\'-5\'>(Page 7 of 11)</font></p>\nFearing this uprising would spread to the rest of Gogg, Hork ordered the military to back off.\n\nSeeing Hork\'s weakness, the Mooglers became even more aggressive, burning banks, hospitals, schools and any other public institutions they deemed symbols of Imperial power. At the same time, groups of rebels began forming all across Gogg calling themselves the Chichi Bobo Freedom Fighters, after the martyred Chichi Bobo.";
         this.strings["frm_History_text_1_8"] = "<p align=\'center\'><font size=\'+5\'><b>History of Pyke</b></font>       <font size=\'-5\'>(Page 8 of 11)</font></p>\nWith the New Realm disintegrating before their eyes, the Imperial Cabinet convened in secret and planned the assassination of Hork.  That night Hork was ambushed and killed on his way to Pyke.\n\nWith the Supreme Commander out of their way, the Cabinet Ministers took control and began a harsh crackdown on anyone opposing the government.  This worked for a time, until the various Ministers began arguing amongst themselves.";
         this.strings["frm_History_text_1_9"] = "<p align=\'center\'><font size=\'+5\'><b>History of Pyke</b></font>       <font size=\'-5\'>(Page 9 of 11)</font></p>\nFor the next two decades the New Realm stagnated as Minister after Minister took control and was then deposed and executed.\n\nFinally, the military stepped in and reinstated Hork Nicolson\'s son, Dred Nicolson to the throne.  Dred, with the backing of the top generals, quickly dismissed the entire Imperial Cabinet and began remaking the system.";
         this.strings["frm_History_text_1_10"] = "<p align=\'center\'><font size=\'+5\'><b>History of Pyke</b></font>       <font size=\'-5\'>(Page 10 of 11)</font></p>\nHis first symbolic act was to restart the Kukubian calendar beginning with his birthday.  He claimed to be the divine incarnation of his dead grandfather Bass Nicolson, and he believed that it gave him the right to do anything he pleased.\n\nWith the backing of the military, things quickly stabilized, and Dred, although far from brilliant, managed to bring some consistency to the vast New Realm.";
         this.strings["frm_History_text_1_11"] = "<p align=\'center\'><font size=\'+5\'><b>History of Pyke</b></font>       <font size=\'-5\'>(Page 11 of 11)</font></p>\nOver time, as the army\'s top generals became old and died, Dred felt comfortable enough to do away with martial law all together and grant independent merchants the right to trade inside Kukubia.";
         this.strings["frm_History_text_2_1"] = "<p align=\'center\'><font size=\'+5\'><b>History of Mira</b></font>       <font size=\'-5\'>(Page 1 of 8)</font></p>\nAs far back as 1,000 B.B., Mira was awash in religious and spiritual energy.  The native creatures of Mira, the Quaso Mutta, are gelatinous blobs who spend days sitting on the green sandstone plains vibrating with Jaalesh (spiritual energy).  Their life is spent communicating in silence to the non-material world.\n\nThe Quaso Mutta would have gone on in their silent prayers uninterrupted if it had not been for one man, Lily Slimwagon.";
         this.strings["frm_History_text_2_2"] = "<p align=\'center\'><font size=\'+5\'><b>History of Mira</b></font>       <font size=\'-5\'>(Page 2 of 8)</font></p>\nIn 490 B.B., after being released from an Imperial Mental Institution, Lily Slimwagon, the infamous colonizer, claimed that he had received telepathic messages calling him back to Kukubia.\n\nAgainst Imperial orders, which forbade him from ever setting foot in Kukubia again, Lily organized an expedition to return to the Colonies.";
         this.strings["frm_History_text_2_3"] = "<p align=\'center\'><font size=\'+5\'><b>History of Mira</b></font>       <font size=\'-5\'>(Page 3 of 8)</font></p>\nLily\'s ill-fated expedition made several blunders, and he nearly starved to death before arriving on Mira.\n\nThere Lily encountered the Quaso Mutta.  These strange, silent creatures vibrating on the barren sandstone filled Lily with awe.  Unable to control his emotions, he broke down and wept begging them to forgive him for his past sins.  Of course, the Quaso Mutta ignored Lily\'s ranting and raving, but this didn\'t make a difference.";
         this.strings["frm_History_text_2_4"] = "<p align=\'center\'><font size=\'+5\'><b>History of Mira</b></font>       <font size=\'-5\'>(Page 4 of 8)</font></p>\nLily had found what he was looking for.  Lily proclaimed Mira the holiest planet in all of Gogg.\n\nAfter repairing his damaged ship, Lily began his long journey around the galaxy preaching the holy word of the Quaso Mutta.  Soon thousands of pilgrims began travelling to Mira in search of these mystical vibrating creatures.  The word spread, and the planet became known as a holy spot.  Churches began to spring up all over Mira.";
         this.strings["frm_History_text_2_5"] = "<p align=\'center\'><font size=\'+5\'><b>History of Mira</b></font>       <font size=\'-5\'>(Page 5 of 8)</font></p>\nVarious religious orders took form.  Some of the orders preached the art of meditation, while others sought to use the Quaso Mutta as oracles to predict the future.\n\nThe most renowned of the sects was the Grand Sages of Mira, who interpreted the vibrations of the Quaso Mutta to predict such famous events as Bass Nicolson\'s victory over the Pirates of Zile and the downfall of the Hapa Jillo Empire.\n\nOf course, for the Quaso Mutta, none of this mattered.";
         this.strings["frm_History_text_2_6"] = "<p align=\'center\'><font size=\'+5\'><b>History of Mira</b></font>       <font size=\'-5\'>(Page 6 of 8)</font></p>\nAfter years of preaching and travelling, Lily finally returned to Mira.  Only Mira had changed.  It was no longer the serene, quiet home of the Quaso Mutta.  It was now a bustling planet filled with thousands of pilgrims, temples and shrines.\n\nBecause of the rapid change in the ecology of Mira, the majority of the Quaso Mutta silently died off.  The few Quaso Mutta left alive were kept locked inside the churches as sacred oracles.";
         this.strings["frm_History_text_2_7"] = "<p align=\'center\'><font size=\'+5\'><b>History of Mira</b></font>       <font size=\'-5\'>(Page 7 of 8)</font></p>\nThe sight of all this made Lily suddenly realize that he had succeeded in destroying another civilization.  In his horror, he fled Mira promising never to return to Kukubia again.\n\nMira continued to grow in popularity until it became a sort of institution throughout Gogg.  Even Supreme Commander Dred Nicolson now pays his respects to the Sages of Mira and asks for advice on everything from personal matters to politics.";
         this.strings["frm_History_text_2_8"] = "<p align=\'center\'><font size=\'+5\'><b>History of Mira</b></font>       <font size=\'-5\'>(Page 8 of 8)</font></p>\nUnlike most of the other cults and religious sects, the Grand Sages were truly compassionate and learned monks.  It is only because of the Grand Sages that the Quaso Mutta were not totally wiped out.\n\nThe Grand Sages took the time to learn from and understand the Quaso Mutta.  This became the source of the Grand Sages power, and it enabled them to obtain an insight into how the non-material universe functions and the ability to influence the course of future events.";
         this.strings["frm_History_text_3_1"] = "<p align=\'center\'><font size=\'+5\'><b>History of Stye</b></font>       <font size=\'-5\'>(Page 1 of 6)</font></p>\nIn 103 B.B., after the death of the great Bass Nicolson (Emperor Dred\'s grandfather), the Kukubian system was still forbidden to all but government spacecraft.  This was to prevent the re-emergence of pirates and other dangerous forces.  Although trade was limited, a few planets in Kukubia began to develop significant economies.\n\nOne of those was Stye, which rapidly grew into the financial capital of Kukubia.";
         this.strings["frm_History_text_3_2"] = "<p align=\'center\'><font size=\'+5\'><b>History of Stye</b></font>       <font size=\'-5\'>(Page 2 of 6)</font></p>\nStye was primarily populated by Soan Yatics, industrious and highly intellectual creatures who love money.\n\nThe Soan Yatics set up an ingenious system for transferring money across the galaxy using light wave emulation and communications technology.  Then the Soan Yatics transformed Stye into a tax haven, and banks began to relocate to the planet.";
         this.strings["frm_History_text_3_3"] = "<p align=\'center\'><font size=\'+5\'><b>History of Stye</b></font>       <font size=\'-5\'>(Page 3 of 6)</font></p>\nThe Soan Yatics took the excess capital and began investing it in local cities and institutions.\n\nOne of these institutions was the Traders\' Union, which was instrumental in lobbying the Imperial Cabinet to open up Kukubia to independent merchants.  The Traders\' Union set up strict banking and trading regulations detailing how commerce would function in Kukubia once trade by independent merchants was established.";
         this.strings["frm_History_text_3_4"] = "<p align=\'center\'><font size=\'+5\'><b>History of Stye</b></font>       <font size=\'-5\'>(Page 4 of 6)</font></p>\nThese rules and large amounts of investment capital reassured the skittish government that opening up Kukubia to private trading companies was in everyone\'s best interest.\n\nThus, when the government finally relaxed its stringent trade laws, the Traders\' Union took on the responsibility of financing most of the start-up companies and regulating all transactions.  This self-regulation helped to minimize government interference in the Kukubian market.";
         this.strings["frm_History_text_3_5"] = "<p align=\'center\'><font size=\'+5\'><b>History of Stye</b></font>       <font size=\'-5\'>(Page 5 of 6)</font></p>\nToday, Stye remains the financial center of the Kukubian system.  Almost all money flowing between Kukubia and the rest of the Galaxy of Gogg passes through Stye.\n\nThis has made the Soan Yatics wealthy and powerful.  They often wield more power over Kukubia than the Supreme Commander Dred Nicolson himself.";
         this.strings["frm_History_text_3_6"] = "<p align=\'center\'><font size=\'+5\'><b>History of Stye</b></font>       <font size=\'-5\'>(Page 6 of 6)</font></p>\nThe only difference is that the Soan Yatics operate discreetly without alerting anyone to their activities, while the brash Dred Nicolson makes a big deal out of every law or regulation he comes up with.\n\nThis means that often what the general population believes to be Imperial Mandates are actually the work of the Soan Yatics and their powerful lobbyists operating behind the scenes.";
         this.strings["frm_History_text_4_1"] = "<p align=\'center\'><font size=\'+5\'><b>History of Loro</b></font>       <font size=\'-5\'>(Page 1 of 5)</font></p>\nLoro became known as the Pleasure Planet because of the genius of Peelia Veelia, the leader of the Mamo Wuzzies.\n\nMamo Wuzzies are a race of bulky, energetic creatures who inhabited Loro before humans ever set foot in Kukubia.  Peelia Veelia saw the expansion of the New Realm as the perfect opportunity to satisfy her subject\'s basic needs.  You see, Mamo Wuzzies crave one thing in life, and that is stimulation.";
         this.strings["frm_History_text_4_2"] = "<p align=\'center\'><font size=\'+5\'><b>History of Loro</b></font>       <font size=\'-5\'>(Page 2 of 5)</font></p>\nMamo Wuzzies continually seek out new experiences, experimenting with everything they can get their sticky little hands on.\n\nFor example, if a new type of food is discovered, everyone rushes out to try it that very day.  However, within a week, a new fad takes over.  The most popular hairdo on Loro was only around for 13 days before it went out of style.";
         this.strings["frm_History_text_4_3"] = "<p align=\'center\'><font size=\'+5\'><b>History of Loro</b></font>       <font size=\'-5\'>(Page 3 of 5)</font></p>\nThis is why in 286 B.B., when Supreme Commander Bass Nicolson (Dred\'s grandfather) lead the Imperial Forces to Loro, he discovered a civilization unlike anything he had known before.\n\nThe Mamo Wuzzies embraced Bass and his soldiers with unparalleled enthusiasm.  They just couldn\'t get enough of the strange invaders and invited them to endless parties, celebrations, feasts and festivals.";
         this.strings["frm_History_text_4_4"] = "<p align=\'center\'><font size=\'+5\'><b>History of Loro</b></font>       <font size=\'-5\'>(Page 4 of 5)</font></p>\nBass\' army found the Mamo Wuzzies fascinating as they constantly provided new sources of amusement.\n\nAs the Mamo Wuzzies entertained the soldiers, they continually sought out information about the Galaxy of Gogg and tried to learn everything they could from their visitors.  Peelia Veelia used this opportunity to convince Bass Nicolson to allow her to set up a galaxy-wide entertainment center.";
         this.strings["frm_History_text_4_5"] = "<p align=\'center\'><font size=\'+5\'><b>History of Loro</b></font>       <font size=\'-5\'>(Page 5 of 5)</font></p>\nPeelia Veelia persuaded Bass that this would be mutually beneficial.  It would provide much-needed entertainment for the population of Gogg, create an additional source of tax revenue for the Imperial Government, and guarantee her people a constant source of stimulation.\n\nSeeing the great potential, Bass Nicolson agreed to help Peelia Veelia.  Thus, Loro became Gogg\'s best known resort destination.";
         this.strings["frm_History_text_5_1"] = "<p align=\'center\'><font size=\'+5\'><b>History of Zile</b></font>       <font size=\'-5\'>(Page 1 of 8)</font></p>\nZile was colonized in 430 B.B. by a notorious pirate clan from Outer Glosser.\n\nThe leader of the clan, Bro Nap Goodshark, was an unscrupulous smuggler who dealt primarily in weapons and Agmal Juice.  The Imperial Government was hot on his trail, and he knew if he didn\'t leave Outer Glosser soon, the government would catch and hang him.  Zile seemed to be the perfect place to hide out and set up a new operation.";
         this.strings["frm_History_text_5_2"] = "<p align=\'center\'><font size=\'+5\'><b>History of Zile</b></font>       <font size=\'-5\'>(Page 2 of 8)</font></p>\nOfficially, the Kukubian system was still outside the New Realm.  Only two small colonies had been established inside Kukubia.\n\nWhen Bro Nap Goodshark landed on Zile, he quickly cut a deal with the local inhabitants, the Fez Fa Fa, a group of scab-ridden, green and yellow orifices with an appetite for animal flesh.  Bro Nap agreed to feed the Fez Fa Fa live humans and other choice creatures if they left him and his clan alone.";
         this.strings["frm_History_text_5_3"] = "<p align=\'center\'><font size=\'+5\'><b>History of Zile</b></font>       <font size=\'-5\'>(Page 3 of 8)</font></p>\nEver hungry for fresh flesh, the Fez Fa Fa agreed.  Bro Nap and his motley pirates hunted down defenseless cargo ships, stole their goods, and took the crews back to Zile as Fez Fa Fa food.\n\nFor the next 80 years, Bro Nap and his pirate clan operated with impunity attacking thousands of merchant ships.";
         this.strings["frm_History_text_5_4"] = "<p align=\'center\'><font size=\'+5\'><b>History of Zile</b></font>       <font size=\'-5\'>(Page 4 of 8)</font></p>\nAt the time, the New Realm was engaged in an all-out war with the Hapa Jillos from the Galaxy of Pata Pata Pita and could not spare the resources to go after Bro Nap.\n\nHowever, as soon as the Great Bass Nicolson (Emperor Dred\'s grandfather) defeated the Hapa Jillos, he focused all his attention on the internal problems of Gogg.\n\nBass Nicolson moved to expand the New Realm to include outlying territories like Kukubia.";
         this.strings["frm_History_text_5_5"] = "<p align=\'center\'><font size=\'+5\'><b>History of Zile</b></font>       <font size=\'-5\'>(Page 5 of 8)</font></p>\nHis goal was to guarantee safety and prosperity to all inhabitants of the galaxy.\n\nIn 349 B.B. Bass Nicolson\'s forces came head to head with Bro Nap\'s pirates in a bloody 8-year war.  The turning point was when the Fez Fa Fa broke off their alliance with Bro Nap and joined with the forces of Bass Nicolson to drive the pirates from Zile.";
         this.strings["frm_History_text_5_6"] = "<p align=\'center\'><font size=\'+5\'><b>History of Zile</b></font>       <font size=\'-5\'>(Page 6 of 8)</font></p>\nAfter Bro Nap was killed defending his hoard of treasure, his clan split apart, and its members fled in all directions.  With Bass Nicolson\'s help, the Fez Fa Fa were moved to sanctuaries and fed a constant diet of livestock.\n\nToday they are considered relatively harmless, except for the occasional tourist who disappears around special Fez Fa Fa holidays.";
         this.strings["frm_History_text_5_7"] = "<p align=\'center\'><font size=\'+5\'><b>History of Zile</b></font>       <font size=\'-5\'>(Page 7 of 8)</font></p>\nUnder the new laws, only government ships were allowed to operate inside Kukubia.\n\nOld merchant families like Mr. Zinn\'s were permitted to set up businesses on each planet, but they were forbidden from owning or operating spacecraft of any kind.  This was necessary to keep control over the system and prevent the re-emergence of pirate activity.  It is only recently that Dred Nicolson opened up Kukubia to limited trade.";
         this.strings["frm_History_text_5_8"] = "<p align=\'center\'><font size=\'+5\'><b>History of Zile</b></font>       <font size=\'-5\'>(Page 8 of 8)</font></p>\nYour company and a few other small trading firms are the first ones to be permitted to operate freely within the Colonies.  In order to prevent any one company from monopolizing the market, the Traders\' Union has limited the amount Mr. Zinn and the other wealthy merchant families are allowed to invest.\n\nBecause of these restrictions, you and your competitors stand a good chance to make big bucks and expand with the growing Kukubian economies.";
         this.strings["frm_History_text_6_1"] = "<p align=\'center\'><font size=\'+5\'><b>History of Frac</b></font>       <font size=\'-5\'>(Page 1 of 10)</font></p>\nFrac was the first planet in the Kukubian system to be colonized.\n\nSir Lily Slimwagon, a fearless and somewhat eccentric explorer, arrived on Frac in 551 B.B., during the reign of Supreme Commander Bass Nicolson (Dred\'s grandfather).  He found a lush, tropical planet inhabited by Veggie Piddles, intelligent vegetable creatures who thrived on vine juice and lemon pudding.";
         this.strings["frm_History_text_6_2"] = "<p align=\'center\'><font size=\'+5\'><b>History of Frac</b></font>       <font size=\'-5\'>(Page 2 of 10)</font></p>\nInstead of brutally forcing these little green beans into submission, which was the modus operandi of the time, Lily decided to wage a war of words.  Starting the next day, Lily and his army began jabbering away in a language the leafy creatures could not possibly understand.\n\nThe Veggies soon became so sick of listening to Lily and his soldiers babble that they decided to join the New Realm, if only to shut them up.";
         this.strings["frm_History_text_6_3"] = "<p align=\'center\'><font size=\'+5\'><b>History of Frac</b></font>       <font size=\'-5\'>(Page 3 of 10)</font></p>\nAs a gesture of gratitude toward their new Veggie brothers, Lily decreed that everyone (including himself and his soldiers) should pay tribute to the Veggie Piddles by eating nothing but lemon pudding, drinking wine of the vine, and wearing bright yellow clothing at all times.\n\nAt first this made for good foreign relations.  However, when Lily saw that the Veggie Piddles appreciated his gesture, he decided to take it one step further.";
         this.strings["frm_History_text_6_4"] = "<p align=\'center\'><font size=\'+5\'><b>History of Frac</b></font>       <font size=\'-5\'>(Page 4 of 10)</font></p>\nLily declared that yellow must be present in the consciousness of all citizens of Frac at all times.  He ordered all streets, buildings, cars and spacecraft painted yellow.  If anyone was caught sporting a color other than yellow, they would be banished from the planet for eternity.\n\nOf course, the Veggie Piddles were aghast at this new law, but they didn\'t know what to say since the law was made in an effort to please them.";
         this.strings["frm_History_text_6_5"] = "<p align=\'center\'><font size=\'+5\'><b>History of Frac</b></font>       <font size=\'-5\'>(Page 5 of 10)</font></p>\nAs the Veggie Piddles watched in horror, Lily and his soldiers began painting everything bright yellow, including the grass, trees, flowers, insects and every animal they could catch.\n\nSoon the entire planet was covered with a sickly coat of yellow paint.  Lily was so overtaken with his grand gesture that he was blind to what was happening to the planet.";
         this.strings["frm_History_text_6_6"] = "<p align=\'center\'><font size=\'+5\'><b>History of Frac</b></font>       <font size=\'-5\'>(Page 6 of 10)</font></p>\nTo celebrate the occasion, Lily decided to throw a massive party in honor of the Veggies.\n\nAs Lily prepared for this glorious event to celebrate Frac\'s union with the New Realm, a strange thing was taking place.  The toxins from the imported yellow paint began to penetrate all the plants and animals.  Within a matter of days, the lush green (yellow) landscape started to disappear.";
         this.strings["frm_History_text_6_7"] = "<p align=\'center\'><font size=\'+5\'><b>History of Frac</b></font>       <font size=\'-5\'>(Page 7 of 10)</font></p>\nThe Veggie Piddles scrambled to scrape the yellow paint off everything, but it was too late.  The planet was dying.  Lily and his soldiers couldn\'t understand why the Veggie Piddles were refusing to join in the celebration.\n\nIt was only after a week of wild merrymaking that it dawned on Lily something was wrong.  By that time most of the planet was dying.  Seeing the destruction he had caused, Lily became overwhelmed with grief.";
         this.strings["frm_History_text_6_8"] = "<p align=\'center\'><font size=\'+5\'><b>History of Frac</b></font>       <font size=\'-5\'>(Page 8 of 10)</font></p>\nHe had single-handedly destroyed an entire civilization when all he wanted to do was to help them.  In the midst of a nervous breakdown, Lily was dragged off the dying planet and committed to an Imperial Mental Institution.\n\nAs time passed, the atrocities were forgotten and Frac was transformed into a thriving commercial zone.";
         this.strings["frm_History_text_6_9"] = "<p align=\'center\'><font size=\'+5\'><b>History of Frac</b></font>       <font size=\'-5\'>(Page 9 of 10)</font></p>\nUnder the powerful rule of Supreme Commander Bass Nicolson (Dred\'s grandfather), the New Realm expanded into Kukubia, and Frac became a crucial trading center.\n\nNow it is home to numerous commercial institutions such as Gizzy Shipping, Roke Transport and Voyager\'s Insurance Company.\n\nHowever, even to this day, Lily\'s legacy exists.  Frac has never regained its tropical forests.";
         this.strings["frm_History_text_6_10"] = "<p align=\'center\'><font size=\'+5\'><b>History of Frac</b></font>       <font size=\'-5\'>(Page 10 of 10)</font></p>\nFrac is still a stark desert planet, and without their supply of vine juice and lemon pudding, all the Veggie Piddles have long since perished.\n\nThe only testament to their ancient civilization is the bright yellow sand which covers 90% of the planet.";
         this.strings["frm_History_text_7_1"] = "<p align=\'center\'><font size=\'+5\'><b>History of Tilo</b></font>       <font size=\'-5\'>(Page 1 of 5)</font></p>\nTilo is the only planet in the Kukubian System with legalized gambling.  Supreme Commander Dred Nicolson detests gambling and has outlawed casinos in most major cities.\n\nEmperor Dred is opposed to gambling for two reasons.  First, casinos take money away from the general public, and Dred would much rather the public spend its hard earned money on taxes, which go directly to him, than gambling, which lines the pockets of the casino owners.";
         this.strings["frm_History_text_7_2"] = "<p align=\'center\'><font size=\'+5\'><b>History of Tilo</b></font>       <font size=\'-5\'>(Page 2 of 5)</font></p>\nThe second reason for Dred\'s opposition to organized gambling is that 99% of all the casinos in Gogg are controlled by the Hapa Jillo Syndicate, a longtime enemy of the Nicolson Dynasty.\n\nThe Hapa Jillos are a race of highly intelligent and ruthless creatures from the neighboring Galaxy of Pata Pata Pita.\n\nAlthough, the Great Bass Nicolson (Dred\'s grandfather) defeated the Hapa Jillo Empire in 350 B.B. and drove most of the Hapa Jillo population out of Gogg, several million Hapa Jillos remained behind, scattered throughout the galaxy.";
         this.strings["frm_History_text_7_3"] = "<p align=\'center\'><font size=\'+5\'><b>History of Tilo</b></font>       <font size=\'-5\'>(Page 3 of 5)</font></p>\nBecause they were not accepted by society, many turned to lives of crime, including racketeering, money laundering, and running illegal gambling operations.  Some of the small operations grew so prosperous that they literally took over planets like Tilo.\n\nBefore the Nicolson Family realized what was happening, it was too late.  The casinos had become a fixture in certain areas and could not be removed.";
         this.strings["frm_History_text_7_4"] = "<p align=\'center\'><font size=\'+5\'><b>History of Tilo</b></font>       <font size=\'-5\'>(Page 4 of 5)</font></p>\nTypically, whenever Dred tried to shut down a casino, local political leaders and business owners would become so furious that they often threatened a revolt.  Dred decided his next best option was containment.  That is why gambling has been restricted to one or two planets in each system.\n\nIn Kukubia, that planet is Tilo.  If someone wants to gamble, they must travel to Tilo.  In fact, gambling has become such a vital part of Tilo\'s economy that it accounts for 80% of planet\'s revenue.";
         this.strings["frm_History_text_7_5"] = "<p align=\'center\'><font size=\'+5\'><b>History of Tilo</b></font>       <font size=\'-5\'>(Page 5 of 5)</font></p>\nHowever, even on Tilo, gambling is regulated.\n\nNo one is allowed to gamble more than 5% of their total cash in one week.  This was Dred\'s latest effort to curb gambling and gradually erode the power of the Hapa Jillo Syndicate.";
         this.strings["frm_History_text_8_1"] = "<p align=\'center\'><font size=\'+5\'><b>History of Queg</b></font>       <font size=\'-5\'>(Page 1 of 4)</font></p>\nQueg is the infamous renegade planet.  It is here that the galaxy\'s most notorious gangsters come to unload their wares.\n\nEveryone from Scooter Jay to the Baid-Rowel Bandits routinely visit Queg.  A powerful warlord, who goes by the name of Lady Cornucopia, rules the planet and brokers all transactions.\n\nBecause Emperor Dred Nicolson needs Lady Cornucopia in his on-going skirmish with the Hapa Jillos, he tolerates her illicit activities.";
         this.strings["frm_History_text_8_2"] = "<p align=\'center\'><font size=\'+5\'><b>History of Queg</b></font>       <font size=\'-5\'>(Page 2 of 4)</font></p>\nIf Emperor Dred Nicolson had his way, Queg would be firmly under the control of the Imperial Magistrate, all smuggling activities would cease, and every transaction would be heavily taxed.\n\nHowever, Lady Cornucopia commands a large standing army, and she has been using this army as a deterrent against a possible Hapa Jillo invasion.  If she were to become upset with Dred Nicolson and ally herself with the Hapa Jillos, it would literally mean the end of Kukubia as we know it.";
         this.strings["frm_History_text_8_3"] = "<p align=\'center\'><font size=\'+5\'><b>History of Queg</b></font>       <font size=\'-5\'>(Page 3 of 4)</font></p>\nHistory shows that the Hapa Jillo Empire once included all of Kukubia along with a huge portion of western Gogg.\n\nIt is only after the Great Bass Nicolson (Emperor Dred\'s grandfather) gloriously defeated the Hapa Jillo Armada and took full control of Kukubia that the Hapa Jillos retreated back to the neighboring galaxy of Pata Pata Pita.   Although the Hapa Jillos have never regained their former power, they still command a sizable army.";
         this.strings["frm_History_text_8_4"] = "<p align=\'center\'><font size=\'+5\'><b>History of Queg</b></font>       <font size=\'-5\'>(Page 4 of 4)</font></p>\nIn recent years, the Hapa Jillos have become increasingly bold.  They often make raids on outlying planets and merchant ships which stray into their territory.\n\nWe can only hope that the agreement between Lady Cornucopia and Dred Nicolson holds.  Otherwise, Kukubia may become the focal point of a long, destructive war.";
         this.strings["frm_History_text_9_1"] = "<p align=\'center\'><font size=\'+5\'><b>History of Xeen</b></font>       <font size=\'-5\'>(Page 1 of 2)</font></p>\nXeen is one giant junkyard filled with spare parts and brilliant mechanics.\n\nXeen got its start after the Great Bass Nicolson (Emperor Dred Nicolson\'s grandfather) defeated the Hapa Jillo Empire.  Bass needed some place to dump all of his old and battered battle ships.  Since Xeen wasn\'t a very hospitable planet and had no native intelligent life forms, it seemed the natural place for a junk-yard.\n\nAs time went on, everyone began dumping their garbage on Xeen.";
         this.strings["frm_History_text_9_2"] = "<p align=\'center\'><font size=\'+5\'><b>History of Xeen</b></font>       <font size=\'-5\'>(Page 2 of 2)</font></p>\nOut of this trash heap sprung an entire industry focused on repairing and rebuilding machines.  Xeen is now the central location for all ship repairs, upgrades and construction in Kukubia.\n\nThe mechanics on Xeen are so ingenious that they are constantly coming up with new inventions and ways of improving upon existing technology.\n\nThis has made Xeen into a vital part of the Kukubian economy and the only planet where you can find things like a rebuilt toaster that substitutes as a toothbrush.";
         this.strings["frm_History_text_10_1"] = "<p align=\'center\'><font size=\'+5\'><b>History of Ooom</b></font>       <font size=\'-5\'>(Page 1 of 5)</font></p>\nOoom is known throughout the Kukubian System as the Fortune Teller\'s Planet.  This is because the Soothsayers, a mysterious breed of creatures who live only on Ooom, have the uncanny ability to predict the future by scanning one\'s aura for positive or negative energy.\n\nAs far back as 400 B.B., the Great Bass Nicolson (Dred\'s Grandfather) would consult the Soothsayers of Ooom before entering into any battle.  This may account in part for Bass\' victory over the Hapa Jillo Empire.";
         this.strings["frm_History_text_10_2"] = "<p align=\'center\'><font size=\'+5\'><b>History of Ooom</b></font>       <font size=\'-5\'>(Page 2 of 5)</font></p>\nToday, Ooom is a destination spot for business owners from all over Gogg.  They come to Ooom to find out what their energy level is, so that they know whether or not to purchase insurance, conduct a risky transaction, or make a major business decision.\n\nThe Soothsayers have a reputation for being eccentric.  They will often experiment on their clients, either to try to achieve the best results or just for their own amusement.";
         this.strings["frm_History_text_10_3"] = "<p align=\'center\'><font size=\'+5\'><b>History of Ooom</b></font>       <font size=\'-5\'>(Page 3 of 5)</font></p>\nThe Soothsayer\'s power is believed to stem from some connection between their unique body chemistry and the planet\'s electro-chemical composition.\n\nIn fact, if a Soothsayer is removed from Ooom, not only will they be unable to make a prediction, but they usually perish within a few months.  Their bodies simply cease to function.  No one has been able to figure out why this happens.";
         this.strings["frm_History_text_10_4"] = "<p align=\'center\'><font size=\'+5\'><b>History of Ooom</b></font>       <font size=\'-5\'>(Page 4 of 5)</font></p>\nHowever, a team of scientists, who would like to enable the Soothsayers to travel to other planets, are researching this phenomenon.\n\nOne thing that should be pointed out is that the Soothsayer\'s advice is not set in stone.  In fact, the aura readings are only an indication of what may come.  It is as if they are interpreting statistical data on the probability that good or bad luck will occur.";
         this.strings["frm_History_text_10_5"] = "<p align=\'center\'><font size=\'+5\'><b>History of Ooom</b></font>       <font size=\'-5\'>(Page 5 of 5)</font></p>\nIf a Soothsayer says your aura is positive and you will have good fortune, this actually means your chances of having good fortune far outweigh your chances of experiencing bad luck.\n\nHowever, there is still a small chance that you may run into an unfavorable situation despite a rather positive reading.";
         this.strings["frm_History_text_11_1"] = "<p align=\'center\'><font size=\'+5\'><b>History of Hork</b></font>       <font size=\'-5\'>(Page 1 of 3)</font></p>\nThe planet Hork is named after Emperor Hork Nicolson (Emperor Dred Nicolson\'s father).\n\nHork Nicolson originally saw this planet as the hub of his propaganda machine.  At the time, he was losing control of the Kukubian Colonies and was in need of help.  The only problem was that Hork Nicolson was not nearly as intelligent as his father, the Great Bass Nicolson, and his efforts at regulating all media and cramming political slogans down everyone\'s throat only made the rebellious colonies even more upset.";
         this.strings["frm_History_text_11_2"] = "<p align=\'center\'><font size=\'+5\'><b>History of Hork</b></font>       <font size=\'-5\'>(Page 2 of 3)</font></p>\nAfter Emperor Hork was assassinated by his own cabinet, the entire New Realm began to disintegrate.\n\nWith this collapse came new liberties.  For the first time in the Nicolson Dynasty, the media had complete freedom of speech.  Consequently, planet Hork began to flourish as a cultural and artistic center.  In those few years, the print, TV and film industries blossomed.\n\nIt wasn\'t until the reinstatement of Dred Nicolson to the throne that things began to tighten up again.";
         this.strings["frm_History_text_11_3"] = "<p align=\'center\'><font size=\'+5\'><b>History of Hork</b></font>       <font size=\'-5\'>(Page 3 of 3)</font></p>\nToday, the media is still much freer than in the time of Emperor Hork, but there are certain lines journalists dare not cross.\n\nThese regulations, however, have not prevented the planet Hork from retaining its place as the media capital of the Colonies.  It is presently where 90% of Kukubia\'s films, TV shows, magazines and newspapers are produced.\n\nIf a business needs some publicity, planet Hork is the place to be.";
         this.strings["frm_History_text_12_1"] = "<p align=\'center\'><font size=\'+5\'><b>History of Bass</b></font>       <font size=\'-5\'>(Page 1 of 3)</font></p>\nBass is named after the Great Bass Nicolson (Dred Nicolson\'s grandfather).\n\nAfter Bass Nicolson defeated the Hapa Jillo Empire and the Pirates of Zile, he began transporting all of the treasures he had plundered and pillaged to this planet.\n\nAlong with these treasures came a legion of accountants, merchants and financial types, whose duty it was to catalog everything, sell off the valuable items, and invest the profits in emerging markets throughout the galaxy.";
         this.strings["frm_History_text_12_2"] = "<p align=\'center\'><font size=\'+5\'><b>History of Bass</b></font>       <font size=\'-5\'>(Page 2 of 3)</font></p>\nTo facilitate this huge transfer of wealth, the first Galactic Stock Exchange was established.  It tracked markets all across the New Realm, set up branch offices on every major planet, and created numerous new investment opportunities.  This influx of wealth fueled the growth of colonies like Kukubia.\n\nStock brokers, market analysts and traders congregated on Bass to exchange information and plan their investment strategies.";
         this.strings["frm_History_text_12_3"] = "<p align=\'center\'><font size=\'+5\'><b>History of Bass</b></font>       <font size=\'-5\'>(Page 3 of 3)</font></p>\nAfter the original treasures were all sold, the importance of the Galactic Stock Exchange declined.  By this time, other stock exchanges had sprung up all across the Galaxy of Gogg.  Thus, the Galactic Stock Exchange had to be renamed the Kukubian Stock Exchange, and its main focus became the 7 planets of the Kukubian System.\n\nToday, if an investor wants advice on the Kukubian market, Bass is the best place to go.";
         this.strings["frm_History_text_13_1"] = "<p align=\'center\'><font size=\'+5\'><b>History of Nosh</b></font>       <font size=\'-5\'>(Page 1 of 3)</font></p>\nThe Quaso Mutta have revealed that millions of years ago, Nosh used to be a small star.  The planet was literally a ball of fire, fueled by its own super-heated core.\n\nHowever, when a rare solar snow storm collided with the planet, showering it with ice, the fire on the planet\'s surface was extinguished.  The planet naturally cooled over the next million years, leaving behind huge fuel reservoirs.\n\nThat fuel is what drove the initial expansion of the New Realm and helped to make Kukubia into a thriving colony.";
         this.strings["frm_History_text_13_2"] = "<p align=\'center\'><font size=\'+5\'><b>History of Nosh</b></font>       <font size=\'-5\'>(Page 2 of 3)</font></p>\nThe irony is that today Nosh doesn\'t produce enough fuel to meet its own needs and must import 99% of its energy.\n\nJust a hundred years ago, Nosh was actually producing most of the fuel consumed in the western half of Gogg.  However, this natural resource was so recklessly managed that within a short time the planet went dry.\n\nToday, all fuel must be imported to Kukubia using large tankers.  This accounts, in part, for the high fuel prices and erratic supply.";
         this.strings["frm_History_text_13_3"] = "<p align=\'center\'><font size=\'+5\'><b>History of Nosh</b></font>       <font size=\'-5\'>(Page 3 of 3)</font></p>\nWhen a fuel tanker enters Kukubia, it typically lands on Nosh, where the raw fuel is unloaded, refined and stored.\n\nIn most parts of Kukubia, the price of fuel is fixed.  However, on Nosh, you can almost always find a wholesaler, who will sell you the fuel at a discounted price.\n\nThis is why most merchant ships have incorporated Nosh into their trade routes.";
         this.strings["frm_History_help_1"] = "The <b>History of ";
         this.strings["frm_History_help_2"] = "</b> provides a detailed history of this planet.\n\nTo read about the other planets, you must first travel to those planets.";
         this.strings["frm_Time_text_header"] = "Ministry of Time";
         this.strings["frm_Time_text_1"] = "As you may have guessed, Kukubians go by the kuku clock, which was invented by Mono Cheezo, the first King of Kukubia.\n\nBecause he had nothing better to do, Mono Cheezo declared that one kuku day should equal the time it takes a cup of Bool Juice to evaporate from a freshly opened Bool Nut shell (which equals the time it takes light to travel 18.6 billion miles).";
         this.strings["frm_Time_text_2"] = "This is in contrast to a typical earth day, which is equal to the time it takes light to travel 16.07 billion miles.\n\nAnother unique feature of Kukubian time is that it follows the Nicolsonian Time Tables, a testament to Emperor Dred Nicolson\'s supreme ego\n\nIf you haven\'t already noticed, the kuku calendar begins with the year 0 A.B.  This is because Emperor Dred decided that the most important day in history is the day he was born. \n\nThe A.B. stands for <font color=\'#91FF4B\'><b>After</b></font> the <font color=\'#91FF4B\'><b>Birth</b></font> of Supreme Commander Dred Nicolson.";
         this.strings["frm_Time_text_3"] = "On the same token, any event that occurred before Emperor Dred was born is referred to as B.B. (<font color=\'#91FF4B\'><b>Before</b></font> the <font color=\'#91FF4B\'><b>Birth</b></font>).\n\nA quick historical overview goes as follows:  Bass Nicolson (Emperor Dred\'s grandfather) ruled Gogg from 600 B.B. until 103 B.B., then Hork Nicolson (Bass\' son) took power and ruled from 103 B.B. until 3 A.B., when he was assassinated.\n\nFrom 3 A.B. until 24 A.B., there was chaos in the Imperial Government.  Then in 24 A.B. the military intervened and reinstated Dred Nicolson to the throne.";
         this.strings["frm_Time_text_4_1"] = "According to our records you are <font color=\'#91FF4B\'><b>";
         this.strings["frm_Time_text_4_2"] = " kuku years old</b></font> (don\'t worry, most Kukubians live to be well over 500).\n\nThe date is ";
         this.strings["frm_Time_text_4_3"] = " A.B., and your trading company has been in business ";
         this.strings["frm_Time_text_4_4"] = " kuku weeks.\n\nEvery time you want to trade commodities between two planets, it takes approximately one kuku week of your valuable time.  On average you spend between 16 and 48 kuku hours travelling from one planet to another and 5 kuku days conducting business on the planet.";
         this.strings["frm_Time_text_5"] = "One final piece of trivia... other systems in the Galaxy of Gogg begin their calendars with the Supreme Commander\'s wedding day, or the first time the Supreme Commander hunted wild space snakes, or any other day the Supreme Commander deems important.\n\nThe only problem with this method is that it becomes very confusing when you are travelling from system to system.\n\nFortunately, for this game, you will not have to leave the Kukubian solar system.";
         this.strings["frm_Time_help"] = "The <b>Ministry of Time</b> provides you with background information on how time functions in the Kukubian system.";
