         this.strings["frm_AboutGaz_text"] = "<p align=\'center\'><font size=\'+5\'><b>About Gazillionaire</b></font></p>\n<b>Gazillionaire</b>\n© 1994 - 2020 LavaMind LLC.  All rights reserved.\n\nProduced by Naomi Kokubo\n\nProgrammed by Adrian Tymes and Skylar Hoffman\n\nUI by Naomi Kokubo\n\nArt by Steven Hoffman &amp; Naomi Kokubo\n\nContributing Artists &amp; Musicians:\n     Judy Wilson\n     Rhode Montijo\n     Mikako Endo\n     Alex Igoudin\n\n<b>Original Version</b>\n\nDesigned &amp; Produced by\n     Steven Hoffman\n     Naomi Kokubo\n\nWritten & Programmed by Steven Hoffman";
