         this.strings["frm_NewOrContinue_sound_off"] = "No Sound";
         this.strings["frm_NewOrContinue_sound_less"] = "Best Sound";
         this.strings["shared_means_online"] = "<p align=\'center\'><font size=\'+5\'><b>Group Games</b></font></p>\nGroup Games are multiplayer games, where up to 6 human players can compete in a turn-based game.\n\nGroup Games can only be played online. To join a Group Game, search for Gazillionaire and try the online version!";
         this.strings["register_for_saved_games"] = "In order to save your game, you must register an account.  Please use a valid email address, as we will send a message to it with instructions on how to confirm.";
         this.strings["register_for_shared_games"] = "In order to play group games, you must register an account.  Please use a valid email address, as we will send a message to it with instructions on how to confirm.";
         this.strings["abandon_game_new_game"] = "<p align=\'center\'><font size=\'+3\'><b>WARNING</b></font></p>\nThis game has not been saved yet.  If you start a new game now, you will lose the current game.\n\nAre you sure you want to start a new game?";
         this.strings["abandon_game_load_game"] = "<p align=\'center\'><font size=\'+3\'><b>WARNING</b></font></p>\nThis game has not been saved yet.  If you load a new game now, you will lose the current game.\n\nAre you sure you want to load a new game?";
         this.strings["overwrite_save_game"] = "<p align=\'center\'><font size=\'+3\'><b>WARNING</b></font></p>\nThere is already a game saved in this slot.\n\nAre you sure you want to save over it?";
         this.strings["delete_current_game"] = "Are you sure you want to delete this game?\n\nThis is the game you are playing right now.";
         this.strings["delete_game"] = "Are you sure you want to delete this game?";
         this.strings["resign_current_shared_game"] = "Are you sure you want to resign from this Group Game?\n\nThis is the game you are playing right now.  If you resign, the game will be removed from your account and you will not be able to rejoin it.";
         this.strings["resign_current_game"] = "Are you sure you want to delete this game?\n\nThis is the game you are playing right now.  If you delete this game, it will be removed from your account.";
         this.strings["resign_shared_game"] = "Are you sure you want to delete this Group Game?\n\nIf you delete this game, it will be removed from your account.";
         this.strings["resign_game"] = "Are you sure you want to resign from this game?\n\nIf you do, this game will be removed from your account.";
         this.strings["frm_LavaMind_2_text"] = "<p align=\'center\'><font size=\'+5\'><b>LavaMind</b></font></p>\nGazillionaire was developed by the volcanic brains at LavaMind.  For a long time, we\'ve been designing and developing games, apps and websites.\n\nThe founders of LavaMind believe the process of creating is as important as the final result, and we are looking to work with companies and individuals who share a similar vision.";
         this.strings["frm_LavaMind_3_text"] = "<p align=\'center\'><font size=\'+5\'><b>Zapitalism</b></font></p>\nIn Zapitalism, your goal is to become a retail tycoon by taking a small store and growing a business empire.\n\nBuild your company from the ground up, open larger stores, and outwit your wiley competitors in a game of super sales and savvy shoppers!\n\nZapitalism has gotten many wonderful reviews:\n\n<b><i>Wonderful off-the-wall fun!</i></b>\n - PC Games Magazine\n\n<b><i>One of the best economic simulations ever</i></b>\n - Games First\n\n<b><i>Challenging gameplay, witty humor!</i></b>\n - CNET\'s Game Center\n\nZapitalism combines beautifully rendered graphic images and a built-in tutorial.  It\'s easy to learn and fun to play.  We\'re sure you will enjoy it!";
         this.strings["frm_LavaMind_4_text"] = "<p align=\'center\'><font size=\'+5\'><b>Profitania</b></font></p>\nProfitania is the final installment in the LavaMind business simulation trilogy.  In this quixotic game, you inhabit a subterranean world, where you run a factory.\n\nThe game revolves around inventing new and ever-more peculiar products that you can sell to the population of the surface world.   You must invest in research and development, secure raw materials, and manufacture the best products in the land.\n\nYou\'ll compete against other players, both human and computer, in a race to become an industrial titan, all the while exploring the vast underworld and interacting with its odd and uninhibited inhabitants.\n\nIf you like Zapitalism, you\'ll love Profitania!";
         this.strings["frm_Level_text"] = "<p align=\'center\'><font size=\'+5\'><b>Beginning the Game</b></font></p>\nIf you\'re a first-time player, we highly recommend playing the <b>Tutorial Game</b>.  In the Tutorial, we introduce new features each turn until you\'re playing the complete game.  Remember, your goal is to become the richest business owner in the galaxy!\n\nKeep in mind that Gazillionaire is a turn-based game, meaning each player takes a turn.  Once everyone has taken a turn, the game advances to the next week.\n\nHave fun building your buinsess empire!";
         this.strings["frm_Level_button_tutorial"] = "Tutorial";
