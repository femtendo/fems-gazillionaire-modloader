         this.strings["frm_Planets_label_2"] = "This region of Kukubia is known for its lush, black scenery and open space.";
         this.strings["frm_Planets_label_3"] = "I don\'t recommend you travel to this part of the galaxy.  Many have lost their hair here.";
         this.strings["frm_Planets_label_4"] = "While passing through this area, Mono Cheezo is rumored to have played hopscotch with his first mate.";
         this.strings["frm_Planets_label_5"] = "Click on the planets to customize the map:";
         this.strings["frm_Planets2_select"] = "Click on a planet to replace ";
         this.strings["frm_Opponents_text"] = "Your Competitors";
         this.strings["frm_Opponent_set_iq_1"] = "The intelligence of ";
         this.strings["frm_Opponent_set_iq_2"] = " can range from 25% to 200%.\n\nCurrently, it intelligence is set to ";
         this.strings["frm_Opponent_set_iq_3"] = "%.";
         this.strings["frm_Opponents_opponent_1"] = "<font size=\'+3\'><b>Gizzy Shipping</b></font>\nFreewheeling & Chaotic";
         this.strings["frm_Opponents_opponent_2"] = "<font size=\'+3\'><b>Trading Corp. IV</b></font>\nBy The Book & Neutral";
         this.strings["frm_Opponents_opponent_3"] = "<font size=\'+3\'><b>Vandergriff Ltd.</b></font>\nCautious Oldguard";
         this.strings["frm_Opponents_opponent_4"] = "<font size=\'+3\'><b>Puffer Inc.</b></font>\nNaive Start-up";
         this.strings["frm_Opponents_opponent_5"] = "<font size=\'+3\'><b>Roke Transport</b></font>\nRisk Taker & Innovative";
         this.strings["frm_Opponents_opponent_6"] = "<font size=\'+3\'><b>Hoff Meister</b></font>\nRuthless & Aggressive";
         this.strings["frm_ChooseShip_name_company"] = "Please name your company:";
         this.strings["frm_ChooseShip_text"] = "Click on the spaceship you wish to purchase:";
         this.strings["frm_ChooseShip_ship_name_1"] = "The Stinger XII";
         this.strings["frm_ChooseShip_ship_name_2"] = "The Fly Catcher";
         this.strings["frm_ChooseShip_ship_name_3"] = "Le Rock";
         this.strings["frm_ChooseShip_ship_name_4"] = "Whaler 2000";
         this.strings["frm_ChooseShip_ship_name_5"] = "Retina";
         this.strings["frm_ChooseShip_ship_name_6"] = "Cerebralis";
         this.strings["frm_ChooseShip_ship_name_7"] = "The Globulizer";
         this.strings["frm_ChooseShip_ship_name_8"] = "Locomotis";
         this.strings["frm_ChooseShip_ship_name_9"] = "Mantagon";
         this.strings["frm_ChooseShip_ship_name_10"] = "Kegger";
         this.strings["frm_ChooseShip_ship_name_11"] = "Worm Shuttle";
         this.strings["frm_ChooseShip_ship_name_12"] = "Squidocity";
         this.strings["frm_ChooseShip2_1_1"] = "The Stinger XII costs ";
         this.strings["frm_ChooseShip2_1_2"] = " kubars and is a speed demon. It comes with a high-powered 7-kuarp engine, requires 4 crew members to operate, and can carry up to 100 tons of cargo and 8 passengers. The one disadvantage is that the fuel tank is only 20 tons.\n\nDo you wish to purchase this ship?";
         this.strings["frm_ChooseShip2_2_1"] = "The Fly Catcher costs ";
         this.strings["frm_ChooseShip2_2_2"] = " kubars and is designed especially for hauling cargo. It can carry up to 120 tons of cargo and comes with a 40-ton fuel tank, a 5-kuarp engine and room for 8 passengers. The one disadvantage is that it requires 5 crew members to operate.\n\nDo you wish to purchase this ship?";
         this.strings["frm_ChooseShip2_3_1"] = "Le Rock costs ";
         this.strings["frm_ChooseShip2_3_2"] = " kubars and is sure to please even the most frugal merchants. It requires only 3 crew members and has a 65-ton fuel tank, a 5-kuarp engine and room for 8 passengers. The one disadvantage is that it can hold only 80 tons of cargo.\n\nDo you wish to purchase this ship?";
         this.strings["frm_ChooseShip2_4_1"] = "Whaler 2000 is a monster of a ship. It costs ";
         this.strings["frm_ChooseShip2_4_2"] = " kubars and can carry up to 130 tons of cargo, 50 tons of fuel and 11 passengers. The disadvantages are that it only has a 2-kuarp engine and requires 6 crew members to operate.\n\nDo you wish to purchase this ship?";
         this.strings["frm_ChooseShip2_5_1"] = "Retina costs ";
         this.strings["frm_ChooseShip2_5_2"] = " kubars and is a sleek, slim ship. It requires only 3 crew members to operate and comes with a 5-kuarp engine, 40-ton fuel tank and 100-ton cargo capacity. The one disadvantage is that it only has room for 6 passengers.\n\nDo you wish to purchase this ship?";
         this.strings["frm_ChooseShip2_6_1"] = "Cerebralis costs ";
         this.strings["frm_ChooseShip2_6_2"] = " kubars and is the industry standard. It comes equipped with 100 tons of cargo capacity, a 5-kuarp engine, a 40-ton fuel tank, 4 crew members and room for 8 passengers.\n\nDo you wish to purchase this ship?";
         this.strings["frm_ChooseShip2_7_1"] = "The Globulizer costs ";
         this.strings["frm_ChooseShip2_7_2"] = " kubars and is incredibly light weight and quick. It has a turbocharged 7-kuarp engine, requires 4 crew members to operate, and comes with a 30-ton fuel tank and seating for 7 passengers. The disadvantage is that it has only an 80-ton cargo bay.\n\nDo you wish to purchase this ship?";
         this.strings["frm_ChooseShip2_8_1"] = "Locomotis costs ";
         this.strings["frm_ChooseShip2_8_2"] = " kubars and is a sturdy workhorse. It requires 4 crew members to operate and comes with a 110-ton cargo bay, a powerful 6-kuarp engine, a 40-ton fuel tank, and room for 5 passengers.\n\nDo you wish to purchase this ship?";
         this.strings["frm_ChooseShip2_9_1"] = "Mantagon costs ";
         this.strings["frm_ChooseShip2_9_2"] = " kubars and is a highly efficient and well-designed merchant ship. It can carry up to 10 passengers, has a 4-kuarp engine, a 40-ton fuel tank, and a 90-ton cargo bay. The nice thing is that it only requires 3 crew members to operate.\n\nDo you wish to purchase this ship?";
         this.strings["frm_ChooseShip2_10_1"] = "Kegger costs ";
         this.strings["frm_ChooseShip2_10_2"] = " kubars and is a massive transport vessel. It can carry up to 150 tons of cargo and 35 tons of fuel, but it only has room for 1 passenger. It requires 2 crew members to operate and comes with a 3-kuarp engine.\n\nDo you wish to purchase this ship?";
         this.strings["frm_ChooseShip2_11_1"] = "Worm Shuttle costs ";
         this.strings["frm_ChooseShip2_11_2"] = " kubars and is a deluxe passenger liner. It can accommodate up to 16 passengers and comes with a speedy 6-kuarp engine and 30-ton fuel tank. The drawbacks are that it requires 12 crew members to operate and has a small 75-ton cargo bay.\n\nDo you wish to purchase this ship?";
         this.strings["frm_ChooseShip2_12_1"] = "Squidocity costs ";
         this.strings["frm_ChooseShip2_12_2"] = " kubars and is a smartly designed freighter. It can carry up to 110 tons of cargo and comes with a 40-ton fuel tank, room for 8 passengers, and a fast 6-kuarp engine. The one disadvantage is that it requires 6 crew members to operate.\n\nDo you wish to purchase this ship?";
         this.strings["frm_ChooseShip3_1"] = "Mr. Zinn, a wealthy and somewhat fickle financier, generously loans you the ";
         this.strings["frm_ChooseShip3_2"] = " kubars necessary to get your company going.\n\nHowever, you must pay Mr. Zinn ";
         this.strings["frm_ChooseShip3_3"] = "% interest per week.\n\nMr. Zinn wishes you the best of luck on your new venture and hopes he will never have to repossess your ship.";
         this.strings["frm_ChooseShip3_all_selected"] = "All human players have selected a ship.  Launching game.";
         this.strings["frm_ChooseShip3_please_wait_for_others_to_select"] = "Once each player has chosen their ship, the game will begin. While you wait, try playing a solo game. Keep in mind, you can click on <b>Load Group Game</b> to see if it\'s your turn.\n\nIt\'s up to each player to notify the next player when their turn has ended. IM works best for staying in touch with other players!";
         this.strings["free_game_turn_limit_reached_demo"] = "Congratulations!  You\'ve <font color=\'#227BFF\'><b>completed the demo version</b></font> of Gazillionaire. This version is limited to <font color=\'#227BFF\'><b>20 turns</b></font>. If you\'d like to play longer, download the <b>Full Version</b> from <b><font color=\'#227BFF\'>www.LavaMind.com</font></b> and enjoy unlimited fun!";
         this.strings["free_game_turn_limit_reached_locked"] = "Congratulations!  You <font color=\'#227BFF\'><b>completed the free version</b></font> of Gazillionaire.  Free games are limited to <b>20 turns</b>.\n\nIf you\'d like to play longer, download the <b>Full Version</b> from <b><font color=\'#227BFF\'>www.LavaMind.com</font></b> and enjoy unlimited fun!";
         this.strings["free_game_turn_limit_reached_online"] = "Congratulations!  You <font color=\'#227BFF\'><b>completed the free version</b></font> of Gazillionaire.  Free games are limited to <b>20 turns</b>.\n\nIf you\'d like to play longer, download the <b>Full Version</b> from <b><font color=\'#227BFF\'>www.LavaMind.com</font></b> and enjoy unlimited fun!";
         this.strings["frm_PlayerTurn_begin_turn"] = "Begin Turn";
         this.strings["frm_PlayerTurn_bankrupt_none"] = "Bankrupt Companies:  none";
         this.strings["frm_PlayerTurn_bankrupt"] = "Bankrupt Companies:\n";
         this.strings["frm_PlayerTurn_status"] = "Status:  ";
         this.strings["frm_PlayerTurn_companytype_1"] = "Trader";
         this.strings["frm_PlayerTurn_companytype_2"] = "Merchant";
         this.strings["frm_PlayerTurn_companytype_3"] = "Business Person";
         this.strings["frm_PlayerTurn_companytype_4"] = "Entrepreneur";
         this.strings["frm_PlayerTurn_rank_week"] = "Week ";
         this.strings["frm_PlayerTurn_exitgame"] = "Exit Game";
         this.strings["frm_PlayerTurn_rank_1_1"] = "The companies are ranked according to their wealth. The first company to reach <font color=\'#77D7FF\'><b>";
         this.strings["frm_PlayerTurn_rank_1_2"] = "</b></font> kubars wins the game!\n";
         this.strings["frm_PlayerTurn_rank_1_3"] = "\n\nGame Difficulty Level:  ";
         this.strings["frm_PlayerTurn_rank_2_1"] = " <b>won the game</b> at the end of last week, by being the first company to reach <b>";
         this.strings["frm_PlayerTurn_rank_2_2"] = " kubars!!!</b> This means the game is now officially over.\n\nCurrent Ranking (this week):\n";
         this.strings["frm_PlayerTurn_rank_2_3"] = "\n\nGame Difficulty Level:  ";
         this.strings["frm_PlayerTurn_rank_3_0"] = "<font color=\'#77D7FF\'><b>";
         this.strings["frm_PlayerTurn_rank_3_1"] = "</b></font> won the game at the end of last week, by being the first company to reach <font color=\'#77D7FF\'><b>";
         this.strings["frm_PlayerTurn_rank_3_2"] = "</b></font> kubars!!!\n\nCurrent Ranking (this week):\n";
         this.strings["frm_PlayerTurn_rank_3_3"] = "\n\nGame Difficulty Level:  ";
         this.strings["frm_WinGame_win"] = " Wins!!!";
         this.strings["frm_WinGame_txt_continue"] = "click to continue";
         this.strings["frm_WinGame2_text_header"] = "Headline News";
         this.strings["frm_WinGame2_1"] = "Big news on the financial front.  <font color=\'#77D7FF\'><b>";
         this.strings["frm_WinGame2_2"] = "</b></font> is the first company in the entire system to attain a net worth above <font color=\'#77D7FF\'><b>";
         this.strings["frm_WinGame2_3"] = "</b></font> kubars!\n\nThis achievement will go down in history as a milestone in Kukubia\'s steady march towards becoming one of the wealthiest colonies in the Galaxy of Gogg.\n\nThe latest word from the capital is that Supreme Commander Dred Nicolson has openly praised the president of ";
         this.strings["frm_WinGame2_5"] = " for contributing more than any other company to Kukubia\'s growth and prosperity.";
         this.strings["frm_WinGame2_6_1_1"] = "The Emperor has even promised to inscribe ";
         this.strings["frm_WinGame2_6_1_2"] = "\'s company logo into the Royal Tub the next time he takes a bath.";
         this.strings["frm_WinGame2_6_2_1"] = "The Emperor has even promised to print ";
         this.strings["frm_WinGame2_6_2_2"] = "\'s company logo on all the napkins in the Royal Palace.";
         this.strings["frm_WinGame2_6_3_1"] = "The Emperor has even promised to send the president of ";
         this.strings["frm_WinGame2_6_3_2"] = " a signed postcard with a picture of the Royal Palace on the front.";
         this.strings["frm_WinGame2_6_4_1"] = "The Emperor has even promised to dedicate his next opera to the president of ";
         this.strings["frm_WinGame2_6_4_2"] = ".";
         this.strings["frm_WinGame2_6_5_1"] = "The Emperor has even promised to inscribe ";
         this.strings["frm_WinGame2_6_5_2"] = "\'s company name on his new pair of sneakers using indelible ink.";
         this.strings["frm_WinGame2_6_6_1"] = "The Emperor has even promised to mention ";
         this.strings["frm_WinGame2_6_6_2"] = " in front of the Royal Senate the next time he makes a speech on the economy.";
         this.strings["frm_WinGame2_6_7_1"] = "The Emperor has even promised to make his chief of security change his name to Mr. ";
         this.strings["frm_WinGame2_6_7_2"] = ".";
         this.strings["frm_WinGame2_6_8_1"] = "The Emperor has even promised to have his Royal Hairdresser name a new hairdo after ";
         this.strings["frm_WinGame2_6_8_2"] = ".";
         this.strings["frm_WinGame2_6_9_1"] = "The Emperor has even promised to have the company\'s name sown into all 794 pair of his royal underwear, so that he never forgets what ";
         this.strings["frm_WinGame2_6_9_2"] = " has done for the Empire.";
         this.strings["frm_WinGame2_6_10_1"] = "The Emperor has even promised to name his first born after the president of ";
         this.strings["frm_WinGame2_6_10_2"] = ".";
         this.strings["frm_WinGame2_7"] = "  This is an honor few ever receive.";
         this.strings["frm_WinGame3_goodbye_header"] = "<font color=\'#91FF4B\'>Game Over</font>";
         this.strings["frm_WinGame3_goodbye"] = "We congratulate you for playing Gazillionaire longer than we ever expected anyone to play.  At this point, we have to say the game is officially over.  Whether or not you have won or lost is no longer relevant.  You are as close to becoming a true Gazillionaire as you will ever be.  It\'s time to take a break and start a new game.\n\nAs a reward for your hard work and dedication, you may now consider yourself an honorary member of the Secret Society of Dred.";
         this.strings["frm_WinGame3_almost_done_header"] = "<font color=\'#91FF4B\'>Game Nearly Over</font>";
         this.strings["frm_WinGame3_almost_done"] = "You have almost completed Gazillionaire!  As soon as one of the players reaches <font color=\'#77D7FF\'><b>ten billion</b></font> kubars, Gazillionaire will come to an end.  This is your final chance to prove yourself.  The first company to reach ten billion kubars will be the ultimate victor!  After that, it\'s time to go outside and get some exercise.\n\nDo you wish to keep playing to this ultimate victory point?";
         this.strings["frm_WinGame3_winner_header"] = "Winner\'s Choice";
         this.strings["frm_WinGame3_winner_1"] = "<font color=\'#77D7FF\'><b>";
         this.strings["frm_WinGame3_winner_2"] = "</b></font> wins the game!\n\nEven though you won, the game is not over yet.  If you keep playing, a new winning point will be established, allowing you to achieve a greater victory.  Do you wish to keep playing?";
         this.strings["frm_WinGame3_loser_header"] = "Loser\'s Choice";
         this.strings["frm_WinGame3_loser_1"] = "<font color=\'#77D7FF\'><b>";
         this.strings["frm_WinGame3_loser_2"] = "</b></font> wins the game!\n\nEven though you lost, it\'s not the end.  If you keep playing, a new winning point will be established, allowing you a chance to redeem yourself.  Do you wish to keep playing?";
         this.strings["frm_PlayerTurn2_stock_crash_1"] = "<p align=\'center\'><font size=\'+5\'><b>Emergency Broadcast</b></font></p>\nThis is an emergency update!  The stock market on planet ";
         this.strings["frm_PlayerTurn2_stock_crash_2"] = " <font color=\'#F05555\'><b>crashed</b></font> today!!!  Everyone who owned shares in the <font color=\'#F05555\'><b>";
         this.strings["frm_PlayerTurn2_stock_crash_3"] = " Exchange</b></font> lost their entire investment.\n\nSupreme Commander Dred Nicolson has intervened and shut down the ";
         this.strings["frm_PlayerTurn2_stock_crash_4"] = " Exchange for one week.  Investors are protesting, but there is no way to recover the lost money.";
         this.strings["frm_PlayerTurn2_stock_fall_1_1"] = "<p align=\'center\'><font size=\'+5\'><b>Financial Update!</b></font></p>\nFinancial analysts across Kukubia are <font color=\'#F05555\'><b>warning</b></font> that the <font color=\'#F05555\'><b>";
         this.strings["frm_PlayerTurn2_stock_fall_1_2"] = " Exchange</b></font> is headed for a crash.";
         this.strings["frm_PlayerTurn2_stock_fall_2_1"] = "<p align=\'center\'><font size=\'+5\'><b>Financial Update!</b></font></p>\nIt is rumored that Mr. Zinn is <font color=\'#F05555\'><b>selling off</b></font> a substantial portion of his investments in the <font color=\'#F05555\'><b>";
         this.strings["frm_PlayerTurn2_stock_fall_2_2"] = " Exchange</b></font>.  Experts predict this rumor may push that Exchange down further.";
         this.strings["frm_PlayerTurn2_stock_fall_3_1"] = "<p align=\'center\'><font size=\'+5\'><b>Financial Update!</b></font></p>\nCorporate investors throughout the galaxy have been <font color=\'#F05555\'><b>unloading</b></font> their shares of the <font color=\'#F05555\'><b>";
         this.strings["frm_PlayerTurn2_stock_fall_3_2"] = " Exchange</b></font>.";
         this.strings["frm_PlayerTurn2_stock_fall_4_1"] = "<p align=\'center\'><font size=\'+5\'><b>Financial Update!</b></font></p>\nSmall investors are flooding the <font color=\'#F05555\'><b>";
         this.strings["frm_PlayerTurn2_stock_fall_4_2"] = " Exchange</b></font> with <font color=\'#F05555\'><b>sell orders</b></font>.";
         this.strings["frm_PlayerTurn2_stock_fall_5_1"] = "<p align=\'center\'><font size=\'+5\'><b>Financial Update!</b></font></p>\nEveryone seems to feel a <font color=\'#F05555\'><b>stock market meltdown</b></font> on planet <font color=\'#F05555\'><b>";
         this.strings["frm_PlayerTurn2_stock_fall_5_2"] = "</b></font> is imminent.";
         this.strings["frm_PlayerTurn2_stock_fall_6_1"] = "<p align=\'center\'><font size=\'+5\'><b>Financial Update!</b></font></p>\nWe have reports that the majority of <font color=\'#F05555\'><b>";
         this.strings["frm_PlayerTurn2_stock_fall_6_2"] = " Exchange</b></font> shareholders have <font color=\'#F05555\'><b>lost all confidence</b></font> in the market.";
         this.strings["frm_PlayerTurn2_stock_fall_7_1"] = "<p align=\'center\'><font size=\'+5\'><b>Financial Update!</b></font></p>\nThe <font color=\'#F05555\'><b>";
         this.strings["frm_PlayerTurn2_stock_fall_7_2"] = " Exchange</b></font> Board of Trustees has called for calm and requested that investors hold onto their shares.\n\nHowever, this has not stemmed the <font color=\'#F05555\'><b>tide of sell orders</b></font>.";
         this.strings["frm_PlayerTurn2_stock_fall_8_1"] = "<p align=\'center\'><font size=\'+5\'><b>Financial Update!</b></font></p>\nThe <font color=\'#F05555\'><b>";
         this.strings["frm_PlayerTurn2_stock_fall_8_2"] = " Exchange</b></font> is in a state of utter confusion as investors pack the floor, scrambling to <font color=\'#F05555\'><b>sell</b></font> their shares.\n\nSome investors have been hiring spaceships at exorbitant prices just to make it there in time to sell off their investments.";
         this.strings["frm_PlayerTurn2_stock_fall_9_1"] = "<p align=\'center\'><font size=\'+5\'><b>Financial Update!</b></font></p>\nA broad-based loss of confidence in the <font color=\'#F05555\'><b>";
         this.strings["frm_PlayerTurn2_stock_fall_9_2"] = " Exchange</b></font> has lead to a <font color=\'#F05555\'><b>major crash</b></font>.\n\nIts Board of Trustees is begging investors to hold onto their shares, but no one seems to be willing to take that chance.";
         this.strings["frm_PlayerTurn2_stock_fall_10_1"] = "<p align=\'center\'><font size=\'+5\'><b>Financial Update!</b></font></p>\nA panic <font color=\'#F05555\'><b>selling spree</b></font> has brought the <font color=\'#F05555\'><b>";
         this.strings["frm_PlayerTurn2_stock_fall_10_2"] = " Exchange</b></font> to its knees.   It\'s only a matter of time before it completely crashes.";
         this.strings["frm_PlayerTurn2_stock_fall_11_1"] = "<p align=\'center\'><font size=\'+5\'><b>Financial Update!</b></font></p>\nIt appears that the <font color=\'#F05555\'><b>";
         this.strings["frm_PlayerTurn2_stock_fall_11_2"] = " Exchange</b></font> is in a <font color=\'#F05555\'><b>free-fall</b></font>.\n\nAnalysts across Kukubia are advising their clients to sell their shares before it\'s too late.";
         this.strings["frm_PlayerTurn2_auction_ship_no_bid"] = "<p align=\'center\'><font size=\'+5\'><b>Auction Cancelled</b></font></p>\nBecause none of the companies placed a bid for the ship, Emperor Dred Nicolson has cancelled this auction.";
         this.strings["frm_PlayerTurn2_auction_ship_tied"] = "<p align=\'center\'><font size=\'+5\'><b>Auction Redo</b></font></p>\nBecause more than one company made exactly the same highest bid, all the companies must bid again for the ship.\n\nAnother auction will be held at the end of this week.";
         this.strings["frm_PlayerTurn2_auction_facility_no_bid"] = "<p align=\'center\'><font size=\'+5\'><b>Auction Cancelled</b></font></p>\nBecause none of the companies placed a bid for the facility, Emperor Dred Nicolson has cancelled this auction.";
         this.strings["frm_PlayerTurn2_auction_facility_tied"] = "<p align=\'center\'><font size=\'+5\'><b>Auction Redo</b></font></p>\nBecause more than one company made exactly the same highest bid, all the companies must bid again for the facility.\n\nAnother auction will be held at the end of this week.";
         this.strings["frm_Travel4_show_sabotage_result_0"] = "Sabotage!";
         this.strings["frm_Travel4_show_sabotage_result_1"] = "Due to sabotage, your ship suffered <font color=\'#F05555\'><b>";
         this.strings["frm_Travel4_show_sabotage_result_2"] = " kubars</b></font> in damage.  The police did not find any proof, but anonymous sources suggest your rivals hired someone to cause this loss.  Whoever did this knew how to exclude the damage from Voyager\'s Insurance coverage.";
         this.strings["frm_Travel4_show_sabotage_result_loan"] = "\n\nFortunately, the Traders\' Union loans you what you need to pay for the loss without hesitation.";
         this.strings["frm_Travel4_auction_ship_0"] = " won the auction!";
         this.strings["frm_Travel4_auction_ship_1"] = " bid highest, purchasing a new, larger ship for ";
         this.strings["frm_Travel4_auction_ship_2a"] = " kubars.\n\nThe next highest was ";
         this.strings["frm_Travel4_auction_ship_2b"] = " kubars.  The next highest was ";
         this.strings["frm_Travel4_auction_ship_3"] = " with a bid of ";
         this.strings["frm_Travel4_auction_ship_4"] = " kubars.";
         this.strings["frm_Travel4_auction_facility_1"] = " won the auction!";
         this.strings["frm_Travel4_auction_facility_3"] = " bid highest, purchasing the ";
         this.strings["frm_Travel4_auction_facility_4"] = " on ";
         this.strings["frm_Travel4_auction_facility_5"] = " for ";
         this.strings["frm_Travel4_auction_facility_6a"] = " kubars.\n\nThe next highest was ";
         this.strings["frm_Travel4_auction_facility_6b"] = " kubars.  The next highest was ";
         this.strings["frm_Travel4_auction_facility_7"] = " with a bid of ";
         this.strings["frm_Travel4_auction_facility_8"] = " kubars.";
         this.strings["frm_Travel4_humanArrives_1"] = " Arrives on ";
         this.strings["frm_Travel4_humanArrives_2"] = " First!";
         this.strings["frm_Travel4_humanArrives_3_1"] = "Sorry, but the early bird gets all the tastiest worms.";
         this.strings["frm_Travel4_humanArrives_3_2"] = "It seems like your ship needs a bigger engine.";
         this.strings["frm_Travel4_humanArrives_3_3"] = "It pays to be first!";
         this.strings["frm_Travel4_humanArrives_3_4"] = "I hope there\'s something left for you.";
