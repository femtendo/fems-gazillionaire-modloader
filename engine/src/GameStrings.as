         this.strings["frm_Quick_button_all"] = "Toggle All";
         this.strings["frm_Quick_help"] = "The <b>Shortcuts</b> menu allows you to speed up the game by cutting down on the number of mouse clicks required to perform routine tasks.\n\nWhen a shortcut is activated, it allows you to pay your crew, fill up your fuel tank, or buy insurance simply by clicking on the appropriate Main Menu button.  This way you can <b>bypass</b> the sub-menus.";
         this.strings["frm_Fuel_button_buy"] = "Buy Fuel";
         this.strings["frm_Fuel_button_fuel_1"] = "Fuel Cost<font size=\'+3\'>\n";
         this.strings["frm_Fuel_button_fuel_2a"] = "LOW ON FUEL";
         this.strings["frm_Fuel_button_fuel_2b"] = "EMPTY";
         this.strings["frm_Fuel_button_fuel_3"] = "Fuel Tank: ";
         this.strings["frm_Fuel_button_fuel_4"] = "%";
         this.strings["frm_Fuel_button_fuel_4_low"] = "% <font color=\'#FF0000\'>LOW ON FUEL</font>";
         this.strings["frm_Fuel_fuel_help_1"] = "Your ship has a ";
         this.strings["frm_Fuel_fuel_help_2"] = "-ton fuel tank and runs on Ionic Fuel, a combination of nuclear and synthetic fuels.\n\nThis fuel costs between <b>";
         this.strings["frm_Fuel_fuel_help_3"] = "</b> and <b>";
         this.strings["frm_Fuel_fuel_help_4"] = "</b> kubars per ton.\n\nEvery time you travel to a planet, your ship consumes between <b>2</b> and <b>";
         this.strings["frm_Fuel_fuel_help_5"] = "</b> tons of fuel.\n\nOn average, the longer the distance travelled and the larger the ship, the more fuel is used.  If you want to save fuel, a good idea is to travel to a nearby planet, rather than one on the other side of Kukubia.";
         this.strings["frm_Fuel_text0a"] = "Your Cash";
