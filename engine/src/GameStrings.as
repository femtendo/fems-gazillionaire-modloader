         this.strings["frm_Travel2_bad_event_11_8_insurance"] = " kubars</b></font> to have them repaired.\n\nLuckily you have <font color=\'#77D7FF\'><b>Voyagers\' Insurance!</b></font>  Your insurance reimburses you in full and replaces damaged items.";
         this.strings["frm_Travel2_bad_event_11_9a"] = "Acid Cloud";
         this.strings["frm_Travel2_bad_event_11_9b"] = "You get caught in a corrosive cloud of Dexxy Gas.  Your ship\'s exterior is badly burned, and you must pay <font color=\'#F05555\'><b>";
         this.strings["frm_Travel2_bad_event_11_10"] = " kubars</b></font> to have it repaired.";
         this.strings["frm_Travel2_bad_event_11_10_insurance"] = " kubars</b></font> to have it repaired.\n\nLuckily you have <font color=\'#77D7FF\'><b>Voyagers\' Insurance!</b></font>  Your insurance reimburses you in full and replaces damaged items.";
         this.strings["frm_Travel2_bad_event_11_11a"] = "Sticky Smacky";
         this.strings["frm_Travel2_bad_event_11_11b"] = "You run smack into a cluster of Mippi Weeds.  Your ship is covered in these sticky organisms, and you must pay <font color=\'#F05555\'><b>";
         this.strings["frm_Travel2_bad_event_11_12"] = " kubars</b></font> to have them removed.";
         this.strings["frm_Travel2_bad_event_11_12_insurance"] = " kubars</b></font> to have them removed.\n\nLuckily you have <font color=\'#77D7FF\'><b>Voyagers\' Insurance!</b></font>  Your insurance reimburses you in full and replaces damaged items.";
         this.strings["frm_Travel2_bad_event_11_13a"] = "Acidic Juice";
         this.strings["frm_Travel2_bad_event_11_13b"] = "You are hit by a stream of acidic Bollup Juice.  This deadly liquid takes a bite out of your ship, and you must pay <font color=\'#F05555\'><b>";
         this.strings["frm_Travel2_bad_event_11_14"] = " kubars</b></font> to have it repaired.";
         this.strings["frm_Travel2_bad_event_11_14_insurance"] = " kubars</b></font> to have it repaired.\n\nLuckily you have <font color=\'#77D7FF\'><b>Voyagers\' Insurance!</b></font>  Your insurance reimburses you in full and replaces damaged items.";
         this.strings["frm_Travel2_bad_event_11_15a"] = "Hazardous Vapor";
         this.strings["frm_Travel2_bad_event_11_15b"] = "Your ship is engulfed in a sea of Wess Vapor.  This radioactive debris contaminates your vessel, and you must pay <font color=\'#F05555\'><b>";
         this.strings["frm_Travel2_bad_event_11_16"] = " kubars</b></font> to have it cleaned.";
         this.strings["frm_Travel2_bad_event_11_16_insurance"] = " kubars</b></font> to have it cleaned.\n\nLuckily you have <font color=\'#77D7FF\'><b>Voyagers\' Insurance!</b></font>  Your insurance reimburses you in full and replaces damaged items.";
         this.strings["frm_Travel2_bad_event_11_17a"] = "Tight Spin";
         this.strings["frm_Travel2_bad_event_11_17b"] = "You get sucked into a giant Stellar Whirlpool.  Your ship is squeezed and crunched, and you must pay <font color=\'#F05555\'><b>";
         this.strings["frm_Travel2_bad_event_11_18"] = " kubars</b></font> to have it rebuilt.";
         this.strings["frm_Travel2_bad_event_11_18_insurance"] = " kubars</b></font> to have it rebuilt.\n\nLuckily you have <font color=\'#77D7FF\'><b>Voyagers\' Insurance!</b></font>  Your insurance reimburses you in full and replaces damaged items.";
         this.strings["frm_Travel2_bad_event_11_19a"] = "Twisted & Deformed";
         this.strings["frm_Travel2_bad_event_11_19b"] = "You get slammed by a Bobble Warp, a dangerous break in the time-space continuum.  By the time you come back out the other end, your ship is all bent out of shape, and you must pay <font color=\'#F05555\'><b>";
         this.strings["frm_Travel2_bad_event_11_20"] = " kubars</b></font> to have it re-shaped.";
         this.strings["frm_Travel2_bad_event_11_20_insurance"] = " kubars</b></font> to have it re-shaped.\n\nLuckily you have <font color=\'#77D7FF\'><b>Voyagers\' Insurance!</b></font>  Your insurance reimburses you in full and replaces damaged items.";
         this.strings["frm_Travel2_bad_event_12_1"] = "Rotten ";
         this.strings["frm_Travel2_bad_event_12_2"] = "One of your crew members discovers that you purchased rotten goods.  You have no choice but to <font color=\'#F05555\'><b>throw out</b></font> ";
         this.strings["frm_Travel2_bad_event_12_3"] = " tons of ";
         this.strings["frm_Travel2_bad_event_12_4"] = ".";
         this.strings["frm_Travel2_bad_event_12_4_insurance"] = ".\n\nLuckily you have <font color=\'#77D7FF\'><b>Voyagers\' Insurance!</b></font>The insurance company replaces all the ";
         this.strings["frm_Travel2_bad_event_12_5_insurance"] = " you had to throw out.";
         this.strings["frm_Travel2_bad_event_12_6"] = "Defective ";
         this.strings["frm_Travel2_bad_event_12_7"] = "One of your crew members discovers that you purchased defective goods.  You have no choice but to <font color=\'#F05555\'><b>throw out</b></font> ";
         this.strings["frm_Travel2_bad_event_12_8"] = " tons of ";
         this.strings["frm_Travel2_bad_event_12_9"] = ".";
         this.strings["frm_Travel2_bad_event_12_9_insurance"] = ".\n\nLuckily you have <font color=\'#77D7FF\'><b>Voyagers\' Insurance!</b></font>  The insurance company replaces all the ";
         this.strings["frm_Travel2_bad_event_12_10_insurance"] = " you had to throw out.";
         this.strings["frm_Travel2_bad_event_12_11"] = "Poor Quality ";
         this.strings["frm_Travel2_bad_event_12_12"] = "One of your crew members discovers that you purchased poor quality goods.  You have no choice but to <font color=\'#F05555\'><b>throw out</b></font> ";
         this.strings["frm_Travel2_bad_event_12_13"] = " tons of the substandard quality ";
         this.strings["frm_Travel2_bad_event_12_14"] = ".";
         this.strings["frm_Travel2_bad_event_12_14_insurance"] = ".\n\nLuckily you have <font color=\'#77D7FF\'><b>Voyagers\' Insurance!</b></font>  The insurance company replaces all the ";
         this.strings["frm_Travel2_bad_event_12_15_insurance"] = " you had to throw out.";
         this.strings["frm_Travel2_bad_event_13_1a"] = "Your Ship Breaks Down!";
         this.strings["frm_Travel2_bad_event_13_1b"] = "You must pay <font color=\'#F05555\'><b>";
         this.strings["frm_Travel2_bad_event_13_2"] = " kubars</b></font> for a repair-droid to come out and fix your ship.";
         this.strings["frm_Travel2_bad_event_13_2_insurance"] = " kubars</b></font> for a repair-droid to come out and fix your ship.\n\nLuckily you have <font color=\'#77D7FF\'><b>Voyagers\' Insurance!</b></font>  The insurance company reimburses you in full for the cost of the repairs.";
         this.strings["frm_Travel2_bad_event_14"] = "<p align=\'center\'><font size=\'+5\'><b>Fuel Tank Trouble</b></font></p>\nLumbor, your ship\'s trusty engineer, discovers a leak in your main fuel tank.\n\nLumbor manages to quickly stop the leak.  However, by this time, <font color=\'#F05555\'><b>half</b></font> your fuel has already <font color=\'#F05555\'><b>drained away</b></font>.";
         this.strings["frm_Travel2_bad_event_14_insurance"] = "<p align=\'center\'><font size=\'+5\'><b>Fuel Tank Trouble</b></font></p>\nLumbor, your ship\'s trusty engineer, discovers a leak in your main fuel tank.\n\nLumbor manages to quickly stop the leak.  However, by this time, <font color=\'#F05555\'><b>half</b></font> your fuel has already <font color=\'#F05555\'><b>drained away</b></font>.\n\nLuckily you have <font color=\'#77D7FF\'><b>Voyagers\' Insurance!</b></font>  The insurance company sends out a tanker to replace the lost fuel.";
         this.strings["frm_Travel2_bad_event_15_1a"] = "Asteroid Strikes";
         this.strings["frm_Travel2_bad_event_15_1b"] = "An asteroid hits your ship!  You must pay <font color=\'#F05555\'><b>";
         this.strings["frm_Travel2_bad_event_15_2"] = " kubars</b></font> to have it repaired.";
         this.strings["frm_Travel2_bad_event_15_2_insurance"] = " kubars</b></font> to have it repaired.\n\nLuckily you have <font color=\'#77D7FF\'><b>Voyagers\' Insurance!</b></font>  The insurance company reimburses you in full for the cost of the repairs.";
         this.strings["frm_Travel2_bad_event_16a"] = "Cargo Disaster";
         this.strings["frm_Travel2_bad_event_16b"] = "Due to faulty wiring, your cargo hold overheats and <font color=\'#F05555\'><b>all your cargo</b></font> is destroyed.";
         this.strings["frm_Travel2_bad_event_16_insurance"] = "Due to faulty wiring, your cargo hold overheats and <font color=\'#F05555\'><b>all your cargo</b></font> is destroyed.\n\nLuckily you have <font color=\'#77D7FF\'><b>Voyagers\' Insurance!</b></font>  The insurance company replaces the destroyed goods.";
         this.strings["frm_Travel2_bad_event_17_1"] = "<p align=\'center\'><font size=\'+5\'><b>Wrong Destination</b></font></p>\nDue to a <font color=\'#F05555\'><b>navigation error</b></font> on the part of your pilot, you end up on planet ";
         this.strings["frm_Travel2_bad_event_17_2"] = ".";
         this.strings["frm_Travel2_bad_event_17_2_insurance"] = ".  Sorry, but Voyagers\' Insurance does not cover pilot error.";
         this.strings["frm_Travel2_bad_event_18"] = "<p align=\'center\'><font size=\'+5\'><b>Lost Time</b></font></p>\nBecause of a serious miscalculation on the part of your pilot, you get lost and lose several hours of valuable time.";
         this.strings["frm_Travel2_bad_event_19_0"] = "Travel Delayed";
         this.strings["frm_Travel2_bad_event_19_1"] = "Because of the mishap you had, it will take you considerably longer than expected to reach your destination planet.";
         this.strings["frm_Travel2_bad_event_19_2"] = "Because of all the trouble you had, it will take you much, much longer than expected to reach your destination planet.";
         this.strings["frm_Travel2_audit_0"] = "Tax Audit!";
         this.strings["frm_Travel2_audit_1"] = "The Imperial Government audits your company.  You must pay ";
         this.strings["frm_Travel2_audit_2"] = " kubars in back taxes plus a fine of ";
         this.strings["frm_Travel2_audit_3"] = " kubars for not paying your taxes on time.";
         this.strings["frm_Travel2_audit_4"] = "\n\nSorry, but Voyager\'s Insurance does not cover this.  It is your responsibility to pay your taxes.";
         this.strings["frm_Travel2_crew_strike_1"] = "<p align=\'center\'><font size=\'+5\'><b>Union Boss</b></font></p>\nUnwilling to be treated as slave labor, your crew goes on strike!  They demand that you raise their weekly salary or they won\'t come back.\n\nTo settle this strike, you are forced to pay <font color=\'#F05555\'><b>";
         this.strings["frm_Travel2_crew_strike_2"] = " kubars</b></font> in back wages and <font color=\'#F05555\'><b>raise</b></font> your crew\'s weekly salary by <font color=\'#F05555\'><b>500 kubars</b></font> per person.";
         this.strings["frm_Travel2_crew_strike_3"] = "\n\nSorry, but Voyager\'s Insurance does not cover this.  It is your responsibility to pay your crew.";
         this.strings["frm_Travel2_out_of_fuel_0"] = "Out of Fuel";
         this.strings["frm_Travel2_out_of_fuel_1"] = "Your ship has run out of fuel.  You must pay <font color=\'#F05555\'><b>";
         this.strings["frm_Travel2_out_of_fuel_2_with_delay"] = " kubars</b></font> to have a tanker come out and refuel your ship.  To make matters worse, it will take you considerably longer than expected to reach your destination planet.";
         this.strings["frm_Travel2_out_of_fuel_2_no_delay"] = " kubars</b></font> to have a tanker come out and refuel your ship.";
         this.strings["frm_Travel2_out_of_fuel_part_2_0"] = "Travel Delayed";
         this.strings["frm_Travel2_out_of_fuel_part_2_1"] = "To make matters worse, it will take you considerably longer than expected to reach your destination planet.";
         this.strings["frm_Travel2_out_of_fuel_3"] = "\n\nSorry, but Voyager\'s Insurance does not cover this.  It is your responsibility to fill up your fuel tank.";
         this.strings["frm_Travel3_opponent_buys_engine_1_1"] = " travels to Pyke to purchase a new faster ";
         this.strings["frm_Travel3_opponent_buys_engine_1_2"] = "-kuarp engine.";
         this.strings["frm_Travel3_opponent_buys_engine_2"] = " travels to Xeen and hires a mechanic to turbocharge its ship\'s engine.";
         this.strings["frm_Travel3_opponent_buys_ship_1"] = " purchases a new ";
         this.strings["frm_Travel3_opponent_buys_ship_2"] = "-ton ship for ";
         this.strings["frm_Travel3_opponent_buys_ship_3"] = " kubars from the Traders\' Union.";
         this.strings["frm_Travel3_opponent_event_1"] = " moves to expand its market share.";
         this.strings["frm_Travel3_opponent_event_2"] = " suffers as profits fall due to a serious miscalculation in the commodities market.";
