         this.strings["frm_Travel4_event_15_0"] = "Prices Plummet On ";
         this.strings["frm_Travel4_event_15_1"] = "The economy on ";
         this.strings["frm_Travel4_event_15_2"] = " over heats!  Productivity quadruples and prices plummet.  This economic shift has temporarily flooded ";
         this.strings["frm_Travel4_event_15_3"] = " with an oversupply of goods.";
         this.strings["frm_Travel4_event_16_0"] = "Prices Shoots Up On ";
         this.strings["frm_Travel4_event_16_1"] = "Due to political turmoil and hyper-inflation, there is an economic crash on ";
         this.strings["frm_Travel4_event_16_2"] = "!  Production comes to a halt, the supply of goods crashses, and prices shoot up.  Trading ships arriving on ";
         this.strings["frm_Travel4_event_16_3"] = " won\'t find much to buy, but anything they have on hand will sell well.";
         this.strings["frm_Travel5_payFacilities_1"] = "<p align=\'center\'><font size=\'+5\'><b>Pay Facility Fees</b></font></p>\nYou must pay <font color=\'#F05555\'><b>";
         this.strings["frm_Travel5_payFacilities_2"] = " kubars</b></font> in facility fees while visiting ";
         this.strings["frm_Travel5_payFacilities_3"] = ".\n\nThis money goes to the companies who own the facilities.";
         this.strings["frm_Travel5_revenueFacilities_1"] = "<p align=\'center\'><font size=\'+5\'><b>Revenue From Facilities</b></font></p>\nYour facilities on ";
         this.strings["frm_Travel5_revenueFacilities_2"] = " earned <font color=\'#77D7FF\'><b>";
         this.strings["frm_Travel5_revenueFacilities_3"] = " kubars</b></font> while you were away.\n\nThis money is being added to your cash!";
