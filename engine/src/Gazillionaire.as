      internal function computePassengers() : void
      {
         this.g.p[this.g.player].passFlag = false;
         this.g.p[this.g.player].profitPerPassenger = this.g.p[this.g.player].passTicketPrice;
         this.g.p[this.g.player].passT = this.f_rnd(0,this.g.p[this.g.player].passengerCapacity) + this.f_rnd(this.g.p[this.g.player].advertP / 4,this.g.p[this.g.player].advertP);
         if(this.g.p[this.g.player].profitPerPassenger < 100)
         {
            this.g.p[this.g.player].profitPerPassenger = 100;
         }
         if(this.g.p[this.g.player].profitPerPassenger <= 4000)
         {
            this.g.p[this.g.player].passT = Math.floor(this.g.p[this.g.player].passT * 1000 / this.g.p[this.g.player].profitPerPassenger);
         }
         else if(this.g.p[this.g.player].profitPerPassenger <= 5000)
         {
            this.g.p[this.g.player].passT = Math.floor(this.g.p[this.g.player].passT * 1000 / (1.5 * this.g.p[this.g.player].profitPerPassenger));
         }
         else if(this.g.p[this.g.player].profitPerPassenger <= 6000)
         {
            this.g.p[this.g.player].passT = Math.floor(this.g.p[this.g.player].passT * 1000 / (2.25 * this.g.p[this.g.player].profitPerPassenger));
         }
         else if(this.g.p[this.g.player].profitPerPassenger <= 7000)
         {
            this.g.p[this.g.player].passT = Math.floor(this.g.p[this.g.player].passT * 1000 / (3.25 * this.g.p[this.g.player].profitPerPassenger));
         }
         else if(this.g.p[this.g.player].profitPerPassenger <= 8000)
         {
            this.g.p[this.g.player].passT = Math.floor(this.g.p[this.g.player].passT * 1000 / (4.75 * this.g.p[this.g.player].profitPerPassenger));
         }
         else if(this.g.p[this.g.player].profitPerPassenger <= 9000)
         {
            this.g.p[this.g.player].passT = Math.floor(this.g.p[this.g.player].passT * 1000 / (7 * this.g.p[this.g.player].profitPerPassenger));
         }
         else if(this.g.p[this.g.player].profitPerPassenger <= 10000)
         {
            this.g.p[this.g.player].passT = Math.floor(this.g.p[this.g.player].passT * 1000 / (10 * this.g.p[this.g.player].profitPerPassenger));
         }
         else
         {
            this.g.p[this.g.player].passT = 0;
         }
         this.g.p[this.g.player].passengers = this.g.p[this.g.player].passT;
         if(this.g.p[this.g.player].passT > this.g.p[this.g.player].passengerCapacity)
         {
            this.g.p[this.g.player].passengers = this.g.p[this.g.player].passengerCapacity;
         }
      }
      
