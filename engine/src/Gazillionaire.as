            {
               this.userShipNumber = -1;
            }
            this.mainCanvas.selectedChild = this.frm_Level;
         }
         else if(this.g.game == 0)
         {
            this.frame_globals[0] = 1;
            this.showYesNoNew(this.currentStrings.getString("abandon_game_new_game"),280);
         }
         else
         {
            this.server_retries = 0;
            if(this.buildLevel == 2)
            {
               this.frame_globals[0] = this.g;
               this.autosave();
               this.mainCanvas.selectedChild = this.frm_Level;
            }
            else if(this.buildLevel == 0)
            {
               this.g = null;
               this.mainCanvas.selectedChild = this.frm_Level;
            }
            else
            {
               this.frm_File_online_autosave_then_new();
            }
         }
      }
      
