      internal function frm_Passengers_pick_up() : void
      {
         if(this.g.p[this.g.player].passFlag == false)
         {
            if(this.g.p[this.g.player].passengers > 0)
            {
               this.playSoundNoLoop("MP3/PICKUP.MP3");
            }
            this.g.p[this.g.player].passFlag = true;
            this.g.p[this.g.player].cash += this.g.p[this.g.player].profitPerPassenger * this.g.p[this.g.player].passengers;
            if(this.g.tutor == false || this.g.activateTurn >= this.g.activateTax)
            {
               this.g.p[this.g.player].tax += Math.floor(this.g.p[this.g.player].profitPerPassenger * this.g.p[this.g.player].passengers * this.g.passTax / 100);
            }
            this.frm_Passengers_show_text();
         }
         else
         {
            this.showHelpNew(this.currentStrings.getString("frm_Passengers_already_picked_up"),"","","","",200);
         }
      }
      
