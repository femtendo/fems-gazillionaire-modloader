      internal function frm_MainMenu_fuel() : void
      {
         var _loc1_:Number = NaN;
         if(this.g.p[this.g.player].quickFuel == false)
         {
            this.mainCanvas.selectedChild = this.frm_Fuel;
         }
         else
         {
            _loc1_ = this.g.p[this.g.player].fuelCapacity - this.g.p[this.g.player].fuel;
            if(_loc1_ == 0)
            {
               this.showHelpNew(this.currentStrings.getString("frm_MainMenu_full_fuel"),"","","","",180);
            }
            else if(_loc1_ * this.g.fuelCost[this.g.p[this.g.player].planet] > this.g.p[this.g.player].cash)
            {
               this.showHelpNew(this.currentStrings.getString("frm_MainMenu_not_enough_money_fuel"),"","","","",200);
            }
            else
            {
               this.playSoundNoLoop("MP3/FUEL.MP3");
               this.g.p[this.g.player].fuel += _loc1_;
               this.g.p[this.g.player].cash -= _loc1_ * this.g.fuelCost[this.g.p[this.g.player].planet];
               this.frm_MainMenu_load();
            }
         }
      }
      
