      internal function frm_File_check_online_saves() : void
      {
         var loader:URLLoader = null;
         var request:URLRequest = null;
         var variables:URLVariables = null;
         variables = new URLVariables();
         variables.language = this.currentStrings.getLanguage();
         variables.command = "listsaves";
         variables.name = this.username;
         variables.pass = this.password;
         variables.solo = 0;
         variables.page = 0;
         request = new URLRequest("/gazXML.php");
         request.data = variables;
         request.method = URLRequestMethod.POST;
         loader = new URLLoader();
         loader.addEventListener(IOErrorEvent.IO_ERROR,this.frm_File_repeat_check_online_saves);
         loader.addEventListener(Event.COMPLETE,this.frm_File_process_check_online_saves);
         try
         {
            this.urlLoader = loader;
            this.urlLoader.load(request);
         }
         catch(error:SecurityError)
         {
            frm_File_repeat_check_online_saves();
         }
      }
      
      internal function frm_File_repeat_check_online_saves(param1:Event = null) : void
      {
         if(this.server_retries < 5)
         {
            ++this.server_retries;
            this.frm_File_check_online_saves();
         }
         else
         {
            this.show_generic_communication_failed();
         }
      }
      
      internal function frm_File_process_check_online_saves(param1:Event) : void
      {
         var externalXML:XML = null;
         var event:Event = param1;
         try
         {
            externalXML = new XML(this.urlLoader.data);
            if(externalXML.elements("result").attribute("success")[0] == 1)
            {
               if(externalXML.elements("result").attribute("count")[0] > 0)
               {
               }
               this.server_retries = 0;
               this.frm_File_check_online_solo_saves();
            }
            else
            {
               this.showHelpNew(externalXML.elements("result").children()[0].toString(),"","","","",260);
            }
         }
         catch(e:TypeError)
         {
            frm_File_repeat_check_online_saves();
         }
      }
      
