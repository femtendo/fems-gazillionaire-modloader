      internal function frm_MainMenu_insure() : void
      {
         if(this.g.p[this.g.player].quickInsurance == false)
         {
            this.mainCanvas.selectedChild = this.frm_Insurance;
         }
         else if(this.g.p[this.g.player].insurance == true)
         {
            this.showHelpNew(this.currentStrings.getString("frm_MainMenu_have_insurance"),"","","","",200);
