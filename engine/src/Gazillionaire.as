      internal function frm_MainMenu_bank() : void
      {
         if(this.g.p[this.g.player].quickBank == false)
         {
            this.mainCanvas.selectedChild = this.frm_Bank;
         }
         else if(this.g.p[this.g.player].cash >= this.g.p[this.g.player].savings)
         {
            if(this.g.p[this.g.player].cash != 0)
            {
               this.playSoundNoLoop("MP3/BANK.MP3");
               this.g.p[this.g.player].savings += this.g.p[this.g.player].cash;
               this.g.p[this.g.player].cash = 0;
               this.frm_MainMenu_load();
            }
         }
         else if(this.g.p[this.g.player].savings != 0)
         {
            this.playSoundNoLoop("MP3/BANK2.MP3");
            this.g.p[this.g.player].cash += this.g.p[this.g.player].savings;
            this.g.p[this.g.player].savings = 0;
            this.frm_MainMenu_load();
         }
      }
      
      internal function frm_MainMenu_loan() : void
      {
         if(this.g.p[this.g.player].quickLoan == false)
         {
            this.mainCanvas.selectedChild = this.frm_Loan;
         }
         else if(this.g.p[this.g.player].cash > 0 && this.g.p[this.g.player].loan > 0)
         {
            this.playSoundNoLoop("MP3/LOAN.MP3");
            if(this.g.p[this.g.player].cash >= this.g.p[this.g.player].loan)
            {
               this.g.p[this.g.player].cash -= this.g.p[this.g.player].loan;
               this.g.p[this.g.player].loan = 0;
            }
            else if(this.g.p[this.g.player].loan > this.g.p[this.g.player].cash)
            {
               this.g.p[this.g.player].loan -= this.g.p[this.g.player].cash;
               this.g.p[this.g.player].cash = 0;
            }
            this.frm_MainMenu_load();
         }
         else if(this.g.p[this.g.player].loan >= this.g.p[this.g.player].loanMax)
         {
            this.showHelpNew(this.currentStrings.getString("frm_MainMenu_loan_max"),"","","","",180);
         }
         else
         {
            this.playSoundNoLoop("MP3/LOAN.MP3");
            this.g.p[this.g.player].cash = this.g.p[this.g.player].cash + this.g.p[this.g.player].loanMax - this.g.p[this.g.player].loan;
            this.g.p[this.g.player].loan = this.g.p[this.g.player].loanMax;
            this.frm_MainMenu_load();
         }
      }
      
