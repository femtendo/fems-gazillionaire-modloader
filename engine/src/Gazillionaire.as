      internal function frm_MainMenu_tax() : void
      {
         if(this.g.p[this.g.player].quickTax == false)
         {
            this.mainCanvas.selectedChild = this.frm_Tax;
         }
         else if(this.g.p[this.g.player].tax + this.g.p[this.g.player].tariff == 0)
