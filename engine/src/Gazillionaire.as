      internal function frm_Travel5_load() : void
      {
         this.frm_Travel5_txt_ok.htmlText = this.currentStrings.getString("ok");
         this.frame_globals = new Array(2);
         this.frame_globals[0] = 0;
         this.frame_globals[1] = 0;
         this.frm_Travel5_ok();
      }
      
      internal function frm_Travel5_ok() : void
      {
         var _loc1_:int = 0;
         var _loc2_:int = 0;
         ++this.frame_globals[0];
         if(this.frame_globals[0] == 1)
         {
            if((this.g.tutor == false || this.g.activateTurn >= this.g.activateTax) && this.g.p[this.g.player].tax + this.g.p[this.g.player].tariff != 0)
            {
               _loc1_ = 0;
               while(_loc1_ <= 2)
               {
                  _loc2_ = 0;
                  while(_loc2_ <= 5)
                  {
                     this.g.p[this.g.player].tariff += Math.floor(this.g.p[this.g.player].comS[_loc1_][_loc2_] * this.g.comP[this.g.p[this.g.player].planet][_loc1_][_loc2_] * this.g.importTariff / 100);
                     _loc2_++;
                  }
                  _loc1_++;
               }
            }
            if(this.frm_Travel5_payFacilities() == false)
            {
               this.frame_globals[0] = 2;
            }
            else
            {
               this.frm_Travel5_button_ok.visible = true;
               this.frm_Travel5_txt_ok.visible = true;
            }
         }
         if(this.frame_globals[0] == 2)
         {
            if(this.frm_Travel5_revenueFacilities() == false)
            {
               this.frame_globals[0] = 3;
            }
            else
            {
               this.frm_Travel5_button_ok.visible = true;
               this.frm_Travel5_txt_ok.visible = true;
            }
         }
         if(this.frame_globals[0] == 3)
         {
            this.g.p[this.g.player].supplyPlanet = -1;
            this.mainCanvas.selectedChild = this.frm_Travel6;
            this.frm_Travel5_image.source = "SWF/WHITE_V.SWF";
            this.frm_Travel5_text.htmlText = "";
            this.frm_Travel5_button_ok.visible = false;
            this.frm_Travel5_txt_ok.visible = false;
         }
      }
      
      internal function frm_Travel5_payFacilities() : Boolean
      {
         var _loc1_:Number = NaN;
         var _loc2_:int = 0;
         if(this.g.tutor == false || this.g.activateTurn >= this.g.activateFacility)
         {
            _loc1_ = 0;
            _loc2_ = 1;
            while(_loc2_ <= this.g.opNumberOf)
            {
               _loc1_ += this.g.o[_loc2_].facilityFee[this.g.p[this.g.player].planet];
               this.g.o[_loc2_].facilityRevenue[this.g.p[this.g.player].planet] += this.g.o[_loc2_].facilityFee[this.g.p[this.g.player].planet];
               _loc2_++;
            }
            _loc2_ = 0;
            while(_loc2_ < this.g.playerNumberOf)
            {
               if(_loc2_ != this.g.player)
               {
                  _loc1_ += this.g.p[_loc2_].facilityFee[this.g.p[this.g.player].planet];
                  this.g.p[_loc2_].facilityRevenue[this.g.p[this.g.player].planet] += this.g.p[_loc2_].facilityFee[this.g.p[this.g.player].planet];
               }
               _loc2_++;
            }
            if(_loc1_ > 0)
            {
               this.frm_Travel5_image.source = "SWF/LOAN_N.SWF";
               this.playSoundNoLoop("MP3/LOAN.MP3");
               if(_loc1_ > this.g.p[this.g.player].cash + this.g.p[this.g.player].savings)
               {
                  this.frm_Travel5_text.htmlText = this.currentStrings.getString("frm_Travel5_payFacilities_1") + this.commaFormat(_loc1_) + this.currentStrings.getString("frm_Travel5_payFacilities_2") + this.currentStrings.getString("planet_" + this.g.planetIndex[this.g.p[this.g.player].planet]) + this.currentStrings.getString("frm_Travel5_payFacilities_3") + this.currentStrings.getString("loan_text");
               }
