      internal function repeat_autosave(param1:Event = null) : void
      {
         if(this.server_retries < 5)
         {
            ++this.server_retries;
            this.autosave();
         }
         else
         {
            this.show_generic_communication_failed();
         }
      }
      
      internal function process_autosave(param1:Event) : void
      {
         var externalXML:XML = null;
         var event:Event = param1;
         try
         {
            externalXML = new XML(this.urlLoader.data);
            if(externalXML.elements("result").attribute("success")[0] == 1)
            {
               if(!(this.mainCanvas.selectedChild == this.frm_NewOrContinue || this.is_free_game == true && this.g != null && this.g.turn > 20))
               {
                  if(externalXML.elements("result").attribute("is_current_turn")[0] == 2)
                  {
                     this.frame_globals = new Array(1);
                     this.frame_globals[0] = -1 * this.g.game;
                     this.server_retries = 0;
                     this.load_online_game();
                  }
                  else if(externalXML.elements("result").attribute("is_current_turn")[0] == 1 || this.userShipNumber <= 0)
                  {
