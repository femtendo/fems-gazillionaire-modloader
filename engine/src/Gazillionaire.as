                  this.playSoundNoLoop("MP3/PICKUP.MP3");
               }
               this.g.p[this.g.player].passFlag = true;
               this.g.p[this.g.player].cash += this.g.p[this.g.player].profitPerPassenger * this.g.p[this.g.player].passengers;
               if(this.g.tutor == false || this.g.activateTurn >= this.g.activateTax)
               {
                  this.g.p[this.g.player].tax += Math.floor(this.g.p[this.g.player].profitPerPassenger * this.g.p[this.g.player].passengers * this.g.passTax / 100);
               }
               this.frm_MainMenu_load();
            }
            else
            {
               this.showHelpNew(this.currentStrings.getString("frm_MainMenu_have_passengers"),"","","","",200);
            }
         }
         else
         {
            this.showHelpNew(this.currentStrings.getString("frm_MainMenu_no_passengers"),"","","","",200);
         }
      }
      
      internal function frm_MainMenu_ad() : void
      {
         if(this.g.p[this.g.player].quickAdvertising == false)
         {
            this.mainCanvas.selectedChild = this.frm_Advertising;
         }
         else if(this.g.p[this.g.player].cash + this.g.p[this.g.player].advertInvestedC + this.g.p[this.g.player].advertInvestedP == 0)
         {
            this.showHelpNew(this.currentStrings.getString("frm_MainMenu_no_money_ad_1"),"","","","",200);
         }
         else if(this.g.p[this.g.player].advertFixP + this.g.p[this.g.player].advertFixC > this.g.p[this.g.player].cash + this.g.p[this.g.player].advertInvestedC + this.g.p[this.g.player].advertInvestedP)
         {
            this.showHelpNew(this.currentStrings.getString("frm_MainMenu_no_money_ad_2"),"","","","",200);
         }
         else if(this.g.p[this.g.player].advertFixP == 0 && this.g.p[this.g.player].advertFixC == 0)
         {
            this.showHelpNew(this.currentStrings.getString("frm_MainMenu_ad_not_set"),"","","","",200);
            this.mainCanvas.selectedChild = this.frm_Advertising;
         }
         else
         {
            if(this.g.p[this.g.player].advertFixP != 0 || this.g.p[this.g.player].advertFixC != 0)
            {
               this.playSoundNoLoop("MP3/ADVERT.MP3");
            }
            this.g.p[this.g.player].cash = this.g.p[this.g.player].cash + this.g.p[this.g.player].advertInvestedC + this.g.p[this.g.player].advertInvestedP;
            this.g.p[this.g.player].advertInvestedP = this.g.p[this.g.player].advertFixP;
            this.g.p[this.g.player].advertP = Math.floor(this.g.p[this.g.player].advertInvestedP / 125);
            this.g.p[this.g.player].advertInvestedC = this.g.p[this.g.player].advertFixC;
            this.g.p[this.g.player].cash -= this.g.p[this.g.player].advertInvestedC + this.g.p[this.g.player].advertInvestedP;
            this.frm_MainMenu_load();
         }
      }
      
      internal function frm_MainMenu_crew() : void
      {
