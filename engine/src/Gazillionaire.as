      internal function frm_Travel4_ok() : void
      {
         ++this.frame_globals[0];
         if(this.frame_globals[0] == 1)
         {
            if(this.g.p[this.g.player].sabotageDamage != 0)
            {
               this.frm_Travel4_showSabotageResult();
            }
            else
            {
               this.frame_globals[0] = 2;
            }
         }
         if(this.frame_globals[0] == 2)
         {
            if((this.g.auctionLast == 1 || this.g.auctionLast == 3) && this.g.auctionHighBidLast > 0)
            {
               this.frm_Travel4_AuctionShip();
            }
            else if((this.g.auctionLast == 2 || this.g.auctionLast == 4) && this.g.auctionHighBidLast > 0)
            {
               this.frm_Travel4_AuctionFacility();
            }
            else
            {
               this.frame_globals[0] = 3;
            }
         }
         if(this.frame_globals[0] == 3)
         {
            while(this.frame_globals[1] < this.g.playerNumberOf && this.frame_globals[0] == 3)
            {
               if(this.g.p[this.frame_globals[1]].turnTaken == true && this.frame_globals[1] != this.g.player && this.g.p[this.frame_globals[1]].planetLast == this.g.p[this.g.player].planet)
               {
                  this.frm_Travel4_humanArrivesOnPlanet();
                  this.frame_globals[0] = 2;
               }
               ++this.frame_globals[1];
            }
            if(this.frame_globals[1] == this.g.playerNumberOf)
            {
               this.frame_globals[1] = 1;
               ++this.frame_globals[0];
            }
         }
         if(this.frame_globals[0] == 4)
         {
            while(this.frame_globals[1] <= this.g.opNumberOf && this.frame_globals[0] == 4)
            {
               if(this.g.o[this.frame_globals[1]].turnTaken == true && this.g.o[this.frame_globals[1]].planet == this.g.p[this.g.player].planet)
               {
                  this.frm_Travel4_opponentArrivesOnPlanet();
                  this.frame_globals[0] = 3;
               }
               ++this.frame_globals[1];
            }
            if(this.frame_globals[1] > this.g.opNumberOf)
            {
               ++this.frame_globals[0];
            }
         }
         if(this.frame_globals[0] == 5)
         {
            if(this.g.turn > 4)
            {
               if(this.frm_Travel4_gameEvents() != true)
               {
                  ++this.frame_globals[0];
               }
            }
            else
            {
               ++this.frame_globals[0];
            }
         }
         if(this.frame_globals[0] == 6)
         {
            this.mainCanvas.selectedChild = this.frm_Travel5;
            this.frm_Travel4_image.source = "SWF/WHITE_H.SWF";
            this.frm_Travel4_text.htmlText = "";
         }
      }
      
