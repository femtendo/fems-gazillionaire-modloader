#!/usr/bin/env bash
# Pre-push checks: keeps commit history free of disallowed tooling strings
# and blocks pushes that would introduce secrets.
#
# Enable once per clone with:
#   git config core.hooksPath .githooks
set -euo pipefail

ZERO="0000000000000000000000000000000000000000"

# Strings that must never appear in a commit message or a diff line.
DISALLOWED_TERMS=(
    "claude"
    "anthropic"
    "openai"
    "chatgpt"
    "copilot"
    "co-authored-by"
    "generated with"
    "generated by"
    "assisted by"
    "language model"
    "gpt-3"
    "gpt-4"
    "gpt-5"
)
PATTERN="$(IFS='|'; echo "${DISALLOWED_TERMS[*]}")"

fail=0

check_range() {
    local range="$1"

    local hits
    hits="$(git log "$range" --format='%H %s%n%b' 2>/dev/null | grep -iE "$PATTERN" || true)"
    if [ -n "$hits" ]; then
        echo "pre-push: a commit message in $range matches a disallowed term:" >&2
        echo "$hits" >&2
        fail=1
    fi

    # Excludes this hook's own directory: its rule list necessarily contains
    # the terms it's checking for.
    if git log "$range" -p -- . ':!.githooks' 2>/dev/null | grep -E '^\+' | grep -qiE "$PATTERN"; then
        echo "pre-push: a diff in $range adds a line matching a disallowed term" >&2
        fail=1
    fi
}

scan_secrets() {
    local range="$1"
    if ! command -v gitleaks >/dev/null 2>&1; then
        echo "pre-push: gitleaks not found (brew install gitleaks) — cannot verify $range is secret-free" >&2
        fail=1
        return
    fi
    if ! gitleaks detect --source . --log-opts="$range" --no-banner --log-level error; then
        echo "pre-push: gitleaks flagged a potential secret in $range" >&2
        fail=1
    fi
}

while read -r local_ref local_oid remote_ref remote_oid; do
    [ "$local_oid" = "$ZERO" ] && continue

    if [ "$remote_oid" = "$ZERO" ]; then
        range="$local_oid"
    else
        range="$remote_oid..$local_oid"
    fi

    check_range "$range"
    scan_secrets "$range"
done

exit "$fail"
